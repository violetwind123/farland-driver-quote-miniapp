<view class="page">
  <view wx:if="{{loading}}" class="state-card">加载中...</view>
  <view wx:elif="{{invalid}}" class="state-card invalid">
    <view class="state-title">报价链接无效</view>
    <view class="state-desc">{{errorMessage}}</view>
  </view>
  <view wx:elif="{{submitSuccess}}" class="state-card success">
    <view class="state-title">报价提交成功</view>
    <view class="state-desc">报价已提交，Farland 运营会再与您确认。</view>
  </view>
  <view wx:elif="{{cancelled}}" class="state-card invalid">
    <view class="state-title">本报价单已取消</view>
    <view class="state-desc">原因：{{cancelReasonDriver}}</view>
    <view class="state-desc">如有疑问，请联系 Farland 运营。</view>
  </view>
  <view wx:else>
    <view class="title">{{pageTitle}}</view>

    <view class="card">
      <view class="card-title">任务信息</view>
      <view class="field"><text>订单编号</text><text>{{request.request_no}}</text></view>
      <view class="field"><text>服务类型</text><text>{{request.service_type === 'transfer' ? '接送 / 转场' : '包车 / 多日用车'}}</text></view>
      <view class="field"><text>服务日期</text><text>{{request.service_date}}</text></view>
      <view class="field"><text>司机区域</text><text>{{request.driver_region}}</text></view>
      <view class="field"><text>报价截止</text><text>{{request.quote_deadline}}</text></view>
      <view class="task-description">{{request.task_description}}</view>
    </view>

    <view wx:if="{{driverStatus !== 'unregistered'}}" class="card">
      <view class="card-title">司机信息</view>
      <view class="field"><text>司机姓名</text><text>{{driver.name}}</text></view>
      <view class="field"><text>司机电话</text><text>{{driver.phone}}</text></view>
      <view class="field"><text>服务区域</text><text>{{driver.service_region || '-'}}</text></view>
    </view>

    <view wx:if="{{isRegistered}}" class="card">
      <view class="card-title">司机与车辆信息</view>
      <view class="field"><text>车辆类型</text><text>{{vehicle.vehicle_type}}</text></view>
      <view class="field"><text>车辆型号</text><text>{{vehicle.vehicle_model}}</text></view>
      <view class="field"><text>座位数</text><text>{{vehicle.seats}}</text></view>
      <view class="field"><text>行李容量</text><text>{{vehicle.luggage_capacity}}</text></view>
      <view class="field"><text>车牌号</text><text>{{vehicle.plate_number || '-'}}</text></view>
      <view class="hint">请确认以上司机和车辆信息无误，如需修改请联系 Farland 运营。</view>
    </view>

    <view wx:if="{{driverStatus === 'unregistered' && !quoteLocked}}" class="card">
      <view class="card-title">司机信息</view>
      <view class="input-row"><text>司机姓名</text><input value="{{formDriverName}}" data-field="formDriverName" bindinput="onInputChange" /></view>
      <view class="input-row"><text>司机电话</text><input value="{{formDriverPhone}}" data-field="formDriverPhone" bindinput="onInputChange" /></view>
    </view>

    <view wx:if="{{driverStatus !== 'registered_with_vehicle' && !quoteLocked}}" class="card">
      <view class="card-title">车辆信息</view>
      <view class="input-row">
        <text>车辆类型</text>
        <picker range="{{vehicleTypeOptions}}" value="{{vehicleTypeIndex}}" bindchange="onVehicleTypeChange">
          <view class="picker-value">{{formVehicleType}}</view>
        </picker>
      </view>
      <view class="input-row"><text>车辆型号</text><input value="{{formVehicleModel}}" data-field="formVehicleModel" bindinput="onInputChange" /></view>
      <view class="input-row"><text>座位数</text><input type="number" value="{{formSeats}}" data-field="formSeats" bindinput="onInputChange" /></view>
      <view class="input-row"><text>行李容量</text><input type="number" value="{{formLuggageCapacity}}" data-field="formLuggageCapacity" bindinput="onInputChange" /></view>
      <view class="input-row"><text>车牌号（选填）</text><input value="{{formPlateNumber}}" data-field="formPlateNumber" bindinput="onInputChange" /></view>
    </view>

    <view class="card">
      <view class="card-title">报价信息</view>
      <view wx:if="{{quoteResultText}}" class="quote-result {{quoteResultType}}">
        {{quoteResultText}}
      </view>
      <view wx:if="{{hasExistingQuote}}" class="quote-notice">
        {{quoteFinalized ? '您的报价记录如下。' : '您已提交过报价，不能重复提交或修改。如需调整请联系 Farland 运营。'}}
        <text wx:if="{{existingQuoteUpdatedAt}}">上次更新：{{existingQuoteUpdatedAt}}</text>
      </view>
      <view class="input-row"><text>报价金额</text><input type="digit" value="{{quotePrice}}" data-field="quotePrice" bindinput="onInputChange" disabled="{{quoteLocked}}" /></view>
      <view class="input-row">
        <text>币种</text>
        <picker range="{{currencyOptions}}" value="{{currencyIndex}}" bindchange="onCurrencyChange" disabled="{{quoteLocked}}">
          <view class="picker-value">{{currency}}</view>
        </picker>
      </view>
      <view class="input-row textarea-row">
        <text>报价备注</text>
        <textarea value="{{quoteNote}}" data-field="quoteNote" bindinput="onInputChange" disabled="{{quoteLocked}}" placeholder="请说明是否包含停车费、过路费、基础等待时间、超时费、临时加点/绕路收费规则。" />
      </view>
    </view>

    <button wx:if="{{!quoteLocked}}" class="submit-btn" loading="{{submitting}}" bindtap="onSubmit">{{submitting ? '提交中...' : '提交报价'}}</button>
  </view>
</view>
