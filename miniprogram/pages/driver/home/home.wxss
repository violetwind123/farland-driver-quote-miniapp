.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #F5F6FA; }
.panel { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 18rpx; }
.title { font-size: 32rpx; font-weight: 600; color: #1f3266; margin-bottom: 16rpx; }
.desc, .empty { color: #6E7788; font-size: 25rpx; line-height: 1.6; }
.error .title { color: #6672A8; }
.field { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 12rpx; font-size: 26rpx; color: #253554; }
.field text:first-child { color: #6E7788; flex: 0 0 150rpx; }
.field text:last-child { flex: 1; text-align: right; word-break: break-word; }
.wecom-hint { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; background: #f7f9ff; color: #465c86; font-size: 24rpx; line-height: 1.6; }
.wecom-box { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #edf1f7; }
.wecom-missing { margin-top: 16rpx; color: #6E7788; font-size: 24rpx; line-height: 1.6; }
.lock-tip { margin-bottom: 18rpx; padding: 16rpx; border-radius: 12rpx; background: #f2f3fa; color: #6672A8; font-size: 24rpx; line-height: 1.6; }
.input-row { margin-bottom: 18rpx; }
.input-row text { display: block; color: #465c86; font-size: 24rpx; margin-bottom: 10rpx; }
input, .picker-value { background: #f7f9ff; border: 1rpx solid #d8e1f5; border-radius: 12rpx; padding: 18rpx; font-size: 28rpx; color: #1E2635; }
.primary-btn { margin-top: 12rpx; background: #6672A8; color: #fff; border-radius: 44rpx; font-size: 30rpx; }
.order-item { padding: 18rpx 0; border-top: 1rpx solid #edf1f7; }
.order-item:first-of-type { border-top: 0; }
.order-head { display: flex; justify-content: space-between; gap: 16rpx; font-size: 28rpx; font-weight: 600; color: #253554; }
.status { color: #6672A8; }
.price { margin-top: 10rpx; font-size: 30rpx; font-weight: 600; color: #1f3266; }
.note { margin-top: 8rpx; color: #253554; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
