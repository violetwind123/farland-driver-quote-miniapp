<view class="success-page">
  <view class="success-hero">
    <view class="success-badge"><view class="success-check">✓</view></view>
    <view class="success-title">预订意向已提交</view>
    <view class="success-copy">您的服务群顾问正在与酒店确认房态与价格，通常 30 分钟内在群内回复您。</view>
  </view>

  <view class="info-card">
    <view class="info-row">
      <view class="info-label">酒店</view>
      <view class="info-value">{{hotel.displayName}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">房型</view>
      <view class="info-value">{{room.roomSummary || room.displayName}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">日期</view>
      <view class="info-value">{{stayText}} · {{searchMeta}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">参考总价</view>
      <view class="info-value"><text class="price-serif-inline">{{payableText}}</text><text class="price-note caption">含税费 · 以顾问确认为准</text></view>
    </view>
    <view class="info-row">
      <view class="info-label">意向单号</view>
      <view class="info-value serif-gold">{{order.order_no || '待生成'}}</view>
      <view class="copy-chip gold" bindtap="copyOrderNo">复制</view>
    </view>
  </view>

  <view class="progress-card">
    <view class="prog-step">
      <view class="prog-dot done"></view>
      <view class="prog-name active">已提交</view>
      <view class="prog-time">{{submittedTime}}</view>
    </view>
    <view class="prog-line"></view>
    <view class="prog-step">
      <view class="prog-dot current"></view>
      <view class="prog-name current-txt">顾问确认中</view>
      <view class="prog-time">约 30 分钟</view>
    </view>
    <view class="prog-line"></view>
    <view class="prog-step">
      <view class="prog-dot future"></view>
      <view class="prog-name muted">完成预订</view>
      <view class="prog-time faint">群内同步确认单</view>
    </view>
  </view>

  <view class="pay-warning card-ivory">小程序内不发起任何支付。费用确认后由您的 Farland 服务群顾问收取，请勿通过其他渠道转账。</view>

  <view class="action-bar">
    <button class="cta-ghost" bindtap="continueBrowsing">继续浏览酒店</button>
    <button class="cta-primary" bindtap="backToTrips">返回我的行程</button>
  </view>
</view>
