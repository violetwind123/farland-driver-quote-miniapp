.success-page {
  min-height: 100vh;
  padding: 34rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: #F4F5F9;
}

.success-hero,
.info-card,
.hotel-card {
  margin-bottom: 18rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEEDF4;
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 8rpx 22rpx rgba(17, 24, 39, 0.035);
  box-sizing: border-box;
}

.hotel-card {
  padding: 0;
  overflow: hidden;
}

.hotel-photo {
  display: block;
  width: 100%;
  height: 260rpx;
  background: #EEF0F9;
}

.hotel-info {
  padding: 28rpx 30rpx 30rpx;
}

.status-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #E7F2E8;
  color: #4E8F58;
  font-size: 48rpx;
  line-height: 76rpx;
  text-align: center;
  font-weight: 800;
}

.success-title {
  margin-top: 20rpx;
  color: #1C1B29;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 780;
}

.success-copy,
.muted-line,
.step-line {
  color: #6E6D82;
  font-size: 24rpx;
  line-height: 1.55;
}

.success-copy {
  margin-top: 12rpx;
}

.section-title {
  color: #1C1B29;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 750;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.08);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label,
.info-value {
  color: #6E6D82;
  font-size: 24rpx;
  line-height: 1.35;
}

.info-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-weight: 700;
  word-break: break-word;
}

.info-value.strong {
  color: #353F8E;
  font-size: 28rpx;
}

.hotel-name {
  margin-top: 14rpx;
  color: #1C1B29;
  font-family: "Cormorant Garamond", Georgia, "Songti SC", serif;
  font-size: 38rpx;
  line-height: 1.16;
  font-weight: 760;
}

.hotel-name-en {
  margin-top: 8rpx;
  color: #8B8A9C;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 520;
}

.hotel-badges,
.transport-row,
.room-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.hotel-badge,
.transport-pill,
.room-tag {
  max-width: 100%;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #EEF0F9;
  color: #4A56A5;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 700;
  box-sizing: border-box;
}

.hotel-badge {
  background: #FBF1E1;
  color: #A6772A;
}

.transport-pill.traffic {
  background: #E7F2E8;
  color: #4E8F58;
}

.transport-pill.traffic.moderate,
.transport-pill.traffic.high {
  background: #FBF1E1;
  color: #A6772A;
}

.traffic-note {
  margin-top: 10rpx;
  color: #6E6D82;
  font-size: 22rpx;
  line-height: 1.45;
}

.muted-line,
.stay-line,
.room-line,
.step-line {
  margin-top: 10rpx;
}

.stay-line {
  color: #6E6D82;
  font-size: 23rpx;
  line-height: 1.45;
}

.room-line {
  color: #4A56A5;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 700;
}

.cancel-line {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0EFF5;
}

.cancel-badge {
  align-self: flex-start;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #FBF1E1;
  color: #A6772A;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 700;
}

.cancel-copy {
  color: #8B8A9C;
  font-size: 22rpx;
  line-height: 1.45;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid #EEEDF4;
  box-sizing: border-box;
}

.secondary-btn,
.primary-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.secondary-btn {
  background: #EEF0F9;
  color: #4A56A5;
}

.primary-btn {
  background: linear-gradient(135deg, #6874B4 0%, #8993CC 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(104, 116, 180, 0.34);
}

.secondary-btn::after,
.primary-btn::after {
  border: none;
}
