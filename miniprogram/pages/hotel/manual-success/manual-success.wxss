@import "../../../styles/theme.wxss";
page { font-size: 28rpx; }

.success-page {
  min-height: 100vh;
  padding: 34rpx 24rpx 200rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--bg-ivory) 0%, var(--bg-page) 42%);
}

.success-hero {
  margin-bottom: 18rpx;
  padding-top: 120rpx;
  text-align: center;
}

.info-card {
  margin-bottom: 18rpx;
  padding: 8rpx 30rpx;
  border-radius: 32rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.success-badge {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #B9975F 0%, var(--gold-500) 100%);
  box-shadow: 0 14rpx 32rpx rgba(166, 136, 91, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 0 auto;
}

.success-badge::after {
  content: '';
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.success-check {
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.success-title {
  margin-top: 32rpx;
  font-family: var(--font-serif);
  color: var(--ink-900);
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 600;
}

.success-copy {
  margin: 16rpx auto 0;
  max-width: 560rpx;
  color: var(--ink-600);
  font-size: 24rpx;
  line-height: 1.7;
}

.serif-gold {
  font-family: var(--font-serif);
  color: var(--gold-700);
  font-weight: 700;
  letter-spacing: 3rpx;
}

.price-serif-inline {
  font-family: var(--font-serif);
  color: var(--ink-900);
  font-size: 30rpx;
  font-weight: 700;
}

.price-note {
  margin-left: 12rpx;
  font-weight: 400;
}

.progress-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx 36rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.prog-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.prog-line {
  flex: 1;
  height: 1rpx;
  background: rgba(27, 35, 64, 0.10);
  margin-bottom: 52rpx;
}

.prog-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.prog-dot.done { background: var(--success); }

.prog-dot.current {
  background: var(--brand-500);
  box-shadow: 0 0 0 8rpx rgba(102, 114, 168, 0.15);
}

.prog-dot.future {
  border: 3rpx solid #C4C8D4;
  background: #FFFFFF;
}

.prog-name {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.prog-name.current-txt {
  color: var(--brand-600);
  font-weight: 700;
}

.prog-name.muted {
  color: var(--ink-400);
  font-weight: 500;
}

.prog-time {
  font-size: 17rpx;
  color: var(--ink-400);
}

.prog-time.faint { color: var(--ink-300); }

.pay-warning {
  margin-bottom: 18rpx;
  padding: 24rpx 32rpx;
  color: var(--gold-700);
  font-size: 21rpx;
  line-height: 1.7;
}
