@import "/styles/theme.wxss";

page { font-size: 28rpx; }

.hotel-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 170rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  background: #F4F5F9;
}

.text-logo {
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-brand {
  position: absolute;
  left: 36rpx;
  top: 30rpx;
  z-index: 9;
  width: 190rpx;
  height: 74rpx;
  pointer-events: none;
}

.brand-logo {
  display: block;
  width: 190rpx;
  height: 74rpx;
  opacity: 0.76;
  filter: drop-shadow(0 8rpx 14rpx rgba(0, 0, 0, 0.12));
}

.hero-swiper {
  width: 100%;
  height: 460rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 460rpx;
  padding: 48rpx 44rpx 130rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  box-sizing: border-box;
}

.hero-swiper,
.hero-slide,
.hero-image {
  max-width: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, rgba(28, 27, 41, 0.16) 0%, rgba(28, 27, 41, 0.08) 34%, rgba(28, 27, 41, 0.64) 100%),
    linear-gradient(90deg, rgba(28, 27, 41, 0.30) 0%, rgba(28, 27, 41, 0.08) 58%, rgba(28, 27, 41, 0.20) 100%);
}

.hero-copy {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 136rpx;
  z-index: 2;
  text-align: center;
}

.hero-title {
  color: #FFFFFF;
  font-size: 38rpx;
  line-height: 1.24;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.22);
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 500;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.16);
}

.search-card {
  position: relative;
  z-index: 5;
  margin: -74rpx 24rpx 24rpx;
  padding: 18rpx 28rpx 30rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(238, 237, 244, 0.95);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 18rpx 42rpx rgba(102, 114, 168, 0.10),
    0 4rpx 12rpx rgba(17, 24, 39, 0.04);
}

.search-card::before {
  content: '';
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    rgba(255,255,255,0.25),
    rgba(255,255,255,0.96),
    rgba(102,114,168,0.12)
  );
  pointer-events: none;
}

.search-tabs {
  position: relative;
  display: flex;
  align-items: center;
  height: 68rpx;
  margin: 0 0 30rpx;
  padding: 4rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #E9EAF2;
  border: 1rpx solid rgba(238, 237, 244, 0.88);
  box-shadow:
    0 1rpx 2rpx rgba(255,255,255,0.85) inset,
    0 2rpx 8rpx rgba(17,24,39,0.025);
  box-sizing: border-box;
}

.tab-slider {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: calc((100% - 8rpx) / 2);
  height: 60rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.09);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.95) inset,
    0 3rpx 10rpx rgba(102, 114, 168, 0.08);
  transition: transform 240ms ease;
  box-sizing: border-box;
}

.tab-slider.campus {
  transform: translateX(100%);
}

.tab {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  min-width: 0;
  color: #6E6D82;
  background: transparent;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
}

.tab.active {
  color: #4A56A5;
  background: transparent;
  font-weight: 600;
  box-shadow: none;
}

.new-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 20rpx;
  margin-left: 6rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #F49C45;
  color: #FFFFFF;
  font-size: 16rpx;
  line-height: 20rpx;
  font-weight: 600;
}

.city-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 0 24rpx;
  border-bottom: 1rpx solid #EEEDF4;
}

.city-name {
  flex: 1;
  min-height: auto;
  color: #1C1B29;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 600;
}

.location-link {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  color: #4A56A5;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 500;
}

.city-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 18rpx 0 6rpx;
}

.school-suggestions {
  margin: 16rpx 0 4rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.08);
  box-shadow:
    0 1rpx 2rpx rgba(255,255,255,0.92) inset,
    0 8rpx 22rpx rgba(17, 24, 39, 0.04);
}

.school-suggestion {
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.06);
}

.school-suggestion:last-child {
  border-bottom: none;
}

.school-suggestion-name {
  color: #1C1B29;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 650;
}

.school-suggestion-meta {
  margin-top: 5rpx;
  color: #6E6D82;
  font-size: 21rpx;
  line-height: 1.35;
}

.city-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 138rpx;
  height: 50rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6E6D82;
  border: 1rpx solid #EEEDF4;
  font-size: 23rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.city-chip.active {
  background: #6874B4;
  color: #FFFFFF;
  border-color: #6874B4;
  font-weight: 700;
}

.school-chip-row {
  gap: 12rpx;
}

.school-chip {
  min-width: auto;
  height: 48rpx;
  padding: 0 18rpx;
}

.date-room-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 80rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EEEDF4;
}

.date-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 72rpx;
}

.date-room-row picker:first-child .date-block {
  align-items: flex-start;
}

.date-room-row picker:last-child .date-block {
  align-items: flex-end;
}

.date-main {
  width: 100%;
  color: #1C1B29;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 600;
  white-space: nowrap;
}

.date-room-row picker:last-child .date-main,
.date-room-row picker:last-child .date-sub {
  text-align: right;
}

.date-sub {
  width: 100%;
  margin-top: 4rpx;
  color: #8A91A1;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 400;
}

.night-count {
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #EEF0F9;
  color: #4A56A5;
  font-size: 20rpx;
  font-weight: 700;
  align-self: center;
  border: 1rpx solid rgba(102, 114, 168, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255,255,255,0.9) inset,
    0 2rpx 6rpx rgba(102,114,168,0.05);
}

.keyword-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 98rpx;
  border-bottom: 1rpx solid #EEEDF4;
}

.keyword-copy {
  flex: 1;
  min-width: 0;
}

.keyword-label {
  color: #1C1B29;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

.keyword-row input {
  width: 100%;
  min-height: 42rpx;
  margin-top: 4rpx;
  color: #1C1B29;
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 400;
}

.optional-text {
  flex: 0 0 auto;
  color: #8B8A9C;
  font-size: 22rpx;
  line-height: 1.25;
}

.arrow {
  color: #B8B7C6;
  font-size: 38rpx;
  line-height: 1;
}

.query-btn {
  margin-top: 26rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(180deg, #727EB5 0%, #5F6BA6 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 36rpx rgba(95, 107, 166, 0.32);
  padding: 0;
}

.query-btn::after {
  border: none;
}

.query-icon {
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 1;
}

.query-note {
  margin-top: 18rpx;
  text-align: center;
  color: var(--ink-400);
  font-size: 20rpx;
  line-height: 1.4;
}

.hotel-results {
  margin: 0 24rpx 24rpx;
}

.result-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 4rpx 20rpx;
}

.result-kicker {
  color: #9AA3B5;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.result-title {
  margin-top: 6rpx;
  color: #1C1B29;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.result-count {
  flex: 0 0 auto;
  color: #4A56A5;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 600;
}

.result-empty {
  padding: 36rpx 28rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.07);
}

.empty-title {
  color: #1C1B29;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 650;
}

.empty-copy {
  margin-top: 10rpx;
  color: #6E6D82;
  font-size: 23rpx;
  line-height: 1.48;
}

.hotel-result-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.07);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 8rpx 22rpx rgba(17, 24, 39, 0.035);
  box-sizing: border-box;
}

.hotel-result-main {
  min-width: 0;
}

.hotel-result-title {
  color: #1C1B29;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hotel-result-address {
  margin-top: 8rpx;
  color: #6E6D82;
  font-size: 22rpx;
  line-height: 1.42;
}

.hotel-result-meta {
  margin-top: 12rpx;
  color: #4A56A5;
  font-size: 22rpx;
  line-height: 1.42;
  font-weight: 600;
}

.hotel-result-reason {
  margin-top: 12rpx;
  color: #6E6D82;
  font-size: 22rpx;
  line-height: 1.5;
}

.hotel-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.hotel-tag {
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #EEF0F9;
  color: #4A56A5;
  font-size: 19rpx;
  line-height: 1.2;
  box-sizing: border-box;
}

.hotel-result-price {
  margin-top: 18rpx;
  color: #353F8E;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 700;
}

.room-lines {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(102, 114, 168, 0.08);
}

.room-line {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 6rpx 0;
  color: #6E6D82;
  font-size: 22rpx;
  line-height: 1.35;
}

.room-price {
  flex: 0 0 auto;
  color: #4A56A5;
  font-weight: 600;
}

.advisor-service-card {
  position: relative;
  margin: 0 24rpx 24rpx;
  padding: 34rpx 28rpx 24rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.045);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 10rpx 28rpx rgba(17, 24, 39, 0.04),
    0 2rpx 8rpx rgba(17, 24, 39, 0.018);
  box-sizing: border-box;
}

.service-kicker {
  position: absolute;
  left: 28rpx;
  top: -12rpx;
  padding: 0 12rpx;
  background: #FFFFFF;
  color: var(--gold-500);
  font-size: 19rpx;
  line-height: 1.2;
  letter-spacing: 1.5rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.service-list {
  margin-top: 0;
  background: transparent;
}

.service-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 90rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.service-icon {
  flex: 0 0 auto;
  width: 50rpx;
  height: 50rpx;
  opacity: 0.72;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.service-name {
  color: #1C1B29;
  font-size: 26rpx;
  line-height: 1.32;
  font-weight: 600;
}

.service-detail {
  margin-top: 4rpx;
  color: #6E6D82;
  font-size: 22rpx;
  line-height: 1.42;
  font-weight: 400;
}

.service-note {
  margin-top: 16rpx;
  padding: 0 4rpx;
  color: #8A91A1;
  font-size: 21rpx;
  line-height: 1.5;
  font-weight: 400;
}
