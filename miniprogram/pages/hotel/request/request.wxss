.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: #f4f6fb; }
.title { font-size: 38rpx; font-weight: 700; color: #17315f; }
.desc { margin-top: 10rpx; color: #627392; font-size: 25rpx; line-height: 1.6; }
.form { margin-top: 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.input-row { margin-bottom: 20rpx; }
.input-row text { display: block; color: #465c86; font-size: 24rpx; margin-bottom: 10rpx; }
input, textarea, .picker-value { width: 100%; box-sizing: border-box; background: #f7f9ff; border: 1rpx solid #d8e1f5; border-radius: 12rpx; padding: 18rpx; color: #1e2d4e; font-size: 28rpx; }
textarea { min-height: 140rpx; }
.submit-btn { margin-top: 24rpx; background: #5B6596; color: #fff; border-radius: 44rpx; }
