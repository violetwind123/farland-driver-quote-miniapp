.hotel-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 170rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  background:
    linear-gradient(180deg, #F7F8FC 0%, #FFFFFF 100%);
}

.text-logo {
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-brand {
  position: absolute;
  left: 36rpx;
  top: 30rpx;
  z-index: 9;
  width: 190rpx;
  height: 74rpx;
  pointer-events: none;
}

.brand-logo {
  display: block;
  width: 190rpx;
  height: 74rpx;
  opacity: 0.76;
  filter: drop-shadow(0 8rpx 14rpx rgba(0, 0, 0, 0.12));
}

.hero-swiper {
  width: 100%;
  height: 460rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 460rpx;
  padding: 48rpx 44rpx 130rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  box-sizing: border-box;
}

.hero-swiper,
.hero-slide,
.hero-image {
  max-width: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 82% 6%, rgba(255, 255, 255, 0.14), transparent 28%),
    linear-gradient(180deg, rgba(17, 24, 39, 0.22) 0%, rgba(17, 24, 39, 0.08) 38%, rgba(17, 24, 39, 0.46) 100%),
    linear-gradient(90deg, rgba(17, 24, 39, 0.28) 0%, rgba(17, 24, 39, 0.08) 52%, rgba(17, 24, 39, 0.18) 100%);
}

.hero-copy {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 136rpx;
  z-index: 2;
  text-align: center;
}

.hero-title {
  color: #FFFFFF;
  font-size: 38rpx;
  line-height: 1.24;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.22);
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 500;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.16);
}

.search-card {
  position: relative;
  z-index: 5;
  margin: -74rpx 24rpx 24rpx;
  padding: 18rpx 28rpx 30rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 86% 0%, rgba(102, 114, 168, 0.06), transparent 34%),
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(102, 114, 168, 0.07);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 18rpx 42rpx rgba(102, 114, 168, 0.10),
    0 4rpx 12rpx rgba(17, 24, 39, 0.04);
}

.search-card::before {
  content: '';
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    rgba(255,255,255,0.25),
    rgba(255,255,255,0.96),
    rgba(102,114,168,0.12)
  );
  pointer-events: none;
}

.search-tabs {
  position: relative;
  display: flex;
  align-items: center;
  height: 68rpx;
  margin: 0 0 30rpx;
  padding: 4rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background:
    linear-gradient(180deg, #F3F5FA 0%, #EAEDF5 100%);
  border: 1rpx solid rgba(102, 114, 168, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255,255,255,0.85) inset,
    0 2rpx 8rpx rgba(17,24,39,0.025);
  box-sizing: border-box;
}

.tab-slider {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: calc((100% - 8rpx) / 2);
  height: 60rpx;
  border-radius: 18rpx;
  background:
    radial-gradient(circle at 78% 0%, rgba(102, 114, 168, 0.065), transparent 34%),
    linear-gradient(180deg, #FFFFFF 0%, #FDFEFF 100%);
  border: 1rpx solid rgba(102, 114, 168, 0.09);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.95) inset,
    0 3rpx 10rpx rgba(102, 114, 168, 0.08);
  transition: transform 240ms ease;
  box-sizing: border-box;
}

.tab-slider.campus {
  transform: translateX(100%);
}

.tab {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  min-width: 0;
  color: #A0A7B6;
  background: transparent;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 500;
}

.tab.active {
  color: #6672A8;
  background: transparent;
  font-weight: 600;
  box-shadow: none;
}

.new-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 20rpx;
  margin-left: 6rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #F49C45;
  color: #FFFFFF;
  font-size: 16rpx;
  line-height: 20rpx;
  font-weight: 600;
}

.city-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.075);
}

.city-name {
  flex: 1;
  min-height: auto;
  color: #6F7685;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 600;
}

.location-link {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  color: #4B5565;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 500;
}

.date-room-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 80rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.07);
}

.date-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 72rpx;
}

.date-room-row picker:first-child .date-block {
  align-items: flex-start;
}

.date-room-row picker:last-child .date-block {
  align-items: flex-end;
}

.date-main {
  width: 100%;
  color: #1D2433;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 600;
  white-space: nowrap;
}

.date-room-row picker:last-child .date-main,
.date-room-row picker:last-child .date-sub {
  text-align: right;
}

.date-sub {
  width: 100%;
  margin-top: 4rpx;
  color: #8A91A1;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 400;
}

.night-count {
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background:
    linear-gradient(180deg, #F5F6FB 0%, #EEF1F8 100%);
  color: #6D78A8;
  font-size: 20rpx;
  font-weight: 500;
  align-self: center;
  border: 1rpx solid rgba(102, 114, 168, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255,255,255,0.9) inset,
    0 2rpx 6rpx rgba(102,114,168,0.05);
}

.keyword-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.07);
}

.keyword-row input {
  flex: 1;
  min-height: 60rpx;
  color: #1D2433;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 400;
}

.search-icon {
  margin-right: 14rpx;
  color: #6D78A8;
  font-size: 28rpx;
  line-height: 1;
}

.arrow {
  color: #C8CDD8;
  font-size: 38rpx;
  line-height: 1;
}

.query-btn {
  margin-top: 26rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.18), transparent 32%),
    linear-gradient(180deg, #6F79B0 0%, #6672A8 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.22) inset,
    0 8rpx 20rpx rgba(102, 114, 168, 0.18);
  padding: 0;
}

.query-btn::after {
  border: none;
}

.advisor-service-card {
  position: relative;
  margin: 0 24rpx 24rpx;
  padding: 34rpx 28rpx 24rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 86% 0%, rgba(102, 114, 168, 0.035), transparent 34%),
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.045);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 10rpx 28rpx rgba(17, 24, 39, 0.04),
    0 2rpx 8rpx rgba(17, 24, 39, 0.018);
  box-sizing: border-box;
}

.service-kicker {
  position: absolute;
  left: 28rpx;
  top: -12rpx;
  padding: 0 12rpx;
  background: #FFFFFF;
  color: #A1A8B7;
  font-size: 19rpx;
  line-height: 1.2;
  letter-spacing: 1.5rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.service-list {
  margin-top: 0;
  background: transparent;
}

.service-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 90rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.service-icon {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  opacity: 1;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.service-name {
  color: #1D2433;
  font-size: 26rpx;
  line-height: 1.32;
  font-weight: 600;
}

.service-detail {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.42;
  font-weight: 400;
}

.service-note {
  margin-top: 16rpx;
  padding: 0 4rpx;
  color: #8A91A1;
  font-size: 21rpx;
  line-height: 1.5;
  font-weight: 400;
}
