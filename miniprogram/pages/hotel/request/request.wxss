.hotel-page {
  min-height: 100vh;
  padding-bottom: 132rpx;
  box-sizing: border-box;
  background: #F6F7FB;
}

.top-brand {
  padding: 28rpx 36rpx 20rpx;
  background: #FFFFFF;
}

.brand-logo {
  width: 220rpx;
  height: 72rpx;
  display: block;
}

.text-logo {
  color: #1F2433;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.brand-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #8A8F9C;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.hero-swiper {
  height: 400rpx;
}

.hero-slide {
  position: relative;
  height: 400rpx;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, rgba(31, 36, 51, 0.42), rgba(31, 36, 51, 0.08));
}

.hero-copy {
  position: relative;
  z-index: 2;
  max-width: 560rpx;
}

.hero-title {
  color: #FFFFFF;
  font-size: 46rpx;
  line-height: 1.24;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-desc {
  margin-top: 18rpx;
  color: rgba(255,255,255,0.88);
  font-size: 26rpx;
  line-height: 1.55;
}

.search-card {
  position: relative;
  z-index: 5;
  margin: -54rpx 32rpx 0;
  padding: 0 36rpx 36rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 48rpx rgba(31, 36, 51, 0.08);
}

.search-tabs {
  display: flex;
  height: 104rpx;
  margin: 0 -36rpx 28rpx;
  overflow: hidden;
  border-radius: 36rpx 36rpx 0 0;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9AA0AD;
  background: #F0F1F5;
  font-size: 28rpx;
}

.tab.active {
  color: #5B6596;
  background: #FFFFFF;
  font-weight: 500;
}

.new-badge {
  margin-left: 6rpx;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background: #F49C45;
  color: #FFFFFF;
  font-size: 18rpx;
}

.city-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 14rpx 0 28rpx;
  border-bottom: 1rpx solid #ECEEF6;
}

.city-name {
  flex: 1;
  min-height: 58rpx;
  color: #1F2433;
  font-size: 44rpx;
  font-weight: 600;
}

.location-link {
  flex: 0 0 auto;
  color: #1F2433;
  font-size: 28rpx;
}

.date-room-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 92rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #ECEEF6;
}

.date-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 88rpx;
}

.date-room-row picker:first-child .date-block {
  align-items: flex-start;
}

.date-room-row picker:last-child .date-block {
  align-items: flex-end;
}

.date-main {
  width: 100%;
  color: #1F2433;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 600;
  white-space: nowrap;
}

.date-room-row picker:last-child .date-main,
.date-room-row picker:last-child .date-sub {
  text-align: right;
}

.date-sub {
  width: 100%;
  margin-top: 10rpx;
  color: #8A8F9C;
  font-size: 23rpx;
  line-height: 30rpx;
}

.night-count {
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(91, 101, 150, 0.10);
  color: #5B6596;
  font-size: 22rpx;
  align-self: center;
}

.keyword-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #ECEEF6;
}

.keyword-row input {
  flex: 1;
  min-height: 72rpx;
  color: #1F2433;
  font-size: 28rpx;
}

.search-icon {
  margin-right: 16rpx;
  color: #5B6596;
  font-size: 40rpx;
}

.arrow {
  color: #C4C8D2;
  font-size: 52rpx;
}

.query-btn {
  margin-top: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #5B6596;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
}

.benefit-card {
  margin: 32rpx;
  padding: 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 14rpx 36rpx rgba(31, 36, 51, 0.06);
}

.benefit-title {
  margin-bottom: 34rpx;
  text-align: center;
  color: #1F2433;
  font-size: 32rpx;
  font-weight: 600;
}

.benefit-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.benefit-item {
  text-align: center;
}

.benefit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 14rpx;
  border-radius: 50%;
  background: rgba(91, 101, 150, 0.10);
  color: #5B6596;
}

.benefit-icon image {
  width: 38rpx;
  height: 38rpx;
}

.benefit-text {
  color: #1F2433;
  font-size: 24rpx;
}
