.page { min-height: 100vh; padding: 28rpx 28rpx 130rpx; box-sizing: border-box; background: #f4f6fb; }
.brand-area { margin-bottom: 20rpx; }
.brand { font-size: 46rpx; font-weight: 700; color: #17315f; }
.tagline { margin-top: 8rpx; color: #5B6596; font-size: 26rpx; }
.banner-swiper { height: 260rpx; margin-bottom: -34rpx; }
.banner-card { height: 230rpx; border-radius: 22rpx; padding: 32rpx; box-sizing: border-box; color: #fff; }
.banner-one { background: #5B6596; }
.banner-two { background: #28476f; }
.banner-title { font-size: 34rpx; font-weight: 700; }
.banner-desc { margin-top: 16rpx; font-size: 25rpx; line-height: 1.5; opacity: 0.92; }
.search-card, .benefit-card { position: relative; background: #fff; border-radius: 18rpx; padding: 24rpx; box-shadow: 0 12rpx 26rpx rgba(35, 51, 91, 0.08); }
.card-title { font-size: 32rpx; font-weight: 700; color: #1f3266; margin-bottom: 16rpx; }
.input-row { margin-bottom: 20rpx; }
.input-row text { display: block; color: #465c86; font-size: 24rpx; margin-bottom: 10rpx; }
input, textarea, .picker-value { width: 100%; box-sizing: border-box; background: #f7f9ff; border: 1rpx solid #d8e1f5; border-radius: 12rpx; padding: 18rpx; color: #1e2d4e; font-size: 28rpx; }
textarea { min-height: 110rpx; }
.date-grid, .more-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.submit-btn { margin-top: 12rpx; background: #5B6596; color: #fff; border-radius: 44rpx; }
.benefit-card { margin-top: 22rpx; }
.benefit-title { font-size: 30rpx; font-weight: 700; color: #1f3266; margin-bottom: 16rpx; }
.benefit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.benefit-grid view { background: #f7f9ff; color: #465c86; border-radius: 12rpx; padding: 18rpx; font-size: 24rpx; text-align: center; }
