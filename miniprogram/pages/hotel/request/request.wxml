<view class="hotel-page">
  <view class="top-brand">
    <image
      wx:if="{{logoReady}}"
      class="brand-logo"
      src="/assets/images/logo-farland.png"
      mode="aspectFit"
      binderror="onLogoError"
    />
    <view wx:else class="text-logo">Farland</view>
    <text class="brand-subtitle">尊享美国酒店与访校住宿服务</text>
  </view>

  <swiper class="hero-swiper" indicator-dots autoplay circular interval="4800">
    <swiper-item wx:for="{{heroSlides}}" wx:key="image">
      <view class="hero-slide">
        <image class="hero-image" src="{{item.image}}" mode="aspectFill" />
        <view class="hero-mask"></view>
        <view class="hero-copy">
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-desc">{{item.desc}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="search-card">
    <view class="search-tabs">
      <view class="tab active" data-type="hotel" bindtap="onServiceTabTap">实时酒店</view>
      <view class="tab" data-type="package" bindtap="onServiceTabTap">酒店套餐</view>
      <view class="tab" data-type="campus" bindtap="onServiceTabTap">
        访校住宿
        <text class="new-badge">NEW</text>
      </view>
    </view>

    <view class="city-row">
      <input class="city-name" value="{{form.city}}" data-field="city" bindinput="onInput" placeholder="Boston" />
      <view class="location-link" bindtap="useCurrentLocation">⌖ 我的位置</view>
    </view>

    <view class="date-room-row">
      <picker mode="date" value="{{form.check_in_date}}" data-field="check_in_date" bindchange="onDateChange">
        <view class="date-block">
          <view class="date-main">{{displayCheckIn}}</view>
          <view class="date-sub">{{displayCheckInLabel}}</view>
        </view>
      </picker>

      <view class="night-count">{{nights}}晚</view>

      <picker mode="date" value="{{form.check_out_date}}" data-field="check_out_date" bindchange="onDateChange">
        <view class="date-block">
          <view class="date-main">{{displayCheckOut}}</view>
          <view class="date-sub">{{displayCheckOutLabel}}</view>
        </view>
      </picker>
    </view>

    <view class="keyword-row">
      <text class="search-icon">⌕</text>
      <input
        value="{{form.location_preference}}"
        data-field="location_preference"
        bindinput="onInput"
        placeholder="搜索学校 / 位置 / 品牌 / 酒店偏好"
      />
      <text class="arrow">›</text>
    </view>

    <button class="query-btn" loading="{{submitting}}" bindtap="submitRequest">
      {{submitting ? '提交中...' : '查询'}}
    </button>
  </view>

  <view class="benefit-card">
    <view class="benefit-title">Farland 会员 尊享特权</view>
    <view class="benefit-grid">
      <view class="benefit-item">
        <view class="benefit-icon">H</view>
        <view class="benefit-text">酒店礼遇</view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">✦</view>
        <view class="benefit-text">积分福利</view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">U</view>
        <view class="benefit-text">访校服务</view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">C</view>
        <view class="benefit-text">联系顾问</view>
      </view>
    </view>
  </view>
</view>
