<view class="hotel-page">
  <view class="hero-brand">
    <image wx:if="{{logoReady}}" class="brand-logo" src="/assets/images/logo-farland-emboss.png" mode="aspectFit" binderror="onLogoError" />
    <view wx:else class="text-logo">Farland</view>
  </view>

  <swiper class="hero-swiper" indicator-dots autoplay circular interval="4800">
    <swiper-item wx:for="{{heroSlides}}" wx:key="image">
      <view class="hero-slide">
        <image class="hero-image" src="{{item.image}}" mode="aspectFill" />
        <view class="hero-mask"></view>
        <view class="hero-copy">
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-desc">{{item.desc}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="search-card">
    <view class="search-tabs">
      <view class="tab-slider {{serviceType === 'campus' ? 'campus' : ''}}"></view>
      <view class="tab {{serviceType === 'hotel' ? 'active' : ''}}" data-type="hotel" bindtap="onServiceTabTap">酒店预订</view>
      <view class="tab {{serviceType === 'campus' ? 'active' : ''}}" data-type="campus" bindtap="onServiceTabTap">访校酒店</view>
    </view>

    <view class="city-row">
      <input class="city-name" value="{{form.city}}" data-field="city" bindinput="onInput" placeholder="{{placePlaceholder}}" />
      <view class="location-link" bindtap="useCurrentLocation">⌖ {{placeActionText}}</view>
    </view>

    <view class="date-room-row">
      <picker mode="date" value="{{form.check_in_date}}" data-field="check_in_date" bindchange="onDateChange">
        <view class="date-block">
          <view class="date-main">{{displayCheckIn}}</view>
          <view class="date-sub">{{displayCheckInLabel}}</view>
        </view>
      </picker>

      <view class="night-count">{{nights}}晚</view>

      <picker mode="date" value="{{form.check_out_date}}" data-field="check_out_date" bindchange="onDateChange">
        <view class="date-block">
          <view class="date-main">{{displayCheckOut}}</view>
          <view class="date-sub">{{displayCheckOutLabel}}</view>
        </view>
      </picker>
    </view>

    <view class="keyword-row">
      <text class="search-icon">⌕</text>
      <input
        value="{{form.location_preference}}"
        data-field="location_preference"
        bindinput="onInput"
        placeholder="搜索学校 / 位置 / 品牌 / 酒店偏好"
      />
      <text class="arrow">›</text>
    </view>

    <view wx:if="{{showContactFields}}" class="contact-mini">
      <input value="{{form.customer_name}}" data-field="customer_name" bindinput="onInput" placeholder="联系人" />
      <input value="{{form.contact}}" data-field="contact" bindinput="onInput" placeholder="微信 / 手机 / 邮箱" />
    </view>

    <button class="query-btn" loading="{{submitting}}" bindtap="submitRequest">
      {{submitting ? '提交中...' : '查询'}}
    </button>
  </view>

  <view class="advisor-service-card">
    <view class="service-kicker">FARLAND CONCIERGE</view>

    <view class="service-list">
      <view class="service-row">
        <image class="service-icon" src="/assets/icons/service-campus.png" mode="aspectFit" />
        <view class="service-copy">
          <view class="service-name">大学参访预约</view>
          <view class="service-detail">官方 Campus Tour / Info Session 查询协助</view>
        </view>
      </view>

      <view class="service-row">
        <image class="service-icon" src="/assets/icons/service-route.png" mode="aspectFit" />
        <view class="service-copy">
          <view class="service-name">行程方案制定</view>
          <view class="service-detail">按学校位置与交通时间优化路线</view>
        </view>
      </view>

      <view class="service-row">
        <image class="service-icon" src="/assets/icons/service-room.png" mode="aspectFit" />
        <view class="service-copy">
          <view class="service-name">酒店礼遇协助</view>
          <view class="service-detail">房型、早餐、延迟退房等申请协助</view>
        </view>
      </view>

      <view class="service-row">
        <image class="service-icon" src="/assets/icons/service-date.png" mode="aspectFit" />
        <view class="service-copy">
          <view class="service-name">热门日期方案</view>
          <view class="service-detail">优先确认可订、可取消的稳定选择</view>
        </view>
      </view>

      <view class="service-row">
        <image class="service-icon" src="/assets/icons/service-transfer.png" mode="aspectFit" />
        <view class="service-copy">
          <view class="service-name">接送预约协助</view>
          <view class="service-detail">按车型、行李与英文需求确认报价</view>
        </view>
      </view>
    </view>

    <view class="service-note">
      以上服务均为 Farland Concierge 免费服务。
    </view>
  </view>

</view>
