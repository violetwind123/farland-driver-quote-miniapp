<view class="results-page">
  <view class="results-header">
    <view class="back-button" bindtap="goBack">‹</view>
    <view class="header-copy">
      <view class="result-title">{{title}}</view>
      <view class="result-subtitle">{{subtitle}} · {{searchMeta}}</view>
    </view>
  </view>

  <view class="result-toolbar">
    <view class="result-count">{{loading ? '搜索中' : resultCount + ' 家酒店'}}</view>
    <view class="result-note">{{mode === 'campus' ? '参考学校酒店清单，预订前将重新确认价格' : '列表价为实时估算，预订前将重新确认'}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading-block">
    <view class="loading-title">正在查询酒店</view>
    <view class="loading-copy">正在连接酒店供应商接口并匹配 Farland 参考酒店。</view>
  </view>

  <view wx:elif="{{error}}" class="empty-block">
    <view class="empty-title">{{error}}</view>
    <view class="empty-copy">可返回调整学校、城市或日期后重新搜索。</view>
  </view>

  <view wx:else class="hotel-list">
    <view wx:for="{{results}}" wx:for-index="index" wx:key="hotel_id" class="hotel-card {{item.canOpenDetail ? 'clickable' : ''}}" bindtap="openHotelDetail" data-index="{{index}}">
      <image class="hotel-thumb" src="{{item.displayPhoto}}" mode="aspectFill" />
      <view class="hotel-card-main">
        <view class="card-top">
          <view class="hotel-title-block">
            <view class="hotel-name">{{item.displayName}}</view>
            <view wx:if="{{item.displayNameEn}}" class="hotel-name-en">{{item.displayNameEn}}</view>
          </view>
          <view wx:if="{{item.displayTags && item.displayTags.length}}" class="badge-row">
            <view wx:if="{{item.displayTags && item.displayTags.length}}" class="source-pill farland">{{item.displayTags[0]}}</view>
          </view>
        </view>
        <view wx:if="{{item.hasTransport}}" class="transport-row">
          <text wx:for="{{item.transportItems}}" wx:key="key" wx:for-item="tag" class="transport-pill {{tag.className}}">{{tag.label}}</text>
        </view>
        <view wx:if="{{item.transportNote}}" class="hotel-traffic">{{item.transportNote}}</view>
        <view class="hotel-address">{{item.displayAddress}}</view>
        <view wx:if="{{item.hasReason}}" class="hotel-reason">{{item.displayReason}}</view>
        <view class="price-row">
          <view class="hotel-price">
            <text class="price-currency">{{item.priceCurrency}}</text>
            <text class="price-number">{{item.priceAmount}}</text>
            <text class="price-suffix"> 起</text>
          </view>
          <view wx:if="{{item.canOpenDetail}}" class="detail-link">查看房型 ›</view>
        </view>
      </view>
    </view>
  </view>
</view>
