@import "/styles/theme.wxss";
page { font-size: 28rpx; }

.results-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: var(--bg-page);
}

.results-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0 22rpx;
}

.back-button {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--bg-card);
  color: var(--brand-600);
  font-size: 44rpx;
  line-height: 54rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(27, 35, 64, 0.05);
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.result-title {
  color: var(--ink-900);
  font-size: 32rpx;
  line-height: 1.32;
  font-weight: 700;
}

.result-subtitle {
  margin-top: 6rpx;
  color: var(--ink-600);
  font-size: 22rpx;
  line-height: 1.4;
}

.result-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 8rpx 2rpx 14rpx;
}

.result-note {
  min-width: 0;
  color: var(--ink-400);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}

/* ---------- curated header ---------- */
.curated-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 4rpx 20rpx;
}

.curated-copy {
  min-width: 0;
}

.curated-kicker {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--gold-500);
  font-weight: 600;
}

.curated-count {
  margin-top: 4rpx;
  font-family: var(--font-serif);
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--ink-900);
}

.sort-row {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.loading-block,
.empty-block {
  margin-top: 18rpx;
  padding: 42rpx 30rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
}

.loading-title,
.empty-title {
  color: var(--ink-900);
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.loading-copy,
.empty-copy {
  margin-top: 10rpx;
  color: var(--ink-600);
  font-size: 23rpx;
  line-height: 1.5;
}

.hotel-list {
  padding-bottom: 30rpx;
}

/* ---------- vertical curated hotel card ---------- */
.hotel-card {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  box-sizing: border-box;
}

.hotel-card.recommended {
  border: 2rpx solid rgba(166, 136, 91, 0.5);
  box-shadow: 0 24rpx 60rpx rgba(166, 136, 91, 0.12);
}

.hotel-card.clickable {
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.hotel-card.clickable:active {
  transform: scale(0.99);
}

.hotel-media {
  position: relative;
  height: 236rpx;
  background: var(--brand-50);
}

.hotel-cover {
  width: 100%;
  height: 100%;
}

/* override theme .recommend-badge top:-16rpx/left:32rpx so the badge
   sits inside the media instead of clipping under overflow:hidden */
.media-badge {
  top: 20rpx;
  left: 20rpx;
  right: auto;
}

.score-chip {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: rgba(27, 35, 64, 0.82);
  color: var(--gold-50);
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-chip .score-label {
  font-weight: 400;
  font-size: 18rpx;
  color: rgba(246, 241, 231, 0.75);
}

.hotel-body {
  padding: 22rpx 28rpx 26rpx;
}

.hotel-name {
  font-family: var(--font-serif);
  color: var(--ink-900);
  font-size: 31rpx;
  line-height: 1.24;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hotel-name-en {
  margin-top: 5rpx;
  color: var(--ink-400);
  font-size: 20rpx;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hotel-meta {
  margin-top: 6rpx;
  color: var(--ink-600);
  font-size: 21rpx;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.facility-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.facility-tag {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: var(--brand-50);
  color: var(--brand-600);
  font-size: 19rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.facility-tag.free-cancel {
  background: var(--success-bg);
  color: var(--success);
  font-weight: 600;
}

.hotel-reason {
  margin-top: 12rpx;
  color: var(--ink-400);
  font-size: 22rpx;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hotel-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.itin-pill {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--gold-50);
  color: var(--gold-700);
  font-size: 18rpx;
  font-weight: 600;
  max-width: 60%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.itin-spacer {
  flex: 1;
}

.hotel-price {
  min-width: 0;
  color: var(--ink-900);
  font-family: var(--font-ui);
  font-variant-numeric: proportional-nums;
  letter-spacing: 0;
  line-height: 1;
  white-space: nowrap;
}

.price-currency {
  color: var(--brand-600);
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 4rpx;
  letter-spacing: 0;
}

.price-number {
  font-family: var(--font-ui);
  color: var(--ink-900);
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.price-suffix {
  color: var(--ink-400);
  font-size: 21rpx;
}
