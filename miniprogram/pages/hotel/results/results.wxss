.results-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #F4F5F9;
}

.results-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0 22rpx;
}

.back-button {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #4A56A5;
  font-size: 44rpx;
  line-height: 54rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(28, 27, 41, 0.05);
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.result-title {
  color: #1C1B29;
  font-size: 32rpx;
  line-height: 1.32;
  font-weight: 700;
}

.result-subtitle {
  margin-top: 6rpx;
  color: #6E6D82;
  font-size: 22rpx;
  line-height: 1.4;
}

.result-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 8rpx 2rpx 22rpx;
}

.result-count {
  flex: 0 0 auto;
  color: #1C1B29;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.result-note {
  flex: 1;
  min-width: 0;
  color: #8B8A9C;
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}

.loading-block,
.empty-block {
  margin-top: 18rpx;
  padding: 42rpx 30rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEEDF4;
  box-shadow: 0 10rpx 30rpx rgba(28, 27, 41, 0.05);
}

.loading-title,
.empty-title {
  color: #1C1B29;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.loading-copy,
.empty-copy {
  margin-top: 10rpx;
  color: #6E6D82;
  font-size: 23rpx;
  line-height: 1.5;
}

.hotel-list {
  padding-bottom: 30rpx;
}

.hotel-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 1rpx 4rpx rgba(28, 27, 41, 0.04), 0 10rpx 30rpx rgba(28, 27, 41, 0.06);
  box-sizing: border-box;
}

.hotel-card.clickable {
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.hotel-card.clickable:active {
  transform: scale(0.99);
}

.hotel-thumb {
  flex: 0 0 auto;
  width: 164rpx;
  height: 164rpx;
  border-radius: 26rpx;
  background: #EEF0F9;
}

.hotel-card-main {
  flex: 1;
  min-width: 0;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.hotel-title-block {
  flex: 1;
  min-width: 0;
}

.hotel-name {
  color: #1C1B29;
  font-size: 30rpx;
  line-height: 1.22;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hotel-name-en {
  margin-top: 5rpx;
  color: #8B8A9C;
  font-size: 20rpx;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.badge-row {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  max-width: 170rpx;
}

.source-pill {
  max-width: 170rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 650;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.source-pill.live {
  background: #E7F2E8;
  color: #4E8F58;
}

.source-pill.reference,
.source-pill.farland {
  background: #FBF1E1;
  color: #A6772A;
}

.transport-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.transport-pill {
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #EEF0F9;
  color: #4A56A5;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  box-sizing: border-box;
}

.transport-pill.traffic {
  background: #E7F2E8;
  color: #4E8F58;
}

.transport-pill.traffic.moderate,
.transport-pill.traffic.high {
  background: #FBF1E1;
  color: #A6772A;
}

.hotel-address,
.hotel-reason,
.hotel-traffic {
  margin-top: 9rpx;
  color: #6E6D82;
  font-size: 23rpx;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hotel-reason {
  color: #8B8A9C;
}

.hotel-traffic {
  color: #8B8A9C;
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 14rpx;
}

.hotel-price {
  flex: 1;
  min-width: 0;
  color: #353F8E;
  line-height: 1;
  white-space: nowrap;
}

.price-currency {
  color: #4A56A5;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 5rpx;
}

.price-number {
  font-family: "Cormorant Garamond", Georgia, "Songti SC", serif;
  color: #353F8E;
  font-size: 38rpx;
  font-weight: 700;
}

.price-suffix {
  color: #8B8A9C;
  font-size: 21rpx;
}

.detail-link {
  flex: 0 0 auto;
  color: #4A56A5;
  font-size: 23rpx;
  line-height: 1.25;
  text-align: right;
  font-weight: 700;
}
