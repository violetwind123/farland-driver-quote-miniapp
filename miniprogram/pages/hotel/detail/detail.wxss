.detail-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 170rpx;
  box-sizing: border-box;
  background: #F4F5F9;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0 24rpx;
}

.back-button {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #4A56A5;
  font-size: 44rpx;
  line-height: 54rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(28, 27, 41, 0.05);
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.detail-title {
  color: #1C1B29;
  font-size: 32rpx;
  line-height: 1.32;
  font-weight: 700;
}

.detail-subtitle {
  margin-top: 6rpx;
  color: #6E6D82;
  font-size: 22rpx;
  line-height: 1.4;
}

.hotel-hero,
.room-card,
.empty-card,
.notice-card {
  border-radius: 41rpx;
  background: #FFFFFF;
  box-shadow: 0 1rpx 4rpx rgba(28, 27, 41, 0.04), 0 19rpx 56rpx rgba(28, 27, 41, 0.06);
  box-sizing: border-box;
}

.hotel-hero {
  overflow: hidden;
}

.hero-image-wrap {
  position: relative;
  height: 306rpx;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 306rpx;
  display: block;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(28, 27, 41, 0.05) 18%, rgba(28, 27, 41, 0.62) 100%);
}

.hero-overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
}

.source-pill {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #E7F2E8;
  color: #4E8F58;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 650;
}

.hotel-name {
  margin-top: 14rpx;
  color: #FFFFFF;
  font-family: "Cormorant Garamond", Georgia, "Songti SC", serif;
  font-size: 42rpx;
  line-height: 1.08;
  font-weight: 700;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.22);
}

.hotel-name-en {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.82);
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 520;
  text-shadow: 0 3rpx 10rpx rgba(0,0,0,0.18);
}

.transport-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.transport-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.88);
  color: #4A56A5;
  font-size: 22rpx;
  font-weight: 650;
}

.transport-pill.traffic {
  background: rgba(231, 242, 232, 0.92);
  color: #4E8F58;
}

.transport-pill.traffic.moderate,
.transport-pill.traffic.high {
  background: rgba(251, 241, 225, 0.94);
  color: #A6772A;
}

.hero-body {
  padding: 24rpx 28rpx 28rpx;
}

.hotel-address,
.hotel-reason,
.traffic-note,
.empty-copy,
.notice-card {
  color: #6E6D82;
  font-size: 23rpx;
  line-height: 1.5;
}

.traffic-note {
  margin-bottom: 10rpx;
}

.hotel-reason {
  margin-top: 10rpx;
  color: #8B8A9C;
}

.price-row {
  margin-top: 18rpx;
}

.hotel-price {
  color: #353F8E;
  line-height: 1;
}

.price-currency {
  color: #4A56A5;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 6rpx;
}

.price-number {
  font-family: "Cormorant Garamond", Georgia, "Songti SC", serif;
  color: #353F8E;
  font-size: 52rpx;
  font-weight: 700;
}

.price-note {
  margin-top: 6rpx;
  color: #8B8A9C;
  font-size: 21rpx;
  line-height: 1.35;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx 2rpx 16rpx;
}

.section-title {
  color: #1C1B29;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 750;
}

.section-count {
  color: #4A56A5;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.empty-card,
.notice-card {
  padding: 30rpx;
}

.empty-title {
  color: #1C1B29;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 720;
}

.empty-copy {
  margin-top: 10rpx;
}

.error-card .empty-title,
.error-card .empty-copy {
  color: #B64747;
}

.room-list {
  display: grid;
  gap: 18rpx;
}

.room-card {
  position: relative;
  padding: 26rpx;
  border: 3rpx solid transparent;
}

.room-card.selected {
  border-color: #6874B4;
  box-shadow: 0 1rpx 4rpx rgba(28, 27, 41, 0.04), 0 19rpx 56rpx rgba(104, 116, 180, 0.12);
}

.room-card:active {
  transform: scale(0.99);
}

.selected-check {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #6874B4;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 700;
}

.room-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.room-name {
  flex: 1;
  min-width: 0;
  padding-right: 26rpx;
  color: #1C1B29;
  font-size: 29rpx;
  line-height: 1.34;
  font-weight: 740;
}

.room-price {
  flex: 0 0 auto;
  max-width: 230rpx;
  color: #353F8E;
  font-family: "Cormorant Garamond", Georgia, "Songti SC", serif;
  font-size: 32rpx;
  line-height: 1.25;
  text-align: right;
  font-weight: 760;
}

.room-price text {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  color: #4A56A5;
  font-size: 21rpx;
  font-weight: 650;
}

.room-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.room-tag {
  max-width: 100%;
  padding: 7rpx 13rpx;
  border-radius: 14rpx;
  background: #EEF0F9;
  color: #4A56A5;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
  box-sizing: border-box;
}

.policy-badge {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #FBF1E1;
  color: #A6772A;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 650;
}

.policy-badge.strict {
  background: #FBF1E1;
}

.room-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EFF5;
}

.room-note {
  flex: 1;
  min-width: 0;
  color: #8B8A9C;
  font-size: 21rpx;
  line-height: 1.35;
}

.select-state {
  flex: 0 0 auto;
  color: #4A56A5;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 750;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid #EEEDF4;
  box-sizing: border-box;
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
}

.bottom-btn {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #6874B4 0%, #8993CC 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  letter-spacing: 1rpx;
  font-weight: 650;
  box-shadow: 0 8rpx 22rpx rgba(104,116,180,0.38), inset 0 1rpx 0 rgba(255,255,255,0.25);
}

.bottom-btn[disabled] {
  opacity: 0.4;
}

.bottom-btn::after {
  border: none;
}
