<view class="page">
  <view class="brand">Farland</view>
  <view wx:if="{{!loading && !errorMessage}}" class="panel auth-panel">
    <view class="title">运营登录</view>
    <view class="desc">该入口仅限 Farland 运营使用。司机请通过 Farland 运营发送的报价邀请进入报价页面。</view>
    <button class="primary-btn" bindtap="login">运营微信登录</button>
  </view>
  <view wx:if="{{loading}}" class="panel">认证中...</view>
  <view wx:elif="{{errorMessage}}" class="panel error">
    <view class="title">认证失败</view>
    <view class="desc">{{errorMessage}}</view>
    <button class="primary-btn" bindtap="login">重新登录</button>
  </view>
</view>
