.page { min-height: 100vh; padding: 48rpx 24rpx; box-sizing: border-box; }
.brand { font-size: 42rpx; font-weight: 600; color: #17315f; margin-bottom: 28rpx; }
.panel { background: #fff; border-radius: 16rpx; padding: 28rpx; color: #253554; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.desc { color: #627392; line-height: 1.6; }
.error { color: #5B6596; }
.auth-panel .desc { margin-bottom: 24rpx; }
.primary-btn { margin-top: 24rpx; background: #5B6596; color: #fff; border-radius: 44rpx; font-size: 30rpx; }
