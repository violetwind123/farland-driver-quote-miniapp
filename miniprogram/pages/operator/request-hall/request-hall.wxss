.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f4f6fb; }
.tabs { display: flex; gap: 10rpx; overflow-x: auto; margin-bottom: 18rpx; }
.tab { flex: 0 0 auto; padding: 12rpx 20rpx; border-radius: 28rpx; background: #fff; color: #627392; font-size: 24rpx; }
.tab.active { background: #5B6596; color: #fff; }
.state, .request-item { background: #fff; border-radius: 16rpx; }
.state { padding: 28rpx; color: #627392; }
.request-item { padding: 22rpx; margin-bottom: 16rpx; box-shadow: 0 8rpx 24rpx rgba(31, 36, 51, 0.04); }
.row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.request-no { font-weight: 700; color: #253554; }
.meta, .counts { color: #627392; font-size: 25rpx; }
.preview { color: #253554; font-size: 26rpx; line-height: 1.6; margin-top: 10rpx; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.request-footer { display: flex; gap: 12rpx; margin-top: 14rpx; }
.count-pill { padding: 8rpx 16rpx; border-radius: 999rpx; background: #f2f4f7; color: #627392; font-size: 23rpx; }
.deadline { margin-top: 12rpx; color: #627392; font-size: 24rpx; }
.deadline-risk { color: #C36F16; font-weight: 600; }
.status-pill { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; min-height: 42rpx; padding: 0 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600; }
.status-pending_selection { background: rgba(244, 156, 69, 0.14); color: #C36F16; }
.status-expiring_soon { background: rgba(220, 73, 73, 0.12); color: #C84343; }
.status-no_quote, .status-quoting { background: rgba(91, 101, 150, 0.10); color: #5B6596; }
.status-assigned { background: rgba(23, 153, 91, 0.10); color: #17995B; }
.status-cancelled { background: rgba(119, 126, 144, 0.12); color: #687084; }
