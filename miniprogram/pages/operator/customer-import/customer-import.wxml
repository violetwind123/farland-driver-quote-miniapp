<view class="page">
  <view class="hero">
    <view class="kicker">CUSTOMER TRIP IMPORT</view>
    <view class="title">导入客户行程</view>
    <view class="desc">粘贴标准 1.0.0 行程 JSON。写入并生成草稿后会自动进入该行程的管理页（预览 / 发布 / 分享卡都在那里完成）。</view>
  </view>

  <view wx:if="{{importStage === 'editing' || importStage === 'previewed'}}" class="panel">
    <view class="section-title">行程 JSON</view>
    <textarea
      class="json-input"
      value="{{jsonText}}"
      placeholder="{{sampleHint}}"
      maxlength="-1"
      bindinput="onJsonInput"
    />
    <button class="secondary-btn" bindtap="fillSample">填入多天费用样例</button>
  </view>

  <view wx:if="{{errors.length}}" class="panel error-panel">
    <view class="section-title">校验错误</view>
    <view wx:for="{{errors}}" wx:key="*this" class="error-row">{{item}}</view>
  </view>

  <view wx:if="{{preview}}" class="panel">
    <view class="section-title">{{importStage === 'previewed' ? '预览完成' : '行程状态'}}</view>
    <view class="summary-grid">
      <view class="summary-item">
        <view class="summary-label">trip_id</view>
        <view class="summary-value">{{preview.display_trip_id || '-'}}</view>
      </view>
      <view class="summary-item">
        <view class="summary-label">天数</view>
        <view class="summary-value">{{preview.display_day_count || 0}}</view>
      </view>
      <view class="summary-item">
        <view class="summary-label">酒店</view>
        <view class="summary-value">{{preview.display_hotel_count || 0}}</view>
      </view>
      <view class="summary-item">
        <view class="summary-label">航班</view>
        <view class="summary-value">{{preview.display_flight_count || 0}}</view>
      </view>
    </view>
    <view wx:if="{{preview.display_title}}" class="result-line">标题：{{preview.display_title}}</view>
    <view wx:if="{{preview.display_external_trip_id}}" class="result-line">external_trip_id：{{preview.display_external_trip_id}}</view>
    <view class="result-line">动作：{{preview.display_action || 'preview'}}</view>
    <view class="review-state">
      <view class="review-pill">review：{{preview.display_review_status || 'pending_review'}}</view>
      <view class="review-pill">visibility：{{preview.display_visibility_status || 'hidden'}}</view>
      <view class="review-pill">version：{{preview.display_published_version}}</view>
    </view>
    <view wx:if="{{preview.criticalWarningList.length}}" class="critical-box">
      <view class="warning-title">Critical warnings</view>
      <view wx:for="{{preview.criticalWarningList}}" wx:key="*this" class="warning-row">{{item}}</view>
    </view>
    <view wx:if="{{preview.warningList.length}}" class="warning-box">
      <view class="warning-title">需要运营复核</view>
      <view wx:for="{{preview.warningList}}" wx:key="*this" class="warning-row">{{item}}</view>
    </view>
    <view wx:if="{{preview.operationList.length}}" wx:for="{{preview.operationList}}" wx:key="key" class="operation-row">
      <view class="operation-main">{{item.collection}} · {{item.type}}</view>
      <view class="operation-sub">{{item.title || item.key}}</view>
    </view>
  </view>

  <view wx:if="{{importStage === 'draft_ready'}}" class="panel draft-panel">
    <view class="section-title">草稿已生成</view>
    <view class="draft-copy">通常会自动进入该行程的管理页；若停留在本页，可用下方按钮，或到「行程管理」打开该行程继续预览 / 发布 / 生成分享卡。</view>
    <view class="result-line">trip_id：{{draftTripId}}</view>
    <view class="review-state">
      <view class="review-pill">review：{{(draftPreviewMeta && draftPreviewMeta.review_status) || 'pending_review'}}</view>
      <view class="review-pill">visibility：{{(draftPreviewMeta && draftPreviewMeta.visibility_status) || 'hidden'}}</view>
      <view class="review-pill">version：{{(draftPreviewMeta && draftPreviewMeta.published_version) || 0}}</view>
    </view>
    <view class="action-row">
      <button class="secondary-btn tight-btn" loading="{{previewLoading}}" bindtap="openDraftCustomerPreviewFromImport">预览客户界面</button>
      <button class="danger-btn tight-btn" loading="{{discardLoading}}" bindtap="discardDraftAndReimport">重新录入</button>
    </view>
  </view>

  <view class="button-bar" wx:if="{{importStage === 'editing' || importStage === 'previewed'}}">
    <button class="preview-btn" loading="{{dryRunLoading}}" disabled="{{dryRunLoading || applyLoading}}" bindtap="previewImport">预览导入</button>
    <button class="apply-btn" loading="{{applyLoading}}" disabled="{{dryRunLoading || applyLoading || !canApplyPreview}}" bindtap="applyImport">确认写入并生成客户界面预览</button>
  </view>
</view>
