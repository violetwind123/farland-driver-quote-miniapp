<view class="page">
  <view class="header">
    <view class="title">Farland 运营控制台</view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中...</view>

  <block wx:else>
    <view class="summary-grid">
      <view class="summary-card" data-tab="quoting" bindtap="openRequestHall">
        <view class="summary-value">{{summary.quoting_count || 0}}</view>
        <view class="summary-label">报价中</view>
      </view>
      <view class="summary-card" data-tab="pending_selection" bindtap="openRequestHall">
        <view class="summary-value">{{summary.pending_selection_count || 0}}</view>
        <view class="summary-label">待选择</view>
      </view>
      <view class="summary-card" data-tab="assigned" bindtap="openRequestHall">
        <view class="summary-value">{{summary.assigned_count || 0}}</view>
        <view class="summary-label">已选择</view>
      </view>
      <view class="summary-card" data-tab="cancelled" bindtap="openRequestHall">
        <view class="summary-value">{{summary.cancelled_count || 0}}</view>
        <view class="summary-label">已取消</view>
      </view>
    </view>

    <view class="utility-card" bindtap="openDriverSummary">
      <view>
        <view class="utility-title">司机信息</view>
        <view class="utility-desc">查看各区域司机和车辆资源</view>
      </view>
      <view class="chevron">›</view>
    </view>

    <view class="utility-card trip-management-entry" bindtap="openTripManagement">
      <view>
        <view class="utility-title">行程管理</view>
        <view class="utility-desc">导入、审核、发布客户行程，并发送每日评价卡。</view>
      </view>
      <view class="chevron">›</view>
    </view>

    <view class="utility-card" bindtap="openReviewSummary">
      <view>
        <view class="utility-title">评价汇总</view>
        <view class="utility-desc">按司机 / 行程查看每日评价，低分自动标记跟进</view>
      </view>
      <view class="chevron">›</view>
    </view>

    <view class="utility-card" bindtap="openCustomerImport">
      <view>
        <view class="utility-title">导入客户行程</view>
        <view class="utility-desc">粘贴 JSON，预览校验后写入客户行程</view>
      </view>
      <view class="chevron">›</view>
    </view>

    <view class="utility-card customer-invite-entry" bindtap="openCustomerInviteRequests">
      <view>
        <view class="utility-title">邀请客户查看</view>
        <view class="utility-desc">选择用车需求，生成客户行程/报价查看链接</view>
      </view>
      <view class="chevron">›</view>
    </view>

    <view class="utility-card" bindtap="openHotelRequest">
      <view>
        <view class="utility-title">酒店预订页</view>
        <view class="utility-desc">直接查看客户侧酒店需求界面</view>
      </view>
      <view class="chevron">›</view>
    </view>

    <view class="utility-card customer-preview-entry legacy-entry" bindtap="openCustomerHomePreview">
      <view>
        <view class="utility-title">客户界面预览（辅助）</view>
        <view class="utility-desc">旧版预览入口。常规流程请走「行程管理」逐个行程预览发布；此处用于按用车需求 / 指定客户临时核对。</view>
      </view>
      <view class="chevron">›</view>
    </view>
  </block>

  <button class="floating-add" bindtap="goCreate">+</button>
</view>
