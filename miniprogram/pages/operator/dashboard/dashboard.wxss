.page { min-height: 100vh; padding: 24rpx 24rpx 140rpx; box-sizing: border-box; background: #F5F6FA; }
.header { margin-bottom: 20rpx; }
.title { font-size: 38rpx; font-weight: 700; color: #17315f; }
.state, .summary-card, .utility-card { background: #fff; border-radius: 16rpx; }
.state { padding: 28rpx; color: #6E7788; }
.summary-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-bottom: 18rpx; }
.summary-card { padding: 26rpx 22rpx; position: relative; }
.summary-card::after { content: ''; position: absolute; right: 22rpx; top: 28rpx; width: 12rpx; height: 12rpx; border-top: 3rpx solid #9aa6c6; border-right: 3rpx solid #9aa6c6; transform: rotate(45deg); }
.summary-value { font-size: 46rpx; font-weight: 700; color: #6672A8; }
.summary-label { margin-top: 4rpx; color: #6E7788; font-size: 24rpx; }
.utility-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 26rpx 24rpx; margin-bottom: 16rpx; }
.trip-management-entry,
.customer-invite-entry,
.customer-preview-entry { border: 1rpx solid rgba(102, 114, 168, 0.22); background: #F7F9FF; }
.trip-management-entry { background: #FFFFFF; border-color: rgba(102, 114, 168, 0.34); box-shadow: 0 10rpx 28rpx rgba(102, 114, 168, 0.08); }
.customer-preview-entry { background: #FFFDF7; border-color: rgba(194, 122, 0, 0.20); }
.utility-title { font-size: 30rpx; font-weight: 700; color: #1f3266; }
.utility-desc { margin-top: 8rpx; color: #6E7788; font-size: 24rpx; }
.chevron { color: #9aa6c6; font-size: 48rpx; line-height: 1; }
.floating-add { position: fixed; right: 28rpx; bottom: 36rpx; width: 92rpx; height: 92rpx; line-height: 92rpx; border-radius: 50%; background: #6672A8; color: #fff; font-size: 48rpx; padding: 0; box-shadow: 0 12rpx 24rpx rgba(102, 114, 168, 0.24); }
