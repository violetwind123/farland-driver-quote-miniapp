.page { min-height: 100vh; padding: 24rpx 24rpx 140rpx; box-sizing: border-box; background: #f4f6fb; }
.header { margin-bottom: 20rpx; }
.title { font-size: 38rpx; font-weight: 700; color: #17315f; }
.state, .summary-card, .utility-card { background: #fff; border-radius: 16rpx; }
.state { padding: 28rpx; color: #627392; }
.summary-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-bottom: 18rpx; }
.summary-card { padding: 26rpx 22rpx; position: relative; }
.summary-card::after { content: ''; position: absolute; right: 22rpx; top: 28rpx; width: 12rpx; height: 12rpx; border-top: 3rpx solid #9aa6c6; border-right: 3rpx solid #9aa6c6; transform: rotate(45deg); }
.summary-value { font-size: 46rpx; font-weight: 700; color: #5B6596; }
.summary-label { margin-top: 4rpx; color: #627392; font-size: 24rpx; }
.utility-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 26rpx 24rpx; }
.utility-title { font-size: 30rpx; font-weight: 700; color: #1f3266; }
.utility-desc { margin-top: 8rpx; color: #627392; font-size: 24rpx; }
.chevron { color: #9aa6c6; font-size: 48rpx; line-height: 1; }
.floating-add { position: fixed; right: 28rpx; bottom: 36rpx; width: 92rpx; height: 92rpx; line-height: 92rpx; border-radius: 50%; background: #5B6596; color: #fff; font-size: 48rpx; padding: 0; box-shadow: 0 12rpx 24rpx rgba(91, 101, 150, 0.24); }
