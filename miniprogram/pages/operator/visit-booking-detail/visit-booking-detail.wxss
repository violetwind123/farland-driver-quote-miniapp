@import "/styles/theme.wxss";

/* ============================================================
   R5-5c 运营访校预约详情 · 页面局部布局(.vp-*)
   状态标 / 材料行 / 内部信息区 / 动作栏 / 按钮 / toast
   全部来自 theme.wxss,禁止在此重声明。
   ============================================================ */

.vp-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 加载 / 错误 ---------- */
.vp-state {
  padding: 120rpx 48rpx;
  text-align: center;
  color: var(--ink-400);
  font-size: 24rpx;
}
.vp-state.error { color: var(--danger); }

/* ---------- 头部 ---------- */
.vp-head {
  padding: 32rpx 40rpx 0;
}
.vp-head-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.vp-head-main { flex: 1; min-width: 0; }
.vp-title {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink-900);
  line-height: 1.3;
}
.vp-title-en {
  font-size: 21rpx;
  color: var(--ink-400);
  margin-top: 4rpx;
}
.vp-bigtime {
  font-family: var(--font-serif);
  font-size: 52rpx;
  font-weight: 700;
  color: var(--ink-900);
  margin-top: 16rpx;
  line-height: 1.2;
}
.vp-bigtime-sub {
  font-size: 22rpx;
  color: var(--ink-600);
  margin-top: 4rpx;
}
.vp-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}
.vp-meta-chip {
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
}
.vp-meta-chip.student { background: var(--brand-50); color: var(--brand-600); }
.vp-meta-chip.trip { background: var(--gold-50); color: var(--gold-700); }

/* ---------- 卡片 ---------- */
.vp-card {
  margin: 16rpx 32rpx 0;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}
.vp-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.vp-card-kicker {
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--gold-500);
  font-weight: 700;
  text-transform: uppercase;
}
.vp-card-actions {
  margin-left: auto;
  display: flex;
  gap: 20rpx;
}
.vp-card-action {
  font-size: 20rpx;
  color: var(--brand-600);
  font-weight: 600;
}

/* ---------- 确认信息 ---------- */
.vp-confirm-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.vp-file-thumb {
  width: 68rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--danger-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.vp-file-thumb text {
  font-size: 16rpx;
  font-weight: 800;
  color: var(--danger);
}
.vp-file-main { flex: 1; min-width: 0; }
.vp-file-name {
  font-size: 22rpx;
  color: var(--ink-900);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vp-file-sub {
  font-size: 19rpx;
  color: var(--ink-400);
  margin-top: 4rpx;
}

/* ---------- 集合点 / 到达 ---------- */
.vp-mp-name {
  font-size: 22rpx;
  color: var(--ink-900);
  font-weight: 600;
}
.vp-mp-addr {
  font-size: 21rpx;
  color: var(--ink-600);
  margin-top: 4rpx;
  line-height: 1.5;
}
.vp-map-placeholder {
  margin-top: 14rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #E8EAF2 0%, #DDE1EC 100%);
  position: relative;
  overflow: hidden;
}
.vp-arrival-row {
  display: flex;
  gap: 24rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
  margin-top: 14rpx;
}
.vp-arrival-row:first-of-type { margin-top: 14rpx; }
.vp-arrival-label {
  width: 88rpx;
  font-size: 20rpx;
  color: var(--ink-400);
  flex-shrink: 0;
}
.vp-arrival-value {
  font-size: 22rpx;
  color: var(--ink-900);
  font-weight: 500;
  flex: 1;
  line-height: 1.5;
}
.vp-arrival-value .rain-note {
  color: var(--warn);
  font-weight: 600;
}

/* ---------- 材料清单 ---------- */
.vp-material-due {
  font-size: 18rpx;
  color: var(--warn);
  font-weight: 600;
  margin-left: 8rpx;
}

/* ---------- 内部信息区(.card-internal 提供灰底+虚线) ---------- */
.vp-internal-row {
  display: flex;
  gap: 24rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(27, 35, 64, 0.06);
}
.vp-internal-row.first { border-top: 0; }
.vp-internal-label {
  width: 116rpx;
  font-size: 20rpx;
  color: var(--ink-400);
  flex-shrink: 0;
}
.vp-internal-value {
  font-size: 21rpx;
  color: var(--ink-900);
  line-height: 1.5;
  flex: 1;
}
.vp-timeline-more {
  color: var(--brand-600);
  font-weight: 600;
  margin-top: 8rpx;
  font-size: 20rpx;
}

/* ---------- toast 浮层容器 ---------- */
.vp-toast-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  z-index: 60;
  pointer-events: none;
}
