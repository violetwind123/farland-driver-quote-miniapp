<view class="page">
  <view wx:if="{{loading}}" class="loading-panel">
    <view class="loading-title">正在加载行程</view>
    <view class="loading-sub">读取行程状态与客户可见内容</view>
  </view>

  <block wx:else>
    <!-- 顶部 · 行程状态卡 -->
    <view class="hero">
      <view class="hero-top">
        <view>
          <view class="kicker">行程管理</view>
          <view class="title">{{activeSnapshot && activeSnapshot.display_title ? activeSnapshot.display_title : '行程详情'}}</view>
        </view>
        <button class="icon-btn" loading="{{refreshing}}" bindtap="refreshPreview">刷新</button>
      </view>
      <view class="trip-meta">
        <view class="meta-chip">{{preview.external_trip_id || preview.trip_id || tripId}}</view>
        <view wx:if="{{displayDateRange}}" class="meta-chip">{{displayDateRange}}{{displayDaysCount ? '｜' + displayDaysCount + ' 天' : ''}}</view>
      </view>
      <view wx:if="{{displayCityRoute}}" class="city-route">{{displayCityRoute}}</view>
      <view class="biz-state">
        <view class="biz-row">
          <text class="biz-label">当前状态</text>
          <text class="biz-value">{{bizState.state_text}}</text>
        </view>
        <view class="biz-row">
          <text class="biz-label">客户现在看到</text>
          <text class="biz-value">{{bizState.customer_seeing_text}}</text>
        </view>
        <view class="biz-row">
          <text class="biz-label">下一步</text>
          <text class="biz-value biz-next">{{bizState.next_step_text}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{error}}" class="panel error-panel">
      <view class="section-title">错误</view>
      <view class="error-text">{{error}}</view>
    </view>

    <!-- 模块一 · 手机版行程单 -->
    <view class="panel workflow-panel">
      <view class="section-title">手机版行程单</view>
      <view class="workflow-sub">网页端生成手机行程单图片并同步到小程序后，这里可预览客户真实看到的行程单并微信转发。</view>

      <view wx:if="{{criticalWarningList.length || warningList.length}}" class="workflow-alert">
        <view class="warning-title">同步提醒</view>
        <view wx:for="{{criticalWarningList}}" wx:key="*this" class="warning-row critical">{{item}}</view>
        <view wx:for="{{warningList}}" wx:key="*this" class="warning-row">{{item}}</view>
      </view>
      <view wx:if="{{changedSections.length}}" class="workflow-diff-note">
        最新同步内容与当前客户版本有 {{changedSections.length}} 项差异；请刷新状态并确认客户版已启用最新行程卡片。
      </view>

      <view class="workflow-step-card priority-share-card">
        <view class="workflow-step-head">
          <view class="workflow-step-index priority">1</view>
          <view class="workflow-step-copy">
            <view class="workflow-step-title">手机行程单预览与转发</view>
            <view class="workflow-step-sub">只展示网页生成的手机版行程单图片，不再由小程序重新渲染行程内容。</view>
          </view>
          <view class="workflow-step-status">{{canForwardSheet ? '已生成' : '待网页生成'}}</view>
        </view>
        <view wx:if="{{!canForwardSheet}}" class="share-empty">
          <view class="empty-title">等待网页端生成手机行程单</view>
          <view class="empty-sub">请在网站后台打开该行程，点击「推送客户 Push」生成并同步图片。同步成功后，小程序会在这里直接预览和转发。</view>
          <view class="workflow-btn-row">
            <button class="secondary-wide-btn" disabled="{{true}}">预览手机版行程单</button>
            <button class="primary-wide-btn" disabled="{{true}}">转发客户</button>
          </view>
        </view>
        <block wx:else>
          <view wx:if="{{preview.itinerary_sheet}}" class="sheet-meta">
            <view class="sheet-meta-item">
              <view class="sheet-meta-label">图片版本</view>
              <view class="sheet-meta-value">v{{preview.itinerary_sheet.version || preview.published_version || 1}}</view>
            </view>
            <view class="sheet-meta-item" wx:if="{{preview.itinerary_sheet.width}}">
              <view class="sheet-meta-label">宽度</view>
              <view class="sheet-meta-value">{{preview.itinerary_sheet.width}} px</view>
            </view>
          </view>
          <view class="workflow-btn-row">
            <button
              class="secondary-wide-btn"
              loading="{{previewingDraft}}"
              disabled="{{previewingDraft}}"
              bindtap="previewMobileItineraryDraft"
            >预览手机版行程单</button>
            <button
              class="primary-wide-btn"
              loading="{{creatingInvite}}"
              disabled="{{creatingInvite}}"
              bindtap="createTripInvite"
            >{{invitePath ? '刷新转发卡' : '准备转发客户'}}</button>
          </view>
          <view wx:if="{{invitePath}}" class="invite-box">
            <view class="invite-title">{{inviteReused ? '已复用当前有效分享卡' : '客户转发卡已准备'}}</view>
            <view wx:if="{{inviteExpiresAt}}" class="invite-sub">有效期至 {{inviteExpiresAt}}</view>
            <button class="primary-wide-btn" open-type="share" bindtap="onTripInviteShareTap">转发客户行程</button>
            <button class="secondary-wide-btn" bindtap="openMobileItineraryPreview">预览手机版行程单</button>
          </view>
        </block>
      </view>

    </view>

    <!-- 模块二 · 行程内容核对（运营用） -->
    <view class="panel" id="draft-review">
      <view class="section-toggle-head">
        <view>
          <view class="section-title no-margin">行程内容核对（运营用）</view>
          <view class="snapshot-hint compact-hint">此为运营字段核对视图；客户真实页面只展示网页生成的手机版行程单图片。</view>
        </view>
        <button class="mini-action" disabled="{{!activeSnapshot}}" bindtap="toggleDraftReview">
          {{draftReviewOpen ? '收起核对' : '展开核对'}}
        </button>
      </view>
      <view class="snapshot-tabs">
        <view class="snapshot-tab {{activeSnapshotType === 'draft' ? 'active' : ''}}" data-type="draft" bindtap="selectSnapshot">最新同步版</view>
        <view class="snapshot-tab {{activeSnapshotType === 'published' ? 'active' : ''}}" data-type="published" bindtap="selectSnapshot">当前客户版 v{{preview.published_version || 0}}</view>
      </view>

      <view class="review-summary-grid">
        <view class="review-summary-item">
          <view class="review-summary-label">查看对象</view>
          <view class="review-summary-value">{{activeSnapshotLabel}}</view>
        </view>
        <view class="review-summary-item">
          <view class="review-summary-label">差异</view>
          <view class="review-summary-value">{{changedSections.length || 0}} 项</view>
        </view>
        <view class="review-summary-item">
          <view class="review-summary-label">提醒</view>
          <view class="review-summary-value">{{warningList.length || 0}}</view>
        </view>
      </view>

      <view wx:if="{{!activeSnapshot}}" class="empty-preview">
        <view class="empty-title">暂无客户可见内容</view>
        <view class="empty-sub">等待网页端同步手机版行程单。</view>
      </view>

      <block wx:elif="{{draftReviewOpen}}">
        <view class="review-segments">
          <view class="review-segment {{draftReviewSection === 'overview' ? 'active' : ''}}" data-section="overview" bindtap="selectDraftReviewSection">概览</view>
          <view class="review-segment {{draftReviewSection === 'summary' ? 'active' : ''}}" data-section="summary" bindtap="selectDraftReviewSection">每日摘要</view>
          <view class="review-segment {{draftReviewSection === 'itinerary' ? 'active' : ''}}" data-section="itinerary" bindtap="selectDraftReviewSection">每日行程</view>
          <view class="review-segment {{draftReviewSection === 'hotels' ? 'active' : ''}}" data-section="hotels" bindtap="selectDraftReviewSection">酒店</view>
          <view class="review-segment {{draftReviewSection === 'transport' ? 'active' : ''}}" data-section="transport" bindtap="selectDraftReviewSection">航班/用车</view>
        </view>

        <block wx:if="{{draftReviewSection === 'overview'}}">
          <view class="customer-hero">
            <view class="audit-tag">运营核对</view>
            <view class="customer-kicker">{{activeSnapshot.display_trip_no || 'Farland Trip'}}</view>
            <view class="customer-title">{{activeSnapshot.display_title}}</view>
            <view wx:if="{{displayDateRange}}" class="customer-sub">{{displayDateRange}}</view>
            <view wx:if="{{activeSnapshot.display_city}}" class="customer-sub">{{activeSnapshot.display_city}}</view>
            <view wx:if="{{activeSnapshot.display_customer || activeSnapshot.display_advisor}}" class="customer-note">
              {{activeSnapshot.display_customer || '客户'}} · {{activeSnapshot.display_advisor}}
            </view>
          </view>

          <view wx:if="{{activeSnapshot.trip_summary}}" class="preview-section">
            <view class="preview-title">整体概览</view>
            <view class="info-row overview-row">
              <view class="info-main">{{activeSnapshot.trip_summary.title || activeSnapshot.display_title}}</view>
              <view class="info-sub">{{activeSnapshot.trip_summary.date_range_text || displayDateRange}}</view>
              <view class="info-sub">{{activeSnapshot.trip_summary.city_route_text || activeSnapshot.display_city}}</view>
              <view class="overview-metrics">
                <view class="overview-metric"><view class="overview-number">{{activeSnapshot.trip_summary.days_count || 0}}</view><view class="overview-label">days</view></view>
                <view class="overview-metric"><view class="overview-number">{{activeSnapshot.trip_summary.hotels_count || 0}}</view><view class="overview-label">hotels</view></view>
                <view class="overview-metric"><view class="overview-number">{{activeSnapshot.trip_summary.flights_count || 0}}</view><view class="overview-label">flights</view></view>
                <view class="overview-metric"><view class="overview-number">{{activeSnapshot.trip_summary.transport_count || 0}}</view><view class="overview-label">transport</view></view>
              </view>
              <view wx:if="{{activeSnapshot.trip_summary.next_day_label}}" class="info-sub">{{activeSnapshot.trip_summary.next_day_label}}</view>
            </view>
          </view>
        </block>

        <block wx:elif="{{draftReviewSection === 'summary'}}">
          <view wx:if="{{activeSnapshot.daily_summary_cards.length}}" class="preview-section">
            <view class="preview-title">每日摘要卡</view>
            <view wx:for="{{activeSnapshot.daily_summary_cards}}" wx:key="id" class="day-card summary-card">
              <view class="day-head">
                <view>
                  <view class="day-label">Day {{item.day_no || index + 1}}</view>
                  <view class="day-title">{{item.title || '当日安排'}}</view>
                </view>
                <view class="day-date">{{item.date}} {{item.weekday}}</view>
              </view>
              <view wx:if="{{item.city}}" class="day-summary">{{item.city}}</view>
              <view wx:if="{{item.start_time_text}}" class="service-line">出发：{{item.start_time_text}}</view>
              <view wx:if="{{item.highlight_items.length}}" class="summary-highlights">
                <view wx:for="{{item.highlight_items}}" wx:for-item="highlight" wx:key="*this" class="summary-highlight">{{highlight}}</view>
              </view>
              <view wx:if="{{item.hotel_badge || item.transport_badge}}" class="day-summary">
                {{item.hotel_badge ? '酒店：' + item.hotel_badge : ''}}{{item.hotel_badge && item.transport_badge ? ' · ' : ''}}{{item.transport_badge ? '用车：' + item.transport_badge : ''}}
              </view>
            </view>
          </view>
          <view wx:else class="empty-preview"><view class="empty-sub">暂无每日摘要卡。</view></view>
        </block>

        <block wx:elif="{{draftReviewSection === 'itinerary'}}">
          <view wx:if="{{activeSnapshot.itinerary_days.length}}" class="preview-section">
            <view class="preview-title">每日行程</view>
            <view wx:for="{{activeSnapshot.itinerary_days}}" wx:key="day_no" class="day-card">
              <view class="day-head">
                <view>
                  <view class="day-label">{{item.display_day_label}}</view>
                  <view class="day-title">{{item.title || item.city || '当日安排'}}</view>
                </view>
                <view class="day-date">{{item.date}} {{item.weekday}}</view>
              </view>
              <view wx:if="{{item.summary}}" class="day-summary">{{item.summary}}</view>
              <view wx:if="{{item.estimated_departure_time || item.displayed_start_time}}" class="service-line">
                出发：{{item.estimated_departure_time || item.displayed_start_time}}
              </view>
              <view wx:for="{{item.timeline_items}}" wx:for-item="node" wx:key="item_id" class="timeline-row">
                <view class="timeline-time">{{node.time || node.planned_start_time || node.planned_arrival_time || '--:--'}}</view>
                <view class="timeline-main">
                  <view class="timeline-title">{{node.title || '行程节点'}}</view>
                  <view wx:if="{{node.location_name || node.address}}" class="timeline-sub">{{node.location_name || node.address}}</view>
                  <view wx:if="{{node.drive_time_text || node.distance_text || node.traffic_text}}" class="timeline-sub">
                    {{node.drive_time_text}}{{node.distance_text ? ' · ' + node.distance_text : ''}}{{node.traffic_text ? ' · ' + node.traffic_text : ''}}
                  </view>
                  <view wx:if="{{node.customer_note}}" class="timeline-note">{{node.customer_note}}</view>
                </view>
              </view>
            </view>
          </view>
          <view wx:else class="empty-preview"><view class="empty-sub">暂无每日行程。</view></view>
        </block>

        <block wx:elif="{{draftReviewSection === 'hotels'}}">
          <view wx:if="{{activeSnapshot.hotel_cards.length}}" class="preview-section">
            <view class="preview-title">酒店</view>
            <view wx:for="{{activeSnapshot.hotel_cards}}" wx:key="hotel_id" wx:for-index="hotelIndex" class="info-row">
              <view class="info-main">{{item.name || item.hotel_name || item.title || '酒店安排'}}</view>
              <view class="info-sub">{{item.date_text || item.check_in_date || ''}}</view>
              <view class="info-sub">{{item.address || item.arrival_time || ''}}</view>
              <view class="hotel-share-actions">
                <button
                  class="mini-action"
                  data-hotel-key="{{item.share_key}}"
                  data-hotel-id="{{item.hotel_id || item.id || item.card_id || ''}}"
                  data-hotel-index="{{hotelIndex}}"
                  loading="{{creatingHotelInviteKey === item.share_key}}"
                  disabled="{{creatingHotelInviteKey && creatingHotelInviteKey !== item.share_key}}"
                  bindtap="createHotelInvite"
                >{{hotelInviteMap[item.share_key] ? '刷新酒店分享' : '生成酒店分享'}}</button>
                <button
                  wx:if="{{hotelInviteMap[item.share_key]}}"
                  class="mini-action"
                  open-type="share"
                  data-share-type="hotel"
                  data-hotel-key="{{item.share_key}}"
                  bindtap="onHotelInviteShareTap"
                >微信转发</button>
                <button
                  wx:if="{{hotelInviteMap[item.share_key]}}"
                  class="mini-action"
                  data-hotel-key="{{item.share_key}}"
                  bindtap="copyHotelInvitePath"
                >复制路径</button>
                <button
                  wx:if="{{hotelInviteMap[item.share_key]}}"
                  class="mini-action danger"
                  loading="{{revokingHotelInviteKey === item.share_key}}"
                  disabled="{{revokingHotelInviteKey && revokingHotelInviteKey !== item.share_key}}"
                  data-hotel-key="{{item.share_key}}"
                  bindtap="revokeHotelInvite"
                >撤销分享卡</button>
              </view>
              <view wx:if="{{hotelInviteMap[item.share_key]}}" class="hotel-share-hint">
                {{hotelInviteMap[item.share_key].expires_at ? '有效期至 ' + hotelInviteMap[item.share_key].expires_at : '酒店分享卡已准备'}}
              </view>
            </view>
          </view>
          <view wx:else class="empty-preview"><view class="empty-sub">暂无酒店卡。</view></view>
        </block>

        <block wx:else>
          <view wx:if="{{activeSnapshot.flight_cards.length}}" class="preview-section">
            <view class="preview-title">航班</view>
            <view wx:for="{{activeSnapshot.flight_cards}}" wx:key="flight_id" class="info-row">
              <view class="info-main">{{item.flight_no || item.flight_number || item.title || '航班安排'}}</view>
              <view class="info-sub">{{item.from || item.origin || item.departure_airport || ''}}{{item.to || item.destination || item.arrival_airport ? ' → ' + (item.to || item.destination || item.arrival_airport) : ''}}</view>
              <view class="info-sub">{{item.departure_time || item.depart_at || ''}}{{item.arrival_time || item.arrive_at ? ' - ' + (item.arrival_time || item.arrive_at) : ''}}</view>
              <view wx:if="{{item.aircraft}}" class="info-sub">{{item.aircraft}}</view>
            </view>
          </view>

          <view wx:if="{{activeSnapshot.transfers.length || activeSnapshot.charter_services.length}}" class="preview-section">
            <view class="preview-title">用车</view>
            <view wx:for="{{activeSnapshot.transfers}}" wx:key="transfer_id" class="info-row">
              <view class="info-main">{{item.title || '接送安排'}}</view>
              <view class="info-sub">{{item.pickup || item.origin || ''}}{{item.dropoff || item.destination ? ' → ' + (item.dropoff || item.destination) : ''}}</view>
            </view>
            <view wx:for="{{activeSnapshot.charter_services}}" wx:key="charter_id" class="info-row">
              <view class="info-main">{{item.title || '包车服务'}}</view>
              <view class="info-sub">{{item.date_range_text || item.service_area || item.vehicle_class || ''}}</view>
            </view>
          </view>

          <view wx:if="{{!activeSnapshot.flight_cards.length && !activeSnapshot.transfers.length && !activeSnapshot.charter_services.length}}" class="empty-preview">
            <view class="empty-sub">暂无航班 / 用车卡。</view>
          </view>
        </block>
      </block>
    </view>

    <!-- 模块三 · 每日管理 / 评价卡 -->
    <view wx:if="{{dayCards.length}}" class="panel">
      <view class="section-toggle-head" bindtap="toggleDailyManagement">
        <view>
          <view class="section-title no-margin">每日管理 / 评价卡</view>
          <view class="snapshot-hint compact-hint">{{dayCards.length}} 天 · 生成评价卡、复制路径、查看反馈</view>
        </view>
        <view class="advanced-toggle">{{dailyManagementOpen ? '收起' : '展开'}}</view>
      </view>

      <block wx:if="{{dailyManagementOpen}}">
        <view wx:for="{{dayCards}}" wx:key="day_no" class="op-day-card">
          <view class="day-head">
            <view>
              <view class="day-label">Day {{item.day_no}}</view>
              <view class="day-title">{{item.title}}</view>
            </view>
            <view class="day-right">
              <view class="day-date">{{item.date_text}} {{item.weekday}}</view>
              <view class="status-chip">{{dayStatusText}}</view>
            </view>
          </view>
          <view wx:if="{{item.stops}}" class="day-summary">行程：{{item.stops}}</view>
          <view wx:if="{{item.hotel_name}}" class="day-summary">酒店：{{item.hotel_name}}</view>
          <view wx:if="{{item.transport_badge}}" class="day-summary">用车：{{item.transport_badge}}</view>
          <view wx:if="{{reviewStats[item.day_no]}}" class="day-summary review-line">
            评价：{{reviewStats[item.day_no].count}} 份 · 平均 {{reviewStats[item.day_no].avg_rating}} 星{{reviewStats[item.day_no].low_count ? ' · ' + reviewStats[item.day_no].low_count + ' 份低分需跟进' : ''}}
          </view>
          <view class="day-actions">
            <button class="mini-action" data-day="{{item.day_no}}" bindtap="toggleDayExpand">{{expandedDayNo === item.day_no ? '收起详情' : '查看 Day 详情'}}</button>
            <button
              wx:if="{{!reviewInvites[item.day_no]}}"
              class="mini-action"
              loading="{{creatingReviewDay === item.day_no}}"
              disabled="{{creatingReviewDay !== 0}}"
              data-day="{{item.day_no}}"
              bindtap="createDayReviewInvite"
            >生成 Day {{item.day_no}} 评价卡</button>
            <button
              wx:if="{{reviewInvites[item.day_no]}}"
              class="mini-action"
              data-day="{{item.day_no}}"
              bindtap="copyDayReviewPath"
            >复制评价卡路径</button>
            <button
              wx:if="{{reviewInvites[item.day_no]}}"
              class="mini-action"
              open-type="share"
              data-share-type="review"
              data-day="{{item.day_no}}"
              bindtap="onDayReviewShareTap"
            >转发评价卡</button>
            <button
              wx:if="{{reviewStats[item.day_no] && reviewStats[item.day_no].count}}"
              class="mini-action"
              data-day="{{item.day_no}}"
              bindtap="toggleReviewFeedback"
            >{{reviewExpandedDayNo === item.day_no ? '收起反馈' : '查看反馈（' + reviewStats[item.day_no].count + '）'}}</button>
          </view>
          <view wx:if="{{reviewExpandedDayNo === item.day_no && reviewStats[item.day_no]}}" class="review-feedback">
            <view wx:for="{{reviewStats[item.day_no].recent}}" wx:for-item="review" wx:key="submitted_at" class="review-item {{review.needs_follow_up ? 'low' : ''}}">
              <view class="review-head">
                <text class="review-stars">{{review.rating}} 星</text>
                <text class="review-meta">{{review.openid_display}}</text>
              </view>
              <view wx:if="{{review.tags.length}}" class="review-tags">
                <text wx:for="{{review.tags}}" wx:for-item="tag" wx:key="*this" class="review-tag">{{tag}}</text>
              </view>
              <view wx:if="{{review.text}}" class="review-text">{{review.text}}</view>
            </view>
          </view>
          <view wx:if="{{expandedDayNo === item.day_no}}" class="day-detail">
            <view wx:if="{{item.departure}}" class="service-line">出发：{{item.departure}}</view>
            <view wx:for="{{item.timeline_items}}" wx:for-item="node" wx:key="item_id" class="timeline-row">
              <view class="timeline-time">{{node.time || node.planned_start_time || node.planned_arrival_time || '--:--'}}</view>
              <view class="timeline-main">
                <view class="timeline-title">{{node.title || '行程节点'}}</view>
                <view wx:if="{{node.location_name || node.address}}" class="timeline-sub">{{node.location_name || node.address}}</view>
                <view wx:if="{{node.drive_time_text || node.distance_text || node.traffic_text}}" class="timeline-sub">
                  {{node.drive_time_text}}{{node.distance_text ? ' · ' + node.distance_text : ''}}{{node.traffic_text ? ' · ' + node.traffic_text : ''}}
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="folded-summary">
        <view class="folded-summary-text">每日操作已收起。展开后可按 Day 管理评价卡和反馈。</view>
      </view>
    </view>

    <!-- 模块四 · 高级操作（默认折叠） -->
    <view class="panel advanced-panel">
      <view class="advanced-head" bindtap="toggleAdvanced">
        <view class="section-title no-margin">高级操作</view>
        <view class="advanced-toggle">{{advancedOpen ? '收起' : '展开'}}</view>
      </view>
      <block wx:if="{{advancedOpen}}">
        <view class="advanced-section">
          <view class="ownership-head">
            <view>
              <view class="sub-title no-margin">客户 / 家庭归属</view>
              <view class="ownership-note">仅用于运营归属记录；不会保存到客户账号，也不会创建分享卡。</view>
            </view>
            <button
              wx:if="{{!ownershipEditing}}"
              class="mini-action ownership-edit-btn"
              bindtap="startOwnershipEdit"
            >编辑归属</button>
          </view>

          <block wx:if="{{!ownershipEditing}}">
            <view class="ownership-grid">
              <view class="ownership-cell">
                <view class="ownership-label">家庭名称</view>
                <view class="ownership-value">{{ownership.party_name || '待补充'}}</view>
              </view>
              <view class="ownership-cell">
                <view class="ownership-label">主要客户</view>
                <view class="ownership-value">{{ownership.primary_customer_display_name || '未指定'}}</view>
              </view>
            </view>
            <view class="ownership-row">
              <view class="ownership-label">随行成员 / 旅客</view>
              <view class="ownership-value">{{ownership.traveler_names_display}}</view>
            </view>
          </block>

          <block wx:else>
            <view class="ownership-form">
              <view class="form-label">家庭名称</view>
              <input
                class="ownership-input"
                value="{{ownershipForm.party_name}}"
                placeholder="例如：刘女士家庭"
                maxlength="80"
                bindinput="onOwnershipPartyInput"
              />

              <view class="form-label">主要客户</view>
              <view class="ownership-search-row">
                <input
                  class="ownership-input search"
                  value="{{ownershipSearchKeyword}}"
                  placeholder="搜索客户姓名 / 手机 / 微信"
                  maxlength="80"
                  bindinput="onOwnershipSearchInput"
                />
                <button
                  class="mini-action"
                  loading="{{ownershipSearchLoading}}"
                  disabled="{{ownershipSearchLoading}}"
                  bindtap="searchOwnershipCustomers"
                >搜索</button>
              </view>

              <view wx:if="{{ownershipForm.primary_customer_display_name}}" class="selected-customer">
                <view>
                  <view class="selected-name">{{ownershipForm.primary_customer_display_name}}</view>
                  <view class="selected-sub">{{ownershipForm.primary_customer_user_id}}</view>
                </view>
                <button class="tiny-action" bindtap="clearOwnershipPrimaryCustomer">清除</button>
              </view>

              <view wx:if="{{ownershipSearchResults.length}}" class="customer-result-list">
                <view
                  wx:for="{{ownershipSearchResults}}"
                  wx:key="user_id"
                  data-index="{{index}}"
                  class="customer-result"
                  bindtap="selectOwnershipCustomer"
                >
                  <view>
                    <view class="customer-result-name">{{item.display_name || item.name || 'Farland 客户'}}</view>
                    <view class="customer-result-sub">{{item.phone || item.wechat_id || item.customer_profile_id || item.user_id}}</view>
                  </view>
                  <view class="customer-result-action">选择</view>
                </view>
              </view>

              <view class="form-label">随行成员 / 旅客</view>
              <textarea
                class="ownership-textarea"
                value="{{ownershipForm.traveler_names_text}}"
                placeholder="一行一个姓名，或用逗号分隔；最多 20 人"
                maxlength="800"
                bindinput="onOwnershipTravelerInput"
              />

              <view class="action-row">
                <button class="secondary-btn" disabled="{{ownershipSaving}}" bindtap="cancelOwnershipEdit">取消</button>
                <button
                  class="primary-btn"
                  loading="{{ownershipSaving}}"
                  disabled="{{ownershipSaving}}"
                  bindtap="saveOwnership"
                >保存归属</button>
              </view>
            </view>
          </block>
        </view>

        <view class="advanced-section">
          <view class="sub-title">工具</view>
          <button class="secondary-wide-btn" bindtap="copyTripId">复制 trip_id</button>
        </view>

        <view class="advanced-section">
          <view class="sub-title">技术状态</view>
          <view class="status-grid">
            <view class="status-item">
              <view class="status-label">review</view>
              <view class="status-value">{{preview.review_status || 'pending_review'}}</view>
            </view>
            <view class="status-item">
              <view class="status-label">visibility</view>
              <view class="status-value">{{preview.visibility_status || 'hidden'}}</view>
            </view>
            <view class="status-item">
              <view class="status-label">version</view>
              <view class="status-value">v{{preview.published_version || 0}}</view>
            </view>
          </view>
          <view wx:if="{{rawCriticalWarningCodes.length || rawWarningCodes.length}}" class="tech-codes">
            <view wx:for="{{rawCriticalWarningCodes}}" wx:key="*this" class="tech-code critical">{{item}}</view>
            <view wx:for="{{rawWarningCodes}}" wx:key="*this" class="tech-code">{{item}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="footer-actions">
      <button class="footer-btn" bindtap="backToTripManagement">返回行程管理</button>
    </view>
  </block>
</view>
