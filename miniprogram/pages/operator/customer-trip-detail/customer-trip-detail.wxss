.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 48rpx;
  background: #F5F6FA;
}

.loading-panel,
.hero,
.panel {
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 36, 51, 0.04);
}

.loading-title {
  color: #17315F;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
}

.loading-sub {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.45;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.kicker,
.customer-kicker {
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 8rpx;
  color: #17315F;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
}

.icon-btn {
  flex: 0 0 108rpx;
  margin: 0;
  min-height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: #F2F4F7;
  color: #6672A8;
  font-size: 23rpx;
}

.trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.meta-chip,
.review-pill {
  max-width: 100%;
  box-sizing: border-box;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 600;
}

.state-hint {
  margin-top: 16rpx;
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.55;
}

.section-title {
  color: #1F3266;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.error-panel {
  background: #FFF7F7;
}

.error-text {
  color: #B64747;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.status-item {
  min-height: 104rpx;
  box-sizing: border-box;
  padding: 16rpx 14rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
}

.status-label {
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.25;
}

.status-value {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 700;
  word-break: break-word;
}

.critical-box,
.warning-box,
.changed-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
}

.critical-box {
  background: rgba(196, 64, 64, 0.10);
}

.warning-box {
  background: rgba(194, 122, 0, 0.10);
}

.changed-box {
  background: rgba(102, 114, 168, 0.10);
}

.warning-title {
  color: #253554;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}

.warning-row {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-word;
}

.note-input {
  width: 100%;
  min-height: 132rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx solid #DDE4F3;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.45;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.secondary-btn,
.primary-btn,
.footer-btn,
.primary-wide-btn,
.secondary-wide-btn {
  margin: 0;
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 25rpx;
}

.secondary-btn,
.footer-btn,
.secondary-wide-btn {
  background: #F2F4F7;
  color: #6672A8;
}

.primary-btn,
.primary-wide-btn {
  background: #6672A8;
  color: #FFFFFF;
}

.primary-wide-btn,
.secondary-wide-btn {
  width: 100%;
  margin-top: 18rpx;
}

.share-empty {
  padding: 24rpx 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
}

.share-note {
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.5;
}

.invite-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
}

.invite-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.10);
}

.invite-label {
  flex: 0 0 160rpx;
  color: #7E889A;
  font-size: 22rpx;
  line-height: 1.35;
}

.invite-value {
  flex: 1;
  color: #1D2433;
  font-size: 23rpx;
  line-height: 1.35;
  text-align: right;
  word-break: break-word;
}

.invite-sub {
  margin-top: 10rpx;
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.4;
}

.snapshot-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #F2F4F7;
}

.snapshot-tab {
  min-height: 62rpx;
  line-height: 62rpx;
  border-radius: 14rpx;
  color: #6E7788;
  font-size: 24rpx;
  text-align: center;
}

.snapshot-tab.active {
  background: #FFFFFF;
  color: #6672A8;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(31, 36, 51, 0.06);
}

.empty-preview {
  margin-top: 18rpx;
  padding: 28rpx 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  text-align: center;
}

.empty-title {
  color: #253554;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
}

.empty-sub {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.customer-hero {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #F8FAFF 0%, #FFFFFF 100%);
  border: 1rpx solid #E3E8F4;
}

.customer-title {
  margin-top: 8rpx;
  color: #17315F;
  font-size: 34rpx;
  line-height: 1.28;
  font-weight: 700;
}

.customer-sub,
.customer-note {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.45;
}

.customer-note {
  color: #6672A8;
  font-weight: 600;
}

.preview-section {
  margin-top: 22rpx;
}

.preview-title {
  color: #1F3266;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.day-card,
.info-row {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #F7F9FF;
}

.overview-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 14rpx;
}

.overview-metric {
  padding: 12rpx 8rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  text-align: center;
}

.overview-number {
  color: #6672A8;
  font-size: 29rpx;
  line-height: 1.1;
  font-weight: 760;
}

.overview-label {
  margin-top: 5rpx;
  color: #7E889A;
  font-size: 19rpx;
  line-height: 1.2;
}

.summary-highlights {
  display: grid;
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-highlight {
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #253554;
  font-size: 23rpx;
  line-height: 1.35;
}

.day-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.day-label {
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 700;
}

.day-title,
.info-main {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
}

.day-date {
  flex: 0 0 176rpx;
  color: #7E889A;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
}

.day-summary,
.service-line,
.info-sub {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.timeline-row {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(102, 114, 168, 0.10);
}

.timeline-time {
  color: #6672A8;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 700;
}

.timeline-title {
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 700;
}

.timeline-sub,
.timeline-note {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 22rpx;
  line-height: 1.45;
}

.timeline-note {
  color: #253554;
}

.footer-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

button::after {
  border: none;
}
