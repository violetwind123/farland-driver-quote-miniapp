.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 48rpx;
  background: #F5F6FA;
}

.loading-panel,
.hero,
.panel {
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 36, 51, 0.04);
}

.loading-title {
  color: #17315F;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
}

.loading-sub {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.45;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.kicker,
.customer-kicker {
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 8rpx;
  color: #17315F;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
}

.icon-btn {
  flex: 0 0 108rpx;
  margin: 0;
  min-height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: #F2F4F7;
  color: #6672A8;
  font-size: 23rpx;
}

.trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.meta-chip,
.review-pill {
  max-width: 100%;
  box-sizing: border-box;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 600;
}

.state-hint {
  margin-top: 16rpx;
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.55;
}

.section-title {
  color: #1F3266;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.error-panel {
  background: #FFF7F7;
}

.error-text {
  color: #B64747;
  font-size: 24rpx;
  line-height: 1.5;
}

.ownership-panel {
  background: #FFFFFF;
}

.ownership-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.ownership-note {
  margin-top: 6rpx;
  color: #7E889A;
  font-size: 22rpx;
  line-height: 1.45;
}

.ownership-edit-btn {
  margin-top: 2rpx;
}

.ownership-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.ownership-cell,
.ownership-row {
  box-sizing: border-box;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #F7F9FF;
  border: 1rpx solid rgba(102, 114, 168, 0.10);
}

.ownership-row {
  margin-top: 12rpx;
}

.ownership-label,
.form-label {
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.3;
}

.ownership-value {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 700;
  word-break: break-word;
}

.ownership-form {
  margin-top: 18rpx;
}

.form-label {
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.form-label:first-child {
  margin-top: 0;
}

.ownership-input,
.ownership-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx solid #DDE4F3;
  color: #1D2433;
  font-size: 24rpx;
}

.ownership-input {
  min-height: 72rpx;
  line-height: 72rpx;
}

.ownership-search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
}

.selected-customer,
.customer-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.selected-customer {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(102, 114, 168, 0.10);
}

.selected-name,
.customer-result-name {
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}

.selected-sub,
.customer-result-sub {
  margin-top: 4rpx;
  color: #7E889A;
  font-size: 20rpx;
  line-height: 1.35;
  word-break: break-all;
}

.tiny-action {
  flex: 0 0 auto;
  margin: 0;
  min-height: 48rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.26);
  color: #6672A8;
  font-size: 20rpx;
}

.customer-result-list {
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 18rpx;
  border: 1rpx solid rgba(102, 114, 168, 0.12);
  background: #FFFFFF;
}

.customer-result {
  padding: 16rpx;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.10);
}

.customer-result:last-child {
  border-bottom: 0;
}

.customer-result-action {
  flex: 0 0 auto;
  color: #6672A8;
  font-size: 22rpx;
  font-weight: 700;
}

.ownership-textarea {
  min-height: 150rpx;
  padding-top: 16rpx;
  line-height: 1.45;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.status-item {
  min-height: 104rpx;
  box-sizing: border-box;
  padding: 16rpx 14rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
}

.status-label {
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.25;
}

.status-value {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 700;
  word-break: break-word;
}

.critical-box,
.warning-box,
.changed-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
}

.critical-box {
  background: rgba(196, 64, 64, 0.10);
}

.warning-box {
  background: rgba(194, 122, 0, 0.10);
}

.changed-box {
  background: rgba(102, 114, 168, 0.10);
}

.warning-title {
  color: #253554;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}

.warning-row {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-word;
}

.warning-row.critical {
  color: #B64747;
  font-weight: 650;
}

.note-input {
  width: 100%;
  min-height: 132rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx solid #DDE4F3;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.45;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.secondary-btn,
.primary-btn,
.footer-btn,
.primary-wide-btn,
.secondary-wide-btn {
  margin: 0;
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 25rpx;
}

.secondary-btn,
.footer-btn,
.secondary-wide-btn {
  background: #F2F4F7;
  color: #6672A8;
}

.primary-btn,
.primary-wide-btn {
  background: #6672A8;
  color: #FFFFFF;
}

.primary-btn.danger {
  background: #B94747;
}

.primary-wide-btn,
.secondary-wide-btn {
  width: 100%;
  margin-top: 18rpx;
}

.compact {
  margin-top: 14rpx;
}

.share-empty {
  padding: 24rpx 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
}

.share-note {
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.5;
}

.invite-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
}

.invite-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(102, 114, 168, 0.10);
}

.invite-label {
  flex: 0 0 160rpx;
  color: #7E889A;
  font-size: 22rpx;
  line-height: 1.35;
}

.invite-value {
  flex: 1;
  color: #1D2433;
  font-size: 23rpx;
  line-height: 1.35;
  text-align: right;
  word-break: break-word;
}

.invite-sub {
  margin-top: 10rpx;
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.4;
}

.customer-view-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 6rpx;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: #EEF1FB;
  border: 1rpx solid rgba(102, 114, 168, 0.22);
}

.cta-copy {
  flex: 1;
  min-width: 0;
}

.cta-title {
  color: #1F3266;
  font-size: 27rpx;
  font-weight: 700;
}

.cta-sub {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 22rpx;
  line-height: 1.45;
}

.cta-btn {
  flex: 0 0 auto;
  margin: 0;
  min-width: 132rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 650;
}

.cta-btn::after {
  border: none;
}

.snapshot-hint {
  margin: 18rpx 0 12rpx;
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.4;
}

.section-toggle-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.compact-hint {
  margin: 6rpx 0 0;
}

.snapshot-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #F2F4F7;
}

.snapshot-tab {
  min-height: 62rpx;
  line-height: 62rpx;
  border-radius: 14rpx;
  color: #6E7788;
  font-size: 24rpx;
  text-align: center;
}

.snapshot-tab.active {
  background: #FFFFFF;
  color: #6672A8;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(31, 36, 51, 0.06);
}

.review-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.review-summary-item {
  min-height: 86rpx;
  box-sizing: border-box;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  background: #F7F9FF;
  border: 1rpx solid rgba(102, 114, 168, 0.10);
}

.review-summary-label {
  color: #7E889A;
  font-size: 20rpx;
  line-height: 1.25;
}

.review-summary-value {
  margin-top: 7rpx;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
}

.review-segments {
  display: flex;
  gap: 8rpx;
  margin-top: 18rpx;
  overflow-x: auto;
  padding-bottom: 2rpx;
}

.review-segment {
  flex: 0 0 auto;
  min-width: 112rpx;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #F2F4F7;
  color: #6E7788;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
  font-weight: 600;
}

.review-segment.active {
  background: #6672A8;
  color: #FFFFFF;
}

.folded-summary {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx dashed rgba(102, 114, 168, 0.18);
}

.folded-summary-text {
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.empty-preview {
  margin-top: 18rpx;
  padding: 28rpx 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  text-align: center;
}

.empty-title {
  color: #253554;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
}

.empty-sub {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.customer-hero {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #F8FAFF 0%, #FFFFFF 100%);
  border: 1rpx solid #E3E8F4;
}

.customer-title {
  margin-top: 8rpx;
  color: #17315F;
  font-size: 34rpx;
  line-height: 1.28;
  font-weight: 700;
}

.customer-sub,
.customer-note {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 24rpx;
  line-height: 1.45;
}

.customer-note {
  color: #6672A8;
  font-weight: 600;
}

.preview-section {
  margin-top: 22rpx;
}

.preview-title {
  color: #1F3266;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.day-card,
.info-row {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #F7F9FF;
}

.overview-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 14rpx;
}

.overview-metric {
  padding: 12rpx 8rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  text-align: center;
}

.overview-number {
  color: #6672A8;
  font-size: 29rpx;
  line-height: 1.1;
  font-weight: 760;
}

.overview-label {
  margin-top: 5rpx;
  color: #7E889A;
  font-size: 19rpx;
  line-height: 1.2;
}

.summary-highlights {
  display: grid;
  gap: 8rpx;
  margin-top: 12rpx;
}

.summary-highlight {
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #253554;
  font-size: 23rpx;
  line-height: 1.35;
}

.day-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.day-label {
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 700;
}

.day-title,
.info-main {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
}

.day-date {
  flex: 0 0 176rpx;
  color: #7E889A;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
}

.day-summary,
.service-line,
.info-sub {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.timeline-row {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(102, 114, 168, 0.10);
}

.timeline-time {
  color: #6672A8;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 700;
}

.timeline-title {
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 700;
}

.timeline-sub,
.timeline-note {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 22rpx;
  line-height: 1.45;
}

.timeline-note {
  color: #253554;
}

.footer-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

/* ===== 运营信息架构重构(状态卡 / 发布流程 / 每日管理 / 高级操作) ===== */

.city-route {
  margin-top: 12rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.biz-state {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx solid rgba(102, 114, 168, 0.14);
}

.biz-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 0;
}

.biz-label {
  flex: 0 0 168rpx;
  color: #7E889A;
  font-size: 23rpx;
  line-height: 1.4;
}

.biz-value {
  flex: 1;
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 600;
}

.biz-next {
  color: #6672A8;
  font-weight: 700;
}

.sub-title {
  color: #1F3266;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.share-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(102, 114, 168, 0.12);
}

.workflow-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.workflow-sub {
  margin-top: -6rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.workflow-alert,
.workflow-diff-note {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 1.45;
}

.workflow-alert {
  background: rgba(194, 122, 0, 0.10);
}

.workflow-diff-note {
  color: #6672A8;
  background: rgba(102, 114, 168, 0.10);
}

.workflow-step-card {
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  background: #F7F9FF;
  border: 1rpx solid rgba(102, 114, 168, 0.12);
}

.priority-share-card {
  background: #FFFFFF;
  border-color: rgba(102, 114, 168, 0.30);
  box-shadow: 0 8rpx 22rpx rgba(31, 36, 51, 0.05);
}

.workflow-step-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.workflow-step-index {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 999rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.workflow-step-index.priority {
  background: #344C98;
}

.workflow-step-copy {
  flex: 1;
  min-width: 0;
}

.workflow-step-title {
  color: #1F3266;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.workflow-step-sub {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 22rpx;
  line-height: 1.45;
}

.workflow-step-status {
  flex: 0 0 auto;
  max-width: 150rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6672A8;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 650;
  text-align: center;
}

.workflow-step-card > .primary-wide-btn,
.workflow-step-card > .secondary-wide-btn,
.workflow-step-card > .note-input,
.workflow-step-card > .share-empty,
.workflow-step-card > .share-note,
.workflow-step-card > .invite-box,
.workflow-step-card > .action-row {
  margin-top: 16rpx;
}

.sub-title.no-margin {
  margin-bottom: 0;
}

.op-day-card {
  margin-bottom: 16rpx;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx solid rgba(102, 114, 168, 0.12);
}

.day-right {
  text-align: right;
}

.status-chip {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.12);
  color: #6672A8;
  font-size: 20rpx;
  font-weight: 600;
}

.day-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.hotel-share-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.hotel-share-hint {
  margin-top: 10rpx;
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.4;
  word-break: break-word;
}

.mini-action {
  flex: 0 0 auto;
  margin: 0;
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.26);
  color: #6672A8;
  font-size: 21rpx;
}

.mini-action.placeholder {
  opacity: 0.5;
  border-style: dashed;
}

.mini-action.danger {
  color: #C4443A;
  border-color: rgba(196, 68, 58, 0.35);
}

.day-detail {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(102, 114, 168, 0.18);
}

.advanced-panel {
  background: #FAFBFD;
}

.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title.no-margin {
  margin-bottom: 0;
}

.advanced-toggle {
  color: #6672A8;
  font-size: 24rpx;
  font-weight: 600;
}

.advanced-section {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(102, 114, 168, 0.10);
}

.tech-codes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.tech-code {
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #F2F4F7;
  color: #6E7788;
  font-size: 20rpx;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.tech-code.critical {
  background: rgba(196, 64, 64, 0.10);
  color: #B64747;
}

.review-line {
  color: #6672A8;
  font-weight: 600;
}

.review-feedback {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(102, 114, 168, 0.18);
}

.review-item {
  margin-bottom: 12rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.12);
}

.review-item.low {
  border-color: rgba(196, 64, 64, 0.30);
  background: rgba(196, 64, 64, 0.04);
}

.review-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.review-stars {
  color: #F5A623;
  font-size: 23rpx;
  font-weight: 700;
}

.review-meta {
  color: #8A91A1;
  font-size: 20rpx;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.review-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #F2F4F7;
  color: #6672A8;
  font-size: 20rpx;
}

.review-text {
  margin-top: 8rpx;
  color: #4A5468;
  font-size: 22rpx;
  line-height: 1.5;
}

.audit-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(194, 122, 0, 0.12);
  color: #9A6B00;
  font-size: 20rpx;
  font-weight: 600;
}

button::after {
  border: none;
}
