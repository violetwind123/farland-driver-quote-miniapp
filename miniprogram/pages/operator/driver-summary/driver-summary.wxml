<view class="page">
  <view wx:if="{{loading}}" class="state">加载中...</view>

  <block wx:else>
    <view wx:if="{{!driverRegionSummary.length}}" class="state">暂无司机资料</view>
    <view wx:for="{{driverRegionSummary}}" wx:key="region" class="region-card" data-region="{{item.region}}" bindtap="openRegion">
      <view class="region-head">
        <text class="region-name">{{item.region}}</text>
        <text class="region-count">{{item.driver_count}} 位司机</text>
      </view>
      <view class="region-meta">车辆 {{item.vehicle_count}}</view>
      <view class="vehicle-types">
        <text wx:if="{{item.vehicle_type_counts.suv}}">SUV {{item.vehicle_type_counts.suv}}</text>
        <text wx:if="{{item.vehicle_type_counts.suburban}}">Suburban {{item.vehicle_type_counts.suburban}}</text>
        <text wx:if="{{item.vehicle_type_counts.van}}">Van {{item.vehicle_type_counts.van}}</text>
        <text wx:if="{{item.vehicle_type_counts.sprinter}}">Sprinter {{item.vehicle_type_counts.sprinter}}</text>
        <text wx:if="{{item.vehicle_type_counts.transit}}">Transit {{item.vehicle_type_counts.transit}}</text>
        <text wx:if="{{item.vehicle_type_counts.bus}}">Bus {{item.vehicle_type_counts.bus}}</text>
        <text wx:if="{{item.vehicle_type_counts.other}}">Other {{item.vehicle_type_counts.other}}</text>
      </view>
    </view>
  </block>
</view>
