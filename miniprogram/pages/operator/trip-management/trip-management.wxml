<view class="page">
  <view class="hero">
    <view>
      <view class="kicker">TRIP OPS</view>
      <view class="title">行程管理</view>
      <view class="desc">审核、发布客户行程，并发送每日评价卡。行程由网页端创建。</view>
    </view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索 Trip ID / 客户 / 城市"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
      />
      <button wx:if="{{keyword}}" class="clear-btn" bindtap="clearKeyword">×</button>
    </view>
    <button class="search-btn" loading="{{refreshing}}" bindtap="onSearchConfirm">搜索</button>
  </view>

  <scroll-view class="filter-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{statusFilters}}"
        wx:key="key"
        class="filter-chip {{statusFilter === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="changeStatusFilter"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state-card">加载中...</view>
  <view wx:elif="{{error}}" class="state-card error-state">
    <view>{{error}}</view>
    <button class="retry-btn" bindtap="loadTrips">重试</button>
  </view>
  <view wx:elif="{{!trips.length}}" class="state-card empty-state">
    <view class="empty-title">暂无行程</view>
    <view class="empty-desc">行程由网页端创建后会显示在这里。</view>
    <button class="retry-btn" bindtap="loadTrips">刷新</button>
  </view>

  <view wx:else class="trip-list">
    <view
      wx:for="{{trips}}"
      wx:key="trip_id"
      class="trip-card"
      data-trip-id="{{item.trip_id}}"
      bindtap="openTripDetail"
      hover-class="trip-card-hover"
    >
      <view class="trip-card-head">
        <view class="trip-main">
          <view class="trip-title">{{item.displayTitle}}</view>
          <view class="trip-meta">{{item.displayTripNo}} · {{item.displayDateRange}}</view>
        </view>
        <view class="rank-pill">#{{item.priority_rank}}</view>
      </view>

      <view class="party-line">{{item.displayParty}}</view>

      <view class="badge-row">
        <view class="status-badge {{item.visibilityClass}}">{{item.visibilityStatusText}}</view>
        <view class="status-badge {{item.reviewClass}}">{{item.reviewStatusText}}</view>
        <view class="status-badge muted">{{item.versionText}}</view>
      </view>

      <view class="metric-row">
        <view class="metric-item">
          <view class="metric-value">{{item.dayCountText}}</view>
          <view class="metric-label">行程天数</view>
        </view>
        <view class="metric-item">
          <view class="metric-value">{{item.accessCountText}}</view>
          <view class="metric-label">已保存人数</view>
        </view>
      </view>

      <view class="trip-foot">
        <view class="state-hint">{{item.stateHint}}</view>
        <view class="updated-at">更新 {{item.latestUpdatedText}}</view>
      </view>
    </view>
  </view>
</view>
