<view class="page">
  <view wx:if="{{loading}}" class="panel">加载中...</view>
  <block wx:else>
    <view class="command-card">
      <view class="command-top">
        <view>
          <view class="command-kicker">运营决策</view>
          <view class="command-title">{{request.request_no}}</view>
        </view>
        <view class="status-pill {{statusClass}}">{{statusText}}</view>
      </view>
      <view class="command-grid">
        <view class="command-metric">
          <view class="metric-value">{{quoteCount}}</view>
          <view class="metric-label">司机报价</view>
        </view>
        <view class="command-metric">
          <view class="metric-value">{{invites.length}}</view>
          <view class="metric-label">邀请记录</view>
        </view>
        <view class="command-metric wide">
          <view class="metric-value small">{{request.quote_deadline || '-'}}</view>
          <view class="metric-label">报价截止</view>
        </view>
      </view>
      <view wx:if="{{deadlineRiskText}}" class="risk-banner">{{deadlineRiskText}}</view>
      <view class="next-action">{{nextActionText}}</view>
      <view wx:if="{{selectedQuote}}" class="selected-summary">
        已选择：{{selectedQuote.driver_name_snapshot}} · {{selectedQuote.vehicle_model_snapshot}} · {{selectedQuote.currency}} {{selectedQuote.quote_price}}
      </view>
    </view>

    <view class="panel">
      <view class="title">报价单信息</view>
      <view class="field">状态：<text class="status-pill inline {{statusClass}}">{{statusText}}</text></view>
      <view class="field">类型：{{request.service_type === 'transfer' ? '接送 / 转场' : '包车 / 多日用车'}}</view>
      <view class="field">服务日期：{{request.service_date}}</view>
      <view class="field">发布司机区域：{{request.driver_region}}</view>
      <view class="field">截止：{{request.quote_deadline}}</view>
    </view>

    <view wx:if="{{request.status === 'cancelled'}}" class="panel cancelled-panel">
      <view class="section-title">已取消</view>
      <view class="field">取消原因：{{request.cancel_reason_type_text}}</view>
      <view class="content">司机可见说明：{{request.cancel_reason_driver || '-'}}</view>
      <view class="content">内部备注：{{request.cancel_reason_internal || '-'}}</view>
      <view class="muted">取消时间：{{request.cancelled_at || '-'}}</view>
    </view>

    <view class="panel">
      <view class="section-title">任务描述</view>
      <view class="content">{{request.task_description}}</view>
    </view>

    <view class="panel">
      <view class="section-title">内部备注</view>
      <view class="content">{{request.internal_note || '无'}}</view>
    </view>

    <view wx:if="{{request.status !== 'cancelled' && request.status !== 'completed'}}" class="panel">
      <view class="section-title">转发入口</view>
      <view wx:if="{{inviteError}}" class="error-text">{{inviteError}}</view>
      <button wx:if="{{inviteError}}" class="submit-btn" bindtap="onRetryCreateInvite">重试生成报价邀请</button>
      <view wx:if="{{customerInviteError}}" class="error-text">{{customerInviteError}}</view>
      <view class="share-grid">
        <button
          wx:if="{{token}}"
          open-type="share"
          class="share-btn driver-share-btn"
          bindtap="onDriverShareTap"
        >转发司机报价</button>
        <button
          wx:else
          class="share-btn driver-share-btn disabled"
          disabled="true"
        >司机报价准备中</button>
        <button
          class="share-btn customer-share-primary"
          loading="{{creatingCustomerInvite}}"
          disabled="{{creatingCustomerInvite || !customerInvitePath}}"
          open-type="share"
          bindtap="onCustomerShareTap"
        >{{creatingCustomerInvite || !customerInvitePath ? '客户邀请准备中' : '转发客户'}}</button>
      </view>
      <button class="customer-preview-btn" bindtap="previewCustomerHome">预览客户主页</button>
    </view>

    <view class="panel">
      <view class="section-title">司机报价</view>
      <view class="quote-toolbar">
        <button class="summary-btn" bindtap="copyQuoteSummary">复制报价汇总</button>
        <button class="refresh-btn" loading="{{refreshingDetail}}" bindtap="refreshDetail">{{refreshingDetail ? '刷新中' : '刷新状态'}}</button>
      </view>
      <view wx:if="{{!quotes.length}}" class="empty">暂无报价</view>
      <view wx:for="{{quotes}}" wx:key="_id" class="list-item">
        <view class="quote-head">
          <view>{{item.driver_name_snapshot}} · {{item.driver_phone_snapshot}}</view>
          <view class="status-pill inline {{item.quote_status === 'selected' ? 'status-assigned' : (item.quote_status === 'rejected' ? 'status-cancelled' : 'status-quoting')}}">{{item.quote_status === 'selected' ? '已选择' : (item.quote_status === 'rejected' ? '未选中' : (item.quote_status === 'updated' ? '已更新' : '已提交'))}}</view>
        </view>
        <view class="muted">{{item.vehicle_type_snapshot}} · {{item.vehicle_model_snapshot}} · {{item.seats_snapshot}} 座 · 行李 {{item.luggage_capacity_snapshot}}</view>
        <view class="note">{{item.quote_price}} {{item.currency}} · {{item.quote_note || '无备注'}}</view>
        <view class="muted">{{item.updated_at}}</view>
        <view class="review-row">
          <view wx:if="{{item.operator_review_status === 'approved'}}" class="review-chip approved">已审核通过{{item.latest_customer_quote_id ? ' · 已生成客户报价' : ''}}</view>
          <view wx:elif="{{item.operator_review_status === 'rejected'}}" class="review-chip rejected">运营未采纳</view>
          <view wx:else class="review-chip pending">待运营审核</view>
          <view wx:if="{{item.customer_selected}}" class="review-chip customer-selected">客户已选择</view>
        </view>
        <view
          wx:if="{{item.operator_review_status !== 'approved' && item.operator_review_status !== 'rejected' && item.quote_status !== 'selected' && item.quote_status !== 'rejected' && request.status !== 'assigned' && request.status !== 'cancelled'}}"
          class="quote-action-row"
        >
          <button
            class="reject-btn"
            loading="{{reviewingQuoteId === item._id && !publishingCustomerQuotes}}"
            data-id="{{item._id}}"
            bindtap="rejectDriverQuote"
          >
            <view>拒绝报价</view>
            <view class="action-hint">不通知司机</view>
          </button>
          <button
            class="publish-btn"
            loading="{{reviewingQuoteId === item._id && publishingCustomerQuotes}}"
            data-id="{{item._id}}"
            bindtap="approveAndPublishQuote"
          >
            <view>报送客户</view>
            <view class="action-hint light">发布客户报价</view>
          </button>
          <button
            class="select-btn inline"
            loading="{{selectingQuoteId === item._id}}"
            data-id="{{item._id}}"
            bindtap="selectQuote"
          >
            <view>选择司机</view>
            <view class="action-hint light">正式分配</view>
          </button>
        </view>
        <view
          wx:elif="{{item.customer_selected && item.operator_review_status === 'approved' && item.quote_status !== 'selected' && item.quote_status !== 'rejected' && request.status !== 'assigned' && request.status !== 'cancelled'}}"
          class="quote-action-row approved-actions"
        >
          <button
            class="driver-decline-btn"
            loading="{{reviewingQuoteId === item._id}}"
            data-id="{{item._id}}"
            bindtap="rejectDriverQuote"
          >
            <view>司机拒绝</view>
            <view class="action-hint danger">客户需重选</view>
          </button>
          <button
            class="select-btn inline"
            loading="{{selectingQuoteId === item._id}}"
            data-id="{{item._id}}"
            bindtap="selectQuote"
          >
            <view>确认司机</view>
            <view class="action-hint light">客户可见联系方式</view>
          </button>
        </view>
        <view
          wx:elif="{{item.operator_review_status === 'approved' && item.quote_status !== 'selected' && item.quote_status !== 'rejected' && request.status !== 'assigned' && request.status !== 'cancelled'}}"
          class="customer-waiting-row"
        >
          <view class="action-placeholder">已报送客户，等待客户选择</view>
        </view>
      </view>
    </view>

    <view wx:if="{{request.status !== 'cancelled' && request.status !== 'completed'}}" class="bottom-danger-panel">
      <button class="cancel-order-btn" bindtap="openCancelForm">取消订单</button>
    </view>

    <view wx:if="{{showCancelForm}}" class="panel cancel-form">
      <view class="section-title">取消原因</view>
      <view class="input-row">
        <text>原因类型</text>
        <picker range="{{cancelReasonTypes}}" range-key="label" value="{{cancelReasonIndex}}" bindchange="onCancelReasonChange">
          <view class="picker-value">{{cancelReasonIndex >= 0 ? cancelReasonTypes[cancelReasonIndex].label : '请选择取消原因'}}</view>
        </picker>
      </view>
      <view class="input-row">
        <text>司机可见说明</text>
        <textarea value="{{cancelReasonDriver}}" data-field="cancelReasonDriver" bindinput="onCancelInput" placeholder="客户行程调整，本次报价取消。后续如需重新报价，Farland 会另行通知。" />
      </view>
      <view class="input-row">
        <text>内部备注</text>
        <textarea value="{{cancelReasonInternal}}" data-field="cancelReasonInternal" bindinput="onCancelInput" placeholder="仅运营可见，例如客户改日期、原单作废、后续重发。" />
      </view>
      <view class="button-row">
        <button class="secondary-btn" bindtap="closeCancelForm">返回</button>
        <button class="cancel-btn" loading="{{cancelling}}" bindtap="submitCancelRequest">{{cancelling ? '取消中...' : '确认取消'}}</button>
      </view>
    </view>
  </block>
</view>
