.page { padding: 24rpx; background: #F5F6FA; min-height: 100vh; box-sizing: border-box; }
.panel { background: #fff; border-radius: 24rpx; padding: 24rpx; margin-bottom: 18rpx; box-shadow: 0 8rpx 24rpx rgba(31, 36, 51, 0.04); }
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; }
.field { color: #4f6385; margin-bottom: 8rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.content { color: #253554; line-height: 1.7; white-space: pre-wrap; }
.submit-btn { background: #6672A8; color: #fff; border-radius: 44rpx; }
.share-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 16rpx; }
.share-grid.single { grid-template-columns: 1fr; }
.share-btn { margin: 0; color: #fff; border-radius: 44rpx; font-size: 27rpx; }
.driver-share-btn { background: #4B5565; }
.driver-share-btn.disabled { background: #C9CED8; color: #fff; }
.customer-share-primary { margin: 0; height: 82rpx; line-height: 82rpx; background: #6672A8; color: #fff; font-size: 28rpx; }
.customer-share-primary::after { border: none; }
.share-status { margin-top: 12rpx; color: #8A91A1; font-size: 22rpx; line-height: 1.4; text-align: center; }
.customer-preview-btn { margin-top: 14rpx; height: 76rpx; line-height: 76rpx; border-radius: 38rpx; background: #F2F4F7; color: #6672A8; font-size: 26rpx; }
.customer-preview-btn::after { border: none; }
.customer-owner-card, .customer-owner-empty { display: flex; justify-content: space-between; gap: 18rpx; align-items: center; padding: 20rpx; border-radius: 18rpx; background: #F7F9FF; }
.customer-owner-name { color: #1E2635; font-size: 28rpx; font-weight: 600; }
.customer-owner-meta { margin-top: 6rpx; color: #6E7788; font-size: 23rpx; line-height: 1.4; }
.customer-owner-actions { display: flex; flex-direction: column; gap: 10rpx; min-width: 180rpx; }
.customer-assign-open { margin: 0; min-width: 190rpx; height: 68rpx; line-height: 68rpx; border-radius: 34rpx; background: #6672A8; color: #fff; font-size: 24rpx; }
.customer-assign-open::after { border: none; }
.customer-secondary-btn { margin: 0; height: 62rpx; line-height: 62rpx; border-radius: 31rpx; background: #EEF1F8; color: #6672A8; font-size: 23rpx; }
.customer-secondary-btn::after { border: none; }
.customer-assign-panel { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #EDF1F7; }
.customer-search-row { display: grid; grid-template-columns: 1fr 132rpx; gap: 12rpx; align-items: center; }
.customer-search-input { height: 72rpx; box-sizing: border-box; padding: 0 20rpx; border-radius: 18rpx; background: #F7F9FF; color: #1E2635; font-size: 25rpx; }
.customer-search-btn { margin: 0; height: 72rpx; line-height: 72rpx; border-radius: 36rpx; background: #6672A8; color: #fff; font-size: 24rpx; }
.customer-search-btn::after { border: none; }
.customer-result-list { margin-top: 14rpx; border-radius: 18rpx; overflow: hidden; border: 1rpx solid #EDF1F7; }
.customer-result-item { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 18rpx; background: #fff; border-bottom: 1rpx solid #EDF1F7; }
.customer-result-item:last-child { border-bottom: 0; }
.customer-result-item.selected { background: rgba(102, 114, 168, 0.10); }
.customer-result-name { color: #1E2635; font-size: 26rpx; font-weight: 600; }
.customer-result-meta, .customer-result-empty { color: #7E889A; font-size: 23rpx; line-height: 1.4; }
.customer-result-empty { margin-top: 14rpx; padding: 18rpx; border-radius: 18rpx; background: #F7F9FF; }
.customer-selected-mark { flex-shrink: 0; color: #6672A8; font-size: 23rpx; font-weight: 600; }
.customer-assignment-note { margin-top: 14rpx; width: 100%; min-height: 96rpx; box-sizing: border-box; padding: 16rpx 18rpx; border-radius: 18rpx; background: #F7F9FF; color: #1E2635; font-size: 25rpx; }
.customer-assign-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 14rpx; }
.customer-confirm-btn { margin: 0; height: 68rpx; line-height: 68rpx; border-radius: 34rpx; background: #6672A8; color: #fff; font-size: 24rpx; }
.customer-confirm-btn::after { border: none; }
.cancelled-panel { background: #f7f9ff; }
.cancel-btn { margin-top: 16rpx; background: #6672A8; color: #fff; border-radius: 44rpx; }
.bottom-danger-panel { margin: 8rpx 0 22rpx; }
.cancel-order-btn { margin: 0; height: 88rpx; line-height: 88rpx; border-radius: 999rpx; background: #D94A4A; color: #fff; font-size: 30rpx; font-weight: 600; box-shadow: 0 8rpx 18rpx rgba(217, 74, 74, 0.14); }
.cancel-order-btn::after { border: none; }
.secondary-btn { margin-top: 16rpx; background: #f2f4f7; color: #6672A8; border-radius: 44rpx; }
.input-row { margin-bottom: 18rpx; }
.input-row text { display: block; color: #6E7788; font-size: 24rpx; margin-bottom: 10rpx; }
.picker-value, textarea { width: 100%; box-sizing: border-box; background: #f7f9ff; border: 1rpx solid #d8e1f5; border-radius: 12rpx; padding: 18rpx; font-size: 28rpx; color: #1E2635; }
textarea { min-height: 130rpx; }
.button-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.list-item { padding: 16rpx 0; border-top: 1rpx solid #edf1f7; }
.list-item:first-of-type { border-top: 0; }
.note { color: #253554; margin-top: 8rpx; line-height: 1.5; }
.muted, .empty { color: #6E7788; font-size: 24rpx; margin-top: 6rpx; }
.error-text { color: #6672A8; font-size: 24rpx; margin-top: 8rpx; }
.select-btn {
  margin: 14rpx 0 0;
  background: #0F9F4A;
  color: #fff;
  border-radius: 36rpx;
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(15, 159, 74, 0.28);
}
.select-btn.inline { margin: 0; }
.quote-action-row { display: grid; grid-template-columns: 1fr 1.35fr 1fr; gap: 10rpx; margin-top: 14rpx; align-items: center; }
.quote-action-row.approved-actions { grid-template-columns: 1fr 1fr; }
.customer-waiting-row { margin-top: 14rpx; }
.quote-action-row button { min-height: 72rpx; line-height: 1.2; padding: 10rpx 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.quote-action-row button::after { border: none; }
.reject-btn { margin: 0; background: rgba(217, 74, 74, 0.10); color: #B64747; border-radius: 36rpx; font-size: 24rpx; }
.driver-decline-btn { margin: 0; background: #D94A4A; color: #fff; border-radius: 36rpx; font-size: 24rpx; }
.publish-btn { margin: 0; background: #6672A8; color: #fff; border-radius: 36rpx; font-size: 24rpx; }
.action-hint { margin-top: 2rpx; color: #8A91A1; font-size: 18rpx; line-height: 1.2; font-weight: 400; }
.action-hint.light { color: rgba(255, 255, 255, 0.80); }
.action-hint.danger { color: rgba(255, 255, 255, 0.78); }
.action-placeholder { min-height: 64rpx; border-radius: 36rpx; display: flex; align-items: center; justify-content: center; background: rgba(23, 153, 91, 0.10); color: #17995B; font-size: 24rpx; font-weight: 500; }
.review-row { margin-top: 12rpx; }
.review-chip { display: inline-flex; align-items: center; min-height: 36rpx; padding: 0 14rpx; border-radius: 999rpx; font-size: 22rpx; }
.review-chip.pending { background: rgba(102, 114, 168, 0.08); color: #6672A8; }
.review-chip.approved { background: rgba(23, 153, 91, 0.10); color: #17995B; }
.review-chip.rejected { background: rgba(119, 126, 144, 0.12); color: #687084; }
.review-chip.customer-selected { margin-left: 8rpx; background: rgba(102, 114, 168, 0.12); color: #6672A8; }
.quote-toolbar { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-bottom: 18rpx; }
.summary-btn { margin: 0; background: #6672A8; color: #fff; border-radius: 36rpx; font-size: 26rpx; }
.refresh-btn { margin: 0; background: #F2F4F7; color: #6672A8; border-radius: 36rpx; font-size: 26rpx; }
.refresh-btn::after { border: none; }
.selected-label { display: inline-block; margin-top: 12rpx; padding: 8rpx 18rpx; border-radius: 24rpx; background: #f2f3fa; color: #6672A8; font-size: 24rpx; }
.command-card { background: #fff; border-radius: 30rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 18rpx 42rpx rgba(31, 36, 51, 0.08); }
.command-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.command-kicker { color: #7E889A; font-size: 22rpx; letter-spacing: 1rpx; text-transform: uppercase; }
.command-title { margin-top: 8rpx; color: #182235; font-size: 36rpx; font-weight: 700; }
.status-pill { display: inline-flex; align-items: center; justify-content: center; min-height: 46rpx; padding: 0 18rpx; border-radius: 999rpx; font-size: 23rpx; font-weight: 600; white-space: nowrap; }
.status-pill.inline { min-height: 38rpx; padding: 0 14rpx; font-size: 22rpx; vertical-align: middle; }
.status-quoting { background: rgba(102, 114, 168, 0.10); color: #6672A8; }
.status-assigned { background: rgba(23, 153, 91, 0.10); color: #17995B; }
.status-cancelled { background: rgba(119, 126, 144, 0.12); color: #687084; }
.status-completed { background: rgba(31, 36, 51, 0.08); color: #1F2433; }
.status-default { background: #f2f4f7; color: #6E7788; }
.command-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 24rpx; }
.command-metric { background: #f7f9ff; border-radius: 20rpx; padding: 20rpx; }
.command-metric.wide { grid-column: span 2; }
.metric-value { color: #182235; font-size: 34rpx; font-weight: 700; }
.metric-value.small { font-size: 25rpx; line-height: 1.4; word-break: break-word; }
.metric-label { margin-top: 6rpx; color: #7E889A; font-size: 22rpx; }
.risk-banner { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: rgba(244, 156, 69, 0.12); color: #C36F16; font-size: 24rpx; }
.next-action { margin-top: 18rpx; color: #253554; font-size: 26rpx; line-height: 1.6; }
.selected-summary { margin-top: 14rpx; padding: 18rpx; border-radius: 18rpx; background: rgba(23, 153, 91, 0.08); color: #167A4D; font-size: 24rpx; line-height: 1.5; }
.quote-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #253554; font-size: 28rpx; font-weight: 600; }
.transport-health-panel.healthy { border-left: 8rpx solid #17995B; }
.transport-health-panel.unhealthy { border-left: 8rpx solid #D9822B; }
.transport-health-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.transport-health-title { color: #1E2635; font-size: 28rpx; font-weight: 700; }
.transport-source-pill { flex-shrink: 0; min-height: 42rpx; padding: 0 16rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-size: 21rpx; font-weight: 600; }
.transport-source-pill.healthy { background: rgba(23, 153, 91, 0.10); color: #167A4D; }
.transport-source-pill.unhealthy { background: rgba(217, 130, 43, 0.12); color: #A65F16; }
.transport-health-detail { margin-top: 14rpx; color: #4F6385; font-size: 24rpx; line-height: 1.5; }
.transport-missing { margin-top: 10rpx; color: #A65F16; font-size: 23rpx; line-height: 1.4; }
.transport-snapshot-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; }
.transport-snapshot-cell { min-height: 92rpx; box-sizing: border-box; padding: 14rpx 16rpx; border-radius: 16rpx; background: #F7F9FF; }
.snapshot-label { color: #7E889A; font-size: 21rpx; }
.snapshot-value { margin-top: 6rpx; color: #1E2635; font-size: 25rpx; font-weight: 600; line-height: 1.3; word-break: break-word; }
.snapshot-value.small { font-size: 21rpx; font-weight: 500; }
.transport-repair-btn { margin: 18rpx 0 0; height: 74rpx; line-height: 74rpx; border-radius: 37rpx; background: #6672A8; color: #fff; font-size: 25rpx; font-weight: 600; }
.transport-repair-btn::after { border: none; }
