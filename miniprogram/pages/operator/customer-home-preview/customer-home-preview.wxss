.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 64rpx 24rpx 48rpx;
  background: #F5F6FA;
}

.preview-header,
.mode-banner,
.panel {
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 36, 51, 0.04);
}

.preview-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.kicker,
.customer-kicker {
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 8rpx;
  color: #17315F;
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 700;
}

.header-note {
  flex: 0 0 240rpx;
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.45;
  text-align: right;
}

.mode-banner {
  border: 1rpx solid rgba(102, 114, 168, 0.18);
}

.mode-banner.unpublished {
  background: #FFF8EA;
  border-color: rgba(194, 122, 0, 0.22);
}

.mode-banner.published {
  background: #F1F8F4;
  border-color: rgba(62, 140, 92, 0.20);
}

.mode-banner.delivered {
  background: linear-gradient(135deg, #5B6596 0%, #7C6FA8 100%);
  border-color: rgba(91, 101, 150, 0.28);
}

.mode-banner.delivered .banner-title,
.mode-banner.delivered .banner-sub {
  color: #FFFFFF;
}

.mode-banner.delivered .banner-sub {
  opacity: 0.86;
}

.banner-title {
  color: #1F3266;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
}

.banner-sub {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.45;
}

.section-title,
.preview-title {
  color: #1F3266;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.preview-title {
  font-size: 27rpx;
  margin-bottom: 12rpx;
}

.field-label {
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  color: #6E7788;
  font-size: 24rpx;
}

.selector-hint {
  margin: -2rpx 0 12rpx;
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.45;
}

.trip-row,
.search-row,
.action-row {
  display: grid;
  grid-template-columns: 1fr 140rpx;
  gap: 12rpx;
  align-items: center;
}

.action-row {
  grid-template-columns: 1fr 1fr;
  margin-top: 18rpx;
}

.preview-open-btn {
  margin-top: 16rpx;
}

.text-input {
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx solid #DDE4F3;
  color: #1D2433;
  font-size: 25rpx;
}

.mini-btn,
.secondary-btn,
.primary-btn,
.primary-wide-btn,
.secondary-wide-btn {
  margin: 0;
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 24rpx;
}

.mini-btn,
.primary-btn,
.primary-wide-btn {
  background: #6672A8;
  color: #FFFFFF;
}

.secondary-btn,
.secondary-wide-btn {
  background: #F2F4F7;
  color: #6672A8;
}

.primary-wide-btn,
.secondary-wide-btn {
  width: 100%;
  margin-top: 16rpx;
}

.selector-row,
.customer-list,
.preview-section,
.share-box {
  margin-top: 18rpx;
}

.customer-preview-note {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #F7F9FF;
  border: 1rpx solid rgba(102, 114, 168, 0.14);
}

.review-metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.review-metric {
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  text-align: center;
}

.review-metric-value {
  color: #1D2433;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 780;
}

.review-metric-label {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 21rpx;
  line-height: 1.35;
}

.guest-card,
.customer-bar,
.selected-preview-customer,
.empty-card,
.waiting-card,
.info-card,
.day-card {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #F7F9FF;
}

.guest-card,
.customer-bar {
  border: 1rpx solid transparent;
}

.guest-card.active,
.customer-bar.active {
  border-color: rgba(102, 114, 168, 0.40);
  background: rgba(102, 114, 168, 0.08);
}

.customer-bar {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 12rpx;
}

.customer-main {
  flex: 1;
  min-width: 0;
}

.customer-name,
.empty-title,
.waiting-title,
.info-main,
.day-title,
.timeline-title {
  color: #1D2433;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

.customer-sub,
.empty-sub,
.waiting-sub,
.info-sub,
.timeline-sub {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 22rpx;
  line-height: 1.45;
}

.customer-stats {
  flex: 0 0 160rpx;
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
  font-weight: 700;
}

.error-panel {
  background: #FFF7F7;
}

.error-text {
  color: #B64747;
  font-size: 24rpx;
  line-height: 1.5;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.meta-item {
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
}

.meta-label {
  color: #7E889A;
  font-size: 21rpx;
  line-height: 1.25;
}

.meta-value {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
  word-break: break-word;
}

.selected-preview-customer,
.critical-box,
.warning-box {
  margin-top: 18rpx;
}

.critical-box,
.warning-box {
  padding: 18rpx;
  border-radius: 18rpx;
}

.critical-box {
  background: rgba(196, 64, 64, 0.10);
}

.warning-box {
  background: rgba(194, 122, 0, 0.10);
}

.warning-title {
  color: #253554;
  font-size: 24rpx;
  font-weight: 700;
}

.warning-row {
  margin-top: 8rpx;
  color: #6E7788;
  font-size: 22rpx;
  line-height: 1.45;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #F7F9FF;
  border: 1rpx solid #DDE4F3;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.45;
}

.invite-path {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #F7F9FF;
  color: #253554;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.customer-preview {
  background: #FFFFFF;
}

.customer-hero {
  padding: 26rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #F8FAFF 0%, #FFFFFF 100%);
  border: 1rpx solid #E3E8F4;
}

.customer-title {
  margin-top: 8rpx;
  color: #17315F;
  font-size: 34rpx;
  line-height: 1.28;
  font-weight: 700;
}

.customer-hero .customer-sub {
  color: #6672A8;
  font-weight: 600;
}

.waiting-card {
  margin-top: 18rpx;
  background: #FFF8EA;
}

.info-card,
.day-card {
  margin-top: 12rpx;
}

.day-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.day-label {
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 700;
}

.day-date {
  flex: 0 0 176rpx;
  color: #7E889A;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
}

.summary-highlights {
  display: grid;
  gap: 8rpx;
  margin-top: 14rpx;
}

.summary-highlight {
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: #F7F9FF;
  color: #253554;
  font-size: 23rpx;
  line-height: 1.35;
}

.timeline-row {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(102, 114, 168, 0.10);
}

.timeline-time {
  color: #6672A8;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 700;
}

button::after {
  border: none;
}
