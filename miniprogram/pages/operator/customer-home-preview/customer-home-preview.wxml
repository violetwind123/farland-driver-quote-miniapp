<view class="page">
  <view class="preview-header">
    <view>
      <view class="kicker">OPERATOR PREVIEW</view>
      <view class="title">Customer Preview Center</view>
    </view>
    <view class="header-note">{{preview ? 'Preview mode. Use the native page back control to leave this operator page.' : 'Select customer or temporary guest, then enter customer preview.'}}</view>
  </view>

  <view class="mode-banner {{previewMeta.banner_class || (previewMeta && previewMeta.unpublished ? 'unpublished' : 'published')}}">
    <view class="banner-title">{{previewMeta.banner_title || (previewMeta && previewMeta.unpublished ? 'UNPUBLISHED - OPERATOR PREVIEW ONLY' : 'PUBLISHED CUSTOMER VIEW')}}</view>
    <view class="banner-sub">{{previewMeta.banner_sub || 'Customer would see: waiting'}}</view>
  </view>

  <view class="panel">
    <view class="section-title">Preview Target</view>
    <view class="field-label">trip_id</view>
    <view class="trip-row">
      <input class="text-input" value="{{tripId}}" placeholder="输入或粘贴 trip_id / external_trip_id" bindinput="onTripIdInput" />
      <button class="mini-btn" loading="{{loading}}" bindtap="loadPreview">预览</button>
    </view>

    <view class="selector-row">
      <view class="guest-card {{previewMode === 'temporary_guest' ? 'active' : ''}}" bindtap="selectTemporaryGuest">
        <view class="customer-name">Temporary Guest Preview</view>
        <view class="customer-sub">不创建用户，不写 customer_trip_access</view>
      </view>
    </view>

    <view class="field-label">选择已有客户</view>
    <view class="selector-hint">点选客户后会预览该客户最近的 Farland 行程；如需指定刚导入的行程，可先输入 trip_id。</view>
    <view class="search-row">
      <input class="text-input" value="{{keyword}}" placeholder="客户称呼 / 手机 / 微信号" bindinput="onKeywordInput" />
      <button class="mini-btn" loading="{{customerLoading}}" bindtap="searchCustomers">搜索</button>
    </view>

    <view wx:if="{{customers.length}}" class="customer-list">
      <view
        wx:for="{{customers}}"
        wx:key="customer_user_id"
        class="customer-bar {{selectedCustomer && selectedCustomer.customer_user_id === item.customer_user_id ? 'active' : ''}}"
        data-user-id="{{item.customer_user_id}}"
        bindtap="selectCustomer"
      >
        <view class="customer-main">
          <view class="customer-name">{{item.display_name || item.name}}</view>
          <view class="customer-sub">WeChat: {{item.wechat_id || '未填写'}}</view>
          <view class="customer-sub">OpenID: {{item.openid_display || '未绑定'}}</view>
        </view>
        <view class="customer-stats">
          <view>{{item.active_trip_count || 0}} active</view>
          <view>{{item.unpublished_preview_count || 0}} unpublished</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="panel error-panel">
    <view class="section-title">错误</view>
    <view class="error-text">{{error}}</view>
  </view>

  <view wx:if="{{preview}}" class="panel">
    <view class="section-title">Operator Warning Panel</view>
    <view class="meta-grid">
      <view class="meta-item">
        <view class="meta-label">review</view>
        <view class="meta-value">{{previewMeta.review_status || '-'}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-label">visibility</view>
        <view class="meta-value">{{previewMeta.visibility_status || '-'}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-label">version</view>
        <view class="meta-value">v{{previewMeta.published_version || 0}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-label">client</view>
        <view class="meta-value">{{previewMeta.customer_delivery_text || '未推送客户端'}}</view>
      </view>
    </view>
    <view wx:if="{{previewCustomer}}" class="selected-preview-customer">
      <view class="customer-name">{{previewCustomer.display_name}}</view>
      <view class="customer-sub">{{previewCustomer.is_registered ? 'Registered Customer' : 'Temporary Guest'}}</view>
      <view wx:if="{{previewCustomer.wechat_id}}" class="customer-sub">WeChat: {{previewCustomer.wechat_id}}</view>
      <view wx:if="{{previewCustomer.openid_display}}" class="customer-sub">OpenID: {{previewCustomer.openid_display}}</view>
    </view>

    <view class="release-flow-card {{previewMeta.release_status}}">
      <view class="release-title">{{previewMeta.release_step_title}}</view>
      <view class="release-copy">{{previewMeta.release_step_copy}}</view>
      <view class="release-steps">
        <view wx:for="{{previewMeta.release_steps}}" wx:key="key" class="release-step {{item.status}}">
          <view class="release-dot"></view>
          <view class="release-label">{{item.label}}</view>
        </view>
      </view>
      <view class="release-tip">{{previewMeta.release_step_tip}}</view>
    </view>

    <view wx:if="{{previewMeta.critical_warnings.length}}" class="critical-box">
      <view class="warning-title">Critical warnings</view>
      <view wx:for="{{previewMeta.critical_warnings}}" wx:key="*this" class="warning-row">{{item}}</view>
    </view>
    <view wx:if="{{previewMeta.warnings.length}}" class="warning-box">
      <view class="warning-title">Warnings</view>
      <view wx:for="{{previewMeta.warnings}}" wx:key="*this" class="warning-row">{{item}}</view>
    </view>

    <textarea
      class="note-input"
      value="{{reviewNote}}"
      maxlength="300"
      placeholder="发布备注，可选"
      bindinput="onReviewNoteInput"
    />
    <view class="action-row">
      <button class="secondary-btn" loading="{{building}}" bindtap="buildDraft">Build Customer Draft</button>
      <button class="primary-btn" loading="{{publishing}}" bindtap="publishTrip">Publish After Review</button>
    </view>
    <button class="{{previewMeta.customer_preview_button_class || 'secondary-wide-btn'}} preview-open-btn" bindtap="openCustomerFacingPreview">
      {{previewMeta.customer_preview_button_text || '查看客户等待页'}}
    </button>
    <view wx:if="{{previewMeta.customer_would_see !== 'published'}}" class="release-open-hint">
      当前未发布，客户真实页面只显示等待状态，不显示草稿。
    </view>
    <view wx:if="{{previewMeta.customer_would_see === 'published'}}" class="share-box">
      <view class="share-title">客户分享卡</view>
      <view class="share-sub">发布成功后才允许创建或复制客户卡。</view>
      <button class="primary-wide-btn" loading="{{creatingInvite}}" bindtap="createInvite">Create / Copy Customer Card</button>
      <view wx:if="{{invitePath}}" class="invite-path">{{invitePath}}</view>
      <button wx:if="{{invitePath}}" class="secondary-wide-btn" bindtap="copyInvitePath">复制客户路径</button>
    </view>
  </view>

  <view class="panel customer-preview">
    <view class="section-title">客户真实页面入口</view>
    <view wx:if="{{!customerHome}}" class="empty-card">
      <view class="empty-title">暂无预览</view>
      <view class="empty-sub">输入 trip_id 或从导入页进入后，先生成运营审核摘要。</view>
    </view>

    <block wx:else>
      <view class="customer-preview-note">
        <view class="customer-kicker">CUSTOMER VIEW</view>
        <view class="customer-title">这里不是客户真实页面</view>
        <view class="customer-sub">客户真实显示效果请点击下方按钮进入 `我的行程`。该入口会模拟客户打开分享卡，不创建访问记录，不绑定客户。</view>
        <button class="{{previewMeta.customer_preview_button_class || 'secondary-wide-btn'}}" bindtap="openCustomerFacingPreview">
          {{previewMeta.customer_preview_button_text || '查看客户等待页'}}
        </button>
      </view>

      <view wx:if="{{previewMeta.customer_would_see === 'waiting'}}" class="waiting-card">
        <view class="waiting-title">Farland 顾问正在核对行程</view>
        <view class="waiting-sub">当前未发布。客户真实打开时只会看到等待状态，不会看到草稿。</view>
      </view>

      <view wx:if="{{customerHome.trip_overview.length}}" class="preview-section">
        <view class="preview-title">运营审核摘要</view>
        <view wx:for="{{customerHome.trip_overview}}" wx:key="trip_id" class="info-card">
          <view class="info-main">{{item.title}}</view>
          <view class="info-sub">{{item.trip_no}} · {{item.date_range_text}}</view>
          <view class="info-sub">{{item.city_summary}}</view>
          <view wx:if="{{item.days_count || item.hotels_count || item.flights_count}}" class="info-sub">
            {{item.days_count || 0}} days · {{item.hotels_count || 0}} hotels · {{item.flights_count || 0}} flights
          </view>
        </view>
      </view>

      <view class="preview-section">
        <view class="preview-title">发布数据检查</view>
        <view class="review-metric-grid">
          <view class="review-metric">
            <view class="review-metric-value">{{customerHome.daily_summary_cards.length || customerHome.itinerary_days.length}}</view>
            <view class="review-metric-label">每日卡片</view>
          </view>
          <view class="review-metric">
            <view class="review-metric-value">{{customerHome.hotel_requests.length}}</view>
            <view class="review-metric-label">酒店卡片</view>
          </view>
          <view class="review-metric">
            <view class="review-metric-value">{{customerHome.flight_cards.length}}</view>
            <view class="review-metric-label">航班卡片</view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
