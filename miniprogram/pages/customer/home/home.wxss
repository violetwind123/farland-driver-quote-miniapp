  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 600;
}

.price-total {
  margin-top: 6rpx;
  color: #6672A8;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 700;
}

.quote-detail {
  margin-top: 14rpx;
}

.quote-detail.muted {
  margin-top: 4rpx;
  color: #8A91A1;
}

.quote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.quote-btn {
  flex: 0 0 auto;
  min-width: 174rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 24rpx;
}

.quote-btn::after {
  border: none;
}

.activity-list {
