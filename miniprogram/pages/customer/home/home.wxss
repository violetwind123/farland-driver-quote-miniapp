}

/* 手机版行程单内联查看:fixed 覆盖内容区,z-index 低于自定义 tabBar 以保留 bottombar;只一张图 */
.sheet-inline {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}
.sheet-inline-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: env(safe-area-inset-top) 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  background: var(--bg-card);
}
.sheet-inline-back {
  width: 140rpx;
  font-size: 30rpx;
  color: var(--brand-600);
  font-weight: 600;
}
.sheet-inline-heading {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.sheet-inline-spacer {
  width: 140rpx;
}
.sheet-inline-scroll {
  flex: 1;
  min-height: 0;
}
.sheet-inline-img {
  display: block;
  width: 100%;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 运营预览工具条独立占位，避免覆盖客户卡片；客户真实界面不渲染此区域。 */
.trip-invite-view.operator-preview-active {
  padding-top: calc(68rpx + env(safe-area-inset-top));
}

.op-preview-exit {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 60;
  height: calc(68rpx + env(safe-area-inset-top));
  padding: env(safe-area-inset-top) 28rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(247, 248, 252, 0.98);
  border-bottom: 1rpx solid rgba(27, 35, 64, 0.08);
  color: var(--ink-600, #5A6178);
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(20, 24, 48, 0.08);
}

.op-preview-exit__label {
  color: var(--ink-400, #9096A8);
}

.op-preview-exit__action {
  color: var(--brand-600, #57639E);
  font-weight: 700;
}

/* ===== 3a 定稿 · 行程进度条(trip-progress:6 等分列居中,今天=高亮胶囊,无日期行) ===== */
.trip-progress-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 0 40rpx 14rpx;
}
.trip-progress-head .tp-kicker { font-size: 20rpx; letter-spacing: 5rpx; color: var(--ink-400, #9096A8); font-weight: 600; }
.trip-progress-head .tp-title { font-size: 26rpx; font-weight: 600; color: var(--ink-900, #1B2340); }
.trip-progress-head .tp-hint { margin-left: auto; font-size: 19rpx; color: var(--ink-400, #9096A8); }
.trip-progress {
  position: relative;
  overflow: hidden;
  margin: 0 32rpx;
  background: var(--bg-card, #FFFFFF);
  border: 1rpx solid var(--line, rgba(27, 35, 64, 0.07));
  border-radius: 28rpx;
  padding: 24rpx 12rpx 20rpx;
}
.trip-progress .track,
.trip-progress .track-done { position: absolute; top: 35rpx; height: 4rpx; }
.trip-progress .track { background: rgba(27, 35, 64, 0.10); }
.trip-progress .track-done { background: var(--brand-500, #6672A8); }
.trip-progress .cols { display: flex; }
.trip-progress .col {
  flex: 1;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.trip-progress .dot { width: 18rpx; height: 18rpx; border-radius: 999rpx; background: #C4C8D4; margin-top: 4rpx; }
.trip-progress .dot.future { background: #FFFFFF; border: 4rpx solid #C4C8D4; box-sizing: border-box; }
.trip-progress .dot.today { width: 26rpx; height: 26rpx; background: var(--brand-500, #6672A8); box-shadow: 0 0 0 6rpx rgba(102, 114, 168, 0.16); margin-top: 0; }
.trip-progress .day { font-size: 24rpx; font-weight: 700; color: var(--ink-600, #5A6178); margin-top: 16rpx; white-space: nowrap; }
.trip-progress .day.past { color: var(--ink-400, #9096A8); }
.trip-progress .city { font-size: 18rpx; color: var(--ink-400, #9096A8); white-space: nowrap; }
.trip-progress .city.past { color: var(--ink-300, #B3B8C6); }
.trip-progress .today-card {
  margin-top: 14rpx;
  width: fit-content;
  padding: 10rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(102, 114, 168, 0.08);
  border: 1rpx solid rgba(102, 114, 168, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.trip-progress .today-card .day { color: var(--ink-900, #1B2340); margin-top: 0; }
.trip-progress .today-card .city { color: var(--brand-600, #57639E); margin-top: 2rpx; }

/* ===== 3a 定稿 · 正式行程屏块 2-5 ===== */
.trip-hero.three-a-hero {
  margin: 0 8rpx;
  padding: 24rpx 32rpx 22rpx;
  border-radius: 32rpx;
  background:
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.035) 0, rgba(255, 255, 255, 0.035) 1rpx, transparent 1rpx, transparent 16rpx),
    repeating-linear-gradient(45deg, rgba(27, 35, 64, 0.025) 0, rgba(27, 35, 64, 0.025) 1rpx, transparent 1rpx, transparent 20rpx),
    linear-gradient(145deg, #6974AB 0%, var(--brand-500, #6672A8) 56%, var(--brand-600, #57639E) 100%);
  box-shadow: 0 18rpx 42rpx rgba(27, 35, 64, 0.14);
}
.trip-hero__mark {
  position: absolute;
  right: 28rpx;
  top: 26rpx;
  width: 168rpx;
  opacity: 0.92;
}
.trip-hero__greet {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  line-height: 1.35;
}
.trip-hero__code {
  margin-top: 4rpx;
  max-width: 420rpx;
  color: #FFFFFF;
  font-family: inherit;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 0;
}
.trip-hero__dates {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 500;
}
.trip-hero__route {
  margin-top: 4rpx;
  max-width: 520rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 600;
}
.trip-hero__status {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.16);
  font-size: 20rpx;
  font-weight: 600;
}
.data-source-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 32rpx 0;
}
.data-source-row .k {
  color: var(--ink-400, #9096A8);
  font-size: 17rpx;
}
.data-source-row .v {
  color: var(--ink-600, #5A6178);
  font-size: 17rpx;
  font-weight: 600;
}
.data-source-row image {
  display: block;
  width: 20rpx;
  height: 20rpx;
}
.data-source-row image.round {
  border-radius: 50%;
}
.data-source-row .div {
  width: 1rpx;
  height: 16rpx;
  margin: 0 6rpx;
  background: rgba(27, 35, 64, 0.14);
}
.p4-today-card.three-a-card {
  padding: 30rpx 36rpx 26rpx;
  border-radius: 36rpx;
}
.day-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.day-head-left {
  min-width: 0;
}
.day-head-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.day-head-title .date {
  color: var(--brand-600, #57639E);
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}
.weather-inline {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: var(--ink-600, #5A6178);
  font-size: 20rpx;
  font-weight: 600;
}
.wx-ico {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, #F5CE85 0%, #D99E3A 70%);
}
.day-stats {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}
.day-stats .label {
  color: var(--ink-600, #5A6178);
  font-size: 24rpx;
}
.day-stats .num {
  color: #20243A;
  font-size: 30rpx;
  font-weight: 700;
}
.day-stats .unit {
  color: #8A90A6;
  font-size: 18rpx;
  font-weight: 600;
}
.day-stats .div {
  width: 1rpx;
  height: 20rpx;
  align-self: center;
  background: rgba(27, 35, 64, 0.14);
}
.day-head-right {
  flex: 0 0 auto;
  text-align: right;
}
.depart-time {
  color: var(--brand-600, #57639E);
  font-family: inherit;
  font-size: 38rpx;
  line-height: 1.08;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.depart-cap {
  margin-top: 2rpx;
  color: var(--ink-400, #9096A8);
  font-size: 19rpx;
  letter-spacing: 2rpx;
}
.three-a-timeline {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}
.stop-row {
  display: flex;
  gap: 24rpx;
  min-height: 64rpx;
  padding-bottom: 10rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.stop-row + .stop-row {
  margin-top: 12rpx;
}
.stop-row .time-col {
  width: 80rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
  text-align: right;
}
.stop-row .time-col .t {
  color: var(--ink-900, #1B2340);
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.stop-row .time-col .t.depart {
  color: var(--brand-600, #57639E);
}
.stop-row .time-col .cap {
  color: var(--ink-400, #9096A8);
  font-size: 19rpx;
  letter-spacing: 2rpx;
}
.stop-row .node-col,
.seg-row .node-col {
  width: 20rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stop-row .node {
  width: 14rpx;
  height: 14rpx;
  margin-top: 9rpx;
  border-radius: 999rpx;
  background: var(--brand-500, #6672A8);
  flex-shrink: 0;
}
.stop-row .node.future {
  background: #FFFFFF;
  border: 3rpx solid #C4C8D4;
  box-sizing: border-box;
}
.stop-row .node.depart,
.stop-row .node.end {
  width: 20rpx;
  height: 20rpx;
  margin-top: 6rpx;
  background: #FFFFFF;
  border: 3rpx solid var(--brand-500, #6672A8);
  box-sizing: border-box;
}
.stop-row .node-col .link {
  width: 1rpx;
  flex: 1;
  background: rgba(27, 35, 64, 0.10);
}
.stop-body {
  flex: 1;
  min-width: 0;
  padding-top: 1rpx;
}
.stop-row .title {
  color: var(--ink-900, #1B2340);
  font-size: 27rpx;
  line-height: 1.42;
  font-weight: 600;
}
.stop-row .sub {
  margin-top: 8rpx;
  color: var(--ink-400, #9096A8);
  font-size: 22rpx;
  line-height: 1.4;
}
.chg-badge {
  display: inline-flex;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  color: #9A6700;
  background: #FFF4D6;
  font-size: 18rpx;
  font-weight: 700;
  vertical-align: middle;
}
.seg-row {
  display: flex;
  gap: 24rpx;
  flex: 0 0 68rpx;
}
.seg-row .time-col {
  width: 80rpx;
  flex-shrink: 0;
}
.seg-row .node-col {
  justify-content: center;
}
.seg-row .node-col .link {
  width: 1rpx;
  align-self: stretch;
  background: rgba(27, 35, 64, 0.10);
}
.seg-row .tag-slot {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 14rpx 0;
}
.drive-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 42rpx;
  max-width: 100%;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #F4F5F8;
  border: 1rpx solid var(--line, rgba(27, 35, 64, 0.07));
  white-space: nowrap;
  box-sizing: border-box;
  font-variant-numeric: tabular-nums;
}
.drive-tag .segment-mode-label {
  color: var(--ink-600, #5A6178);
  font-size: 21rpx;
  font-weight: 700;
}
.drive-tag .dist {
  color: var(--ink-600, #5A6178);
  font-size: 22rpx;
  font-weight: 600;
}
.drive-tag .traffic {
  font-size: 21rpx;
  font-weight: 700;
}
.drive-tag .traffic.smooth { color: #2F6043; }
.drive-tag .traffic.slow { color: #D9A13B; }
.drive-tag .traffic.jam { color: #BE4A2E; }
.day-card-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}
.dca-btn {
  margin: 0;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
}
.dca-btn::after {
  border: none;
}
.dca-btn--outline {
  color: var(--brand-600, #57639E);
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.40);
}
.dca-btn--filled {
  color: #FFFFFF;
  background: linear-gradient(135deg, #727EB5 0%, #5F6BA6 100%);
  box-shadow: 0 10rpx 22rpx rgba(95, 107, 166, 0.24);
}
.combo-shell {
  margin-top: 18rpx;
}
.combo-card {
  padding: 8rpx 30rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line, rgba(27, 35, 64, 0.07));
  box-shadow: 0 10rpx 28rpx rgba(27, 35, 64, 0.06);
}
.combo-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 72rpx;
  padding: 14rpx 0;
}
.combo-row--divider {
  border-top: 1rpx solid rgba(27, 35, 64, 0.08);
}
.combo-label {
  width: 108rpx;
  flex-shrink: 0;
  color: var(--ink-400, #9096A8);
  font-size: 19rpx;
  font-weight: 600;
}
.combo-value-wrap {
  flex: 1;
  min-width: 0;
}
.combo-value {
  color: var(--ink-900, #1B2340);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.combo-helper {
  margin-top: 3rpx;
  color: var(--ink-400, #9096A8);
  font-size: 20rpx;
  line-height: 1.35;
}
.combo-chip {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #EAF3EE;
  color: #3F7A5D;
  font-size: 19rpx;
  font-weight: 700;
}
.combo-chip.pending {
  color: var(--brand-600, #57639E);
  background: rgba(102, 114, 168, 0.10);
}
.combo-chip .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
}
.combo-row__phone {
  flex: 0 0 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: var(--brand-600, #57639E);
  font-size: 20rpx;
  font-weight: 700;
}
.combo-chevron {
  color: var(--ink-400, #9096A8);
  font-size: 36rpx;
  line-height: 1;
}
