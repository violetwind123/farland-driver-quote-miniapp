/* ---------- R5-5d 访校卡(confirmed-only,web 白名单快照驱动) ---------- */
.visit-card {
  margin-top: 24rpx;
  border-radius: 36rpx;
  overflow: hidden;
  padding: 0;
}
.visit-card + .visit-card { margin-top: 24rpx; }

/* hero 深蓝渐变为定制色(近似 --ink-900→--brand-500 家族),无对应 token,保留字面值 */
.visit-hero {
  position: relative;
  height: 148rpx;
  background: linear-gradient(148deg, #232B4A 0%, #4B568C 70%, #6C77AB 100%);
  overflow: hidden;
  padding: 26rpx 32rpx;
  box-sizing: border-box;
}
.visit-hero-watermark {
  position: absolute;
  right: 4rpx;
  top: 8rpx;
  font-family: inherit;
  font-size: 88rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.07);
  white-space: nowrap;
  letter-spacing: -4rpx;
}
.visit-hero-badges {
  position: relative;
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.visit-day-badge {
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--gold-50);
  color: var(--gold-700);
  font-size: 18rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}
.visit-hero-title {
  position: relative;
  margin-top: 8rpx;
  font-family: inherit;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.visit-body { padding: 22rpx 32rpx 26rpx; }
.visit-time-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.visit-time-big {
  font-family: inherit;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.visit-time-range {
  font-size: 21rpx;
  color: var(--ink-400);
}
.visit-weather { margin-left: auto; }
.visit-info-row {
  display: flex;
  gap: 24rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}
.visit-info-label {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--ink-400);
}
.visit-info-value {
  font-size: 22rpx;
  color: var(--ink-900);
  font-weight: 500;
}
.visit-tail-note {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--ink-400);
  line-height: 1.5;
}

/* 天气三态图标:CSS 圆盘/描边近似(WXML 无法可靠承载 SVG defs) */
.wx-ico {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.wx-sun { background: radial-gradient(var(--wx-sun-hi), var(--wx-sun)); }
.wx-cloud { background: transparent; border: 2rpx solid var(--wx-cloud); }
.wx-rain { background: transparent; border: 2rpx solid var(--wx-rain); }
.wx-snow { background: transparent; border: 2rpx solid var(--wx-cloud); }

.trip-invite-summary {
  margin-bottom: 18rpx;
}

/* 手机版行程单:sheet_draft 查看按钮 + official 次要入口 */
.sheet-draft-btn {
  margin-top: 24rpx;
  width: 100%;
}

.itinerary-sheet-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
