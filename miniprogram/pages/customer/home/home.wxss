@import "/styles/theme.wxss";

.trip-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 80% 0%, rgba(91, 101, 150, 0.14), transparent 34%),
    #F6F7FB;
}

.trip-hero {
  padding: 30rpx;
  background: #5B6596;
  color: #FFFFFF;
}

.trip-hero .section-kicker {
  color: rgba(255,255,255,0.74);
}

.trip-hero-title {
  margin-top: 12rpx;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 700;
}

.trip-hero-meta {
  margin-top: 12rpx;
  color: rgba(255,255,255,0.88);
  font-size: 25rpx;
}

.trip-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.trip-stat {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.13);
}

.trip-stat-value {
  font-size: 38rpx;
  font-weight: 700;
}

.trip-stat-label {
  margin-top: 6rpx;
  color: rgba(255,255,255,0.78);
  font-size: 22rpx;
}

.section-shell {
  margin-top: 30rpx;
}

.today-card {
  margin-top: 18rpx;
  padding: 30rpx;
}

.today-topline {
  color: #5B6596;
  font-size: 24rpx;
  font-weight: 600;
}

.today-title {
  margin-top: 10rpx;
  margin-bottom: 10rpx;
  color: #182235;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
}

.timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: grid;
  grid-template-columns: 78rpx 20rpx 1fr;
  column-gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #EDF1F7;
}

.timeline-time {
  color: #5B6596;
  font-size: 24rpx;
  font-weight: 700;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: #5B6596;
}

.timeline-title {
  color: #182235;
  font-size: 28rpx;
  font-weight: 600;
}

.driver-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F8F9FD;
  border: 1rpx solid #E8ECF5;
}

.driver-label {
  color: #7E889A;
  font-size: 22rpx;
}

.driver-main {
  margin-top: 8rpx;
  color: #182235;
  font-size: 28rpx;
  font-weight: 600;
}

.driver-sub,
.service-sub {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.5;
}

.advisor-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #6E7788;
  font-size: 23rpx;
}

.overview-list {
  margin-top: 18rpx;
}

.overview-item {
  position: relative;
  padding: 28rpx;
  margin-bottom: 18rpx;
}

.day-pill {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(91, 101, 150, 0.1);
  color: #5B6596;
  font-size: 22rpx;
}

.overview-title {
  margin-top: 16rpx;
  color: #182235;
  font-size: 30rpx;
  font-weight: 700;
}

.overview-meta {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  color: #6E7788;
  font-size: 23rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.service-card {
  padding: 28rpx;
}

.service-title {
  margin-top: 8rpx;
  margin-bottom: 14rpx;
  color: #182235;
  font-size: 32rpx;
  font-weight: 700;
}

.service-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #EDF1F7;
}

.service-item:first-of-type {
  border-top: 0;
}

.service-main {
  color: #182235;
  font-size: 27rpx;
  font-weight: 600;
}

.benefit-panel {
  margin-top: 30rpx;
  padding: 28rpx;
}

.benefit-meta {
  margin-top: 10rpx;
  color: #5B6596;
  font-size: 24rpx;
}

.benefit-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #EDF1F7;
}

.benefit-row:first-of-type {
  margin-top: 12rpx;
}

.benefit-name {
  color: #182235;
  font-size: 27rpx;
  font-weight: 600;
}

.benefit-btn {
  margin-top: 16rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #5B6596;
  border: 1rpx solid #DDE3F1;
  font-size: 26rpx;
}

.advisor-panel {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(91, 101, 150, 0.08);
  color: #5C6576;
  font-size: 24rpx;
  line-height: 1.7;
}
