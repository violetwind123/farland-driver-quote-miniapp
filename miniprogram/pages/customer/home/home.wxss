  border: none;
}

.quote-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.quote-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
