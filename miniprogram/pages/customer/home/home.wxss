@import "/styles/theme.wxss";

.trip-page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(102, 114, 168, 0.10), transparent 32%),
    linear-gradient(180deg, #F7F8FC 0%, #FFFFFF 100%);
}

.operator-back-btn {
  position: fixed;
  left: 24rpx;
  top: 24rpx;
  z-index: 20;
  margin: 0;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #6672A8;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(31, 36, 51, 0.10);
}

.operator-back-btn::after {
  border: none;
}

.trip-hero {
  position: relative;
  overflow: hidden;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  color: #FFFFFF;
  background:
    radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.26), transparent 34%),
    radial-gradient(circle at 100% 18%, rgba(255, 255, 255, 0.12), transparent 28%),
    linear-gradient(145deg, #6974AB 0%, #6672A8 56%, #4F598B 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 2rpx 4rpx rgba(255, 255, 255, 0.18) inset,
    0 -3rpx 10rpx rgba(0, 0, 0, 0.06) inset,
    0 14rpx 36rpx rgba(40, 48, 88, 0.16),
    0 4rpx 12rpx rgba(17, 24, 39, 0.07);
}

.trip-hero::before {
  content: '';
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.10),
    rgba(255, 255, 255, 0.42),
    rgba(255, 255, 255, 0.16)
  );
  pointer-events: none;
}

.trip-hero .hero-kicker {
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1.2rpx;
  font-weight: 600;
}

.trip-hero-title {
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 700;
}

.trip-hero-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 500;
}

.trip-hero-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.45;
}

.claim-panel {
  margin-top: 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 12rpx 34rpx rgba(17, 24, 39, 0.07);
}

.claim-kicker {
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.claim-title {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
}

.claim-options {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}

.claim-note {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(102, 114, 168, 0.08);
  color: #4B5565;
  font-size: 25rpx;
  line-height: 1.55;
}

.claim-option {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F7F8FC;
  border: 2rpx solid transparent;
}

.claim-option.active {
  background: rgba(102, 114, 168, 0.08);
  border-color: rgba(102, 114, 168, 0.34);
}

.claim-option-title {
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.claim-option-copy {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.claim-field {
  margin-top: 28rpx;
}

.claim-input {
  margin-top: 10rpx;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
  color: #1D2433;
  font-size: 27rpx;
  box-sizing: border-box;
}

.claim-submit {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.profile-upgrade {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.14);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 28rpx rgba(17, 24, 39, 0.055);
}

.profile-upgrade-title {
  color: #1D2433;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 700;
}

.profile-upgrade-copy {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.profile-upgrade-form {
  display: grid;
  grid-template-columns: 1fr 148rpx;
  gap: 12rpx;
  margin-top: 18rpx;
  align-items: center;
}

.profile-upgrade-open {
  margin: 18rpx 0 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 26rpx;
}

.profile-upgrade-open::after {
  border: none;
}

.profile-upgrade-input {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #F7F8FC;
  color: #1D2433;
  font-size: 26rpx;
  box-sizing: border-box;
}

.profile-upgrade-btn {
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 26rpx;
}

.profile-upgrade-btn::after {
  border: none;
}

.trip-next-card {
  position: relative;
  overflow: hidden;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 86% 0%, rgba(255, 255, 255, 0.20), transparent 36%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.17), rgba(255, 255, 255, 0.09));
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.18) inset,
    0 8rpx 22rpx rgba(17, 24, 39, 0.055);
}

.trip-next-label {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.trip-next-title {
  margin-top: 6rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 700;
}

.trip-next-meta {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 400;
}

.section-shell {
  margin-top: 36rpx;
}

.section-kicker {
  color: #9AA1B2;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1.2rpx;
  font-weight: 600;
}

.section-title {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.today-card-shell {
  margin-top: 30rpx;
}

.today-card-empty {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
  border: 1rpx solid rgba(31, 36, 51, 0.055);
}

.home-empty-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055);
}

.empty-title {
  color: #1D2433;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.empty-copy {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.p4-today-card {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 12rpx 34rpx rgba(17, 24, 39, 0.07),
    0 2rpx 8rpx rgba(17, 24, 39, 0.035);
}

.p4-today-card.compact {
  padding: 28rpx;
}

.p4-today-card::before {
  content: '';
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  pointer-events: none;
}

.p4-today-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.p4-today-labels {
  min-width: 0;
}

.p4-trip-label,
.p4-today-route {
  color: #7E8798;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 500;
}

.p4-today-title {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.p4-today-route {
  margin-top: 8rpx;
}

.p4-summary-route {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #F7F8FC;
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 650;
}

.p4-summary-times {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.p4-summary-time {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  gap: 16rpx;
  align-items: center;
}

.p4-summary-clock {
  color: #5B6596;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
}

.p4-summary-stop {
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
}

.p4-service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #F7F8FC;
}

.p4-service-label {
  color: #8A91A1;
  font-size: 20rpx;
  line-height: 1.3;
}

.p4-service-value {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 600;
}

.p4-timeline {
  margin-top: 24rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.055);
}

.p4-timeline-row {
  display: grid;
  grid-template-columns: 86rpx 16rpx 1fr;
  column-gap: 16rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(31, 36, 51, 0.045);
}

.p4-timeline-row:first-child {
  border-top: none;
}

.p4-timeline-time {
  color: #5B6596;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 700;
}

.p4-timeline-mark {
  width: 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 999rpx;
  background: #5B6596;
  box-shadow: 0 0 0 8rpx rgba(91, 101, 150, 0.10);
}

.p4-timeline-title {
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 650;
}

.p4-timeline-meta,
.p4-timeline-note {
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.p4-timeline-note {
  color: #8A91A1;
}

.p4-endpoint,
.p4-driver-note,
.p4-next-day,
.p4-advisor-line {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #F7F8FC;
}

.p4-endpoint-label {
  color: #8A91A1;
  font-size: 21rpx;
  line-height: 1.3;
}

.p4-endpoint-main {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 650;
}

.p4-endpoint-sub,
.p4-driver-note,
.p4-next-day,
.p4-advisor-line {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.p4-next-day {
  background: rgba(91, 101, 150, 0.08);
  color: #4F598B;
}

.p4-action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.p4-action-secondary,
.p4-action-primary {
  margin: 0;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  padding: 0 18rpx;
}

.p4-action-secondary {
  background: #FFFFFF;
  color: #5B6596;
  border: 1rpx solid #DDE4F3;
}

.p4-action-primary {
  background: #5B6596;
  color: #FFFFFF;
}

.p4-action-primary.single {
  grid-column: 1 / -1;
}

.p4-action-secondary::after,
.p4-action-primary::after {
  border: none;
}

.home-arrangement-card {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055);
}

.arrangement-title {
  color: #1D2433;
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 700;
}

.arrangement-main {
  margin-top: 12rpx;
  color: #2F394C;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 600;
}

.arrangement-sub,
.arrangement-helper {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.arrangement-helper {
  color: #8A91A1;
}

.arrangement-btn {
  margin: 22rpx 0 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #5B6596;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
}

.arrangement-btn.secondary {
  background: #FFFFFF;
  color: #5B6596;
  border: 1rpx solid #DDE4F3;
}

.arrangement-btn::after {
  border: none;
}

.body-text {
  color: #5F687A;
  font-size: 25rpx;
  line-height: 1.65;
  font-weight: 400;
}

.today-card,
.day-card,
.stay-card,
.service-card {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 12rpx 34rpx rgba(17, 24, 39, 0.07),
    0 2rpx 8rpx rgba(17, 24, 39, 0.035);
}

.today-card::before {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  pointer-events: none;
}

.day-card,
.stay-card,
.service-card {
  border-radius: 28rpx;
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.88) inset,
    0 8rpx 24rpx rgba(17, 24, 39, 0.045);
}

.today-header,
.stay-head,
.day-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.today-topline,
.day-meta,
.stay-meta {
  color: #7E8798;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 500;
}

.today-title,
.day-title,
.stay-title,
.service-title {
  margin-top: 8rpx;
  margin-bottom: 10rpx;
  color: #1D2433;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.timeline {
  margin-top: 24rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.055);
}

.timeline-item {
  display: grid;
  grid-template-columns: 72rpx 16rpx 1fr;
  column-gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(31, 36, 51, 0.045);
}

.timeline-item:first-child {
  border-top: none;
}

.timeline-time {
  color: #6D78A8;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 700;
}

.timeline-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.8), transparent 28%),
    #6D78A8;
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.5) inset,
    0 2rpx 5rpx rgba(109, 120, 168, 0.25);
}

.timeline-title {
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 600;
}

.timeline-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-status {
  flex: 0 0 auto;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 500;
}

.timeline-copy .body-text {
  margin-top: 4rpx;
  color: #677184;
  font-size: 24rpx;
  line-height: 1.5;
}

.transport-card,
.advisor-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, #FAFBFF 0%, #F5F7FC 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.86) inset,
    0 6rpx 18rpx rgba(17, 24, 39, 0.035);
}

.transport-kicker {
  color: #7E889A;
  font-size: 22rpx;
}

.transport-main {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 28rpx;
  font-weight: 600;
}

.transport-sub,
.service-sub {
  margin-top: 6rpx;
  color: #6E7788;
  font-size: 23rpx;
  line-height: 1.5;
}

.status-chip {
  flex: 0 0 auto;
  min-height: 44rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.status-pill {
  flex: 0 0 auto;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background:
    linear-gradient(180deg, #F7F8FD 0%, #EEF1F8 100%);
  color: #6D78A8;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 500;
  border: 1rpx solid rgba(109, 120, 168, 0.08);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.9) inset,
    0 2rpx 6rpx rgba(17, 24, 39, 0.035);
}

.status-pill.confirmed {
  background:
    linear-gradient(180deg, #F7F8FD 0%, #EEF1F8 100%);
  color: #6D78A8;
}

.status-chip.confirmed {
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
}

.status-chip.pending {
  background: rgba(216, 164, 81, 0.14);
  color: #B37A1E;
}

.status-chip.quoted {
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
}

.stack-list {
  display: grid;
  gap: 16rpx;
  margin-top: 16rpx;
}

.day-pill {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
  font-size: 22rpx;
}

.cta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 26rpx;
}

.cta-secondary {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6672A8;
  border: 1rpx solid #DDE4F3;
  font-size: 26rpx;
}

.cta-secondary::after,
.cta-primary::after {
  border: none;
}

.service-title {
  margin-top: 0;
  margin-bottom: 12rpx;
  font-size: 30rpx;
}

.benefit-panel {
  margin-top: 30rpx;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.88) inset,
    0 8rpx 24rpx rgba(17, 24, 39, 0.045);
}

.benefit-meta {
  margin-top: 10rpx;
  color: #6672A8;
  font-size: 24rpx;
}

.benefit-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #EDF1F7;
}

.benefit-row:first-of-type {
  margin-top: 12rpx;
}

.benefit-name {
  color: #182235;
  font-size: 27rpx;
  font-weight: 600;
}

.benefit-btn {
  margin-top: 16rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6672A8;
  border: 1rpx solid #DDE3F1;
  font-size: 26rpx;
}

.advisor-panel {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(102, 114, 168, 0.08);
  color: #5C6576;
  font-size: 24rpx;
  line-height: 1.7;
}

.transfer-card,
.charter-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055),
    0 2rpx 8rpx rgba(17, 24, 39, 0.025);
}

.transfer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.transfer-title {
  color: #1D2433;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 700;
}

.transfer-meta {
  margin-top: 8rpx;
  color: #7E8798;
  font-size: 23rpx;
  line-height: 1.4;
}

.route-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #F7F8FC;
}

.route-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 999rpx;
  background: #6672A8;
  box-shadow: 0 0 0 8rpx rgba(102, 114, 168, 0.10);
}

.route-text {
  min-width: 0;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
}

.route-arrow {
  color: #9AA1B2;
  font-size: 24rpx;
}

.request-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.field-label,
.price-label {
  color: #8A91A1;
  font-size: 21rpx;
  line-height: 1.3;
}

.field-value {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
}

.ops-card {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(102, 114, 168, 0.075);
}

.ops-title {
  color: #1D2433;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 600;
}

.ops-sub {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.55;
}

.detail-btn {
  margin-top: 20rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  padding: 0;
}

.detail-btn::after {
  border: none;
}

.quote-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.quote-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 6rpx 18rpx rgba(17, 24, 39, 0.035);
}

.quote-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.quote-title {
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.quote-sub,
.quote-profile,
.quote-meta,
.quote-detail,
.quote-expiry {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.quote-sub {
  margin-top: 6rpx;
}

.quote-profile {
  margin-top: 16rpx;
  color: #4F5A6E;
  font-weight: 500;
}

.quote-meta {
  margin-top: 6rpx;
}

.recommend-badge {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 600;
}

.price-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
}

.price-value {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 600;
}

.price-total {
  margin-top: 6rpx;
  color: #6672A8;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 700;
}

.quote-detail {
  margin-top: 14rpx;
}

.quote-detail.muted {
  margin-top: 4rpx;
  color: #8A91A1;
}

.quote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.quote-btn {
  flex: 0 0 auto;
  min-width: 174rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 24rpx;
}

.quote-btn::after {
  border: none;
}

.activity-list {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.06);
}

.activity-row {
  display: grid;
  grid-template-columns: 72rpx 14rpx 1fr;
  gap: 14rpx;
  align-items: center;
  padding: 8rpx 0;
}

.activity-time {
  color: #8A91A1;
  font-size: 22rpx;
}

.activity-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #A2AABD;
}

.activity-message {
  color: #5F687A;
  font-size: 23rpx;
  line-height: 1.45;
}

.charter-note {
  margin-top: 16rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.6;
}

.charter-segments {
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: #F7F8FC;
  padding: 8rpx 18rpx;
}

.segment-row {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(31, 36, 51, 0.055);
}

.segment-row:first-child {
  border-top: none;
}

.segment-time {
  color: #6672A8;
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 700;
}

.segment-title {
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
}

.segment-route {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}
