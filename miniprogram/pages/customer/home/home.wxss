@import "/styles/theme.wxss";

.trip-page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(102, 114, 168, 0.10), transparent 32%),
    linear-gradient(180deg, #F7F8FC 0%, #FFFFFF 100%);
}

.customer-loading-screen {
  min-height: calc(100vh - 48rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.customer-entry-splash {
  width: 100%;
  text-align: center;
  transform: translateY(-88rpx);
}

.customer-splash-logo {
  width: 460rpx;
  height: 170rpx;
  opacity: 0.92;
  filter: drop-shadow(0 16rpx 28rpx rgba(73, 82, 126, 0.20));
}

.customer-loading-line {
  width: 180rpx;
  height: 6rpx;
  margin: 46rpx auto 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.14);
}

.customer-loading-bar {
  width: 72rpx;
  height: 100%;
  border-radius: 999rpx;
  background: #6672A8;
  animation: customerLoadingSlide 1.4s ease-in-out infinite;
}

@keyframes customerLoadingSlide {
  0% { transform: translateX(-76rpx); opacity: 0.35; }
  50% { opacity: 1; }
  100% { transform: translateX(184rpx); opacity: 0.35; }
}

.trip-hero {
  position: relative;
  overflow: hidden;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  color: #FFFFFF;
  background:
    radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.26), transparent 34%),
    radial-gradient(circle at 100% 18%, rgba(255, 255, 255, 0.12), transparent 28%),
    linear-gradient(145deg, #6974AB 0%, #6672A8 56%, #4F598B 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 2rpx 4rpx rgba(255, 255, 255, 0.18) inset,
    0 -3rpx 10rpx rgba(0, 0, 0, 0.06) inset,
    0 14rpx 36rpx rgba(40, 48, 88, 0.16),
    0 4rpx 12rpx rgba(17, 24, 39, 0.07);
}

.trip-hero::before {
  content: '';
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.10),
    rgba(255, 255, 255, 0.42),
    rgba(255, 255, 255, 0.16)
  );
  pointer-events: none;
}

.trip-hero .hero-kicker {
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1.2rpx;
  font-weight: 600;
}

.trip-hero-title {
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 700;
}

.trip-hero-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 500;
}

.trip-hero-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.45;
}

.claim-panel {
  margin-top: 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 12rpx 34rpx rgba(17, 24, 39, 0.07);
}

.claim-kicker {
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.claim-title {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
}

.claim-options {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}

.claim-note {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(102, 114, 168, 0.08);
  color: #4B5565;
  font-size: 25rpx;
  line-height: 1.55;
}

.claim-option {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F7F8FC;
  border: 2rpx solid transparent;
}

.claim-option.active {
  background: rgba(102, 114, 168, 0.08);
  border-color: rgba(102, 114, 168, 0.34);
}

.claim-option-title {
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.claim-option-copy {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.claim-field {
  margin-top: 28rpx;
}

.claim-input {
  margin-top: 10rpx;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
  color: #1D2433;
  font-size: 27rpx;
  box-sizing: border-box;
}

.claim-submit {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.profile-upgrade {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(102, 114, 168, 0.14);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 28rpx rgba(17, 24, 39, 0.055);
}

.profile-upgrade-title {
  color: #1D2433;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 700;
}

.profile-upgrade-copy {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.profile-upgrade-form {
  display: grid;
  grid-template-columns: 1fr 148rpx;
  gap: 12rpx;
  margin-top: 18rpx;
  align-items: center;
}

.profile-upgrade-open {
  margin: 18rpx 0 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 26rpx;
}

.profile-upgrade-open::after {
  border: none;
}

.profile-upgrade-input {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #F7F8FC;
  color: #1D2433;
  font-size: 26rpx;
  box-sizing: border-box;
}

.profile-upgrade-btn {
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 26rpx;
}

.profile-upgrade-btn::after {
  border: none;
}

.trip-register-btn {
  position: relative;
  overflow: hidden;
  margin-top: 22rpx;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 86% 0%, rgba(255, 255, 255, 0.20), transparent 36%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.17), rgba(255, 255, 255, 0.09));
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.18) inset,
    0 8rpx 22rpx rgba(17, 24, 39, 0.055);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 700;
}

.trip-register-btn::after {
  border: none;
}

.trip-invite-hero.compact {
  padding: 26rpx 28rpx;
  min-height: 220rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 86% 0%, rgba(255, 255, 255, 0.22), transparent 35%),
    radial-gradient(circle at 16% 12%, rgba(255, 255, 255, 0.16), transparent 30%),
    linear-gradient(145deg, #6F7AB2 0%, #6672A8 56%, #4F598B 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.24) inset,
    0 18rpx 42rpx rgba(79, 89, 139, 0.24);
}

.trip-identity-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.trip-invite-hero.compact .hero-kicker {
  color: rgba(255, 255, 255, 0.84);
  font-size: 20rpx;
  letter-spacing: 1.2rpx;
}

.trip-invite-hero.compact .trip-invite-copy {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 540;
}

.trip-invite-hero.compact .trip-invite-title {
  margin-top: 10rpx;
  color: #FFFFFF;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 750;
}

.trip-invite-hero.compact .trip-invite-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.80);
  font-size: 23rpx;
  line-height: 1.42;
}

.trip-invite-hero.compact .trip-invite-route {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 620;
}

.trip-invite-hero.compact .trip-invite-sync {
  flex: 0 0 auto;
  margin-top: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 650;
}

.trip-invite-hero.compact .trip-invite-sync.muted {
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.78);
}

.section-shell {
  margin-top: 30rpx;
}

.section-kicker {
  color: #9AA1B2;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1.2rpx;
  font-weight: 600;
}

.section-title {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.today-card-shell {
  margin-top: 30rpx;
}

.today-card-empty {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
  border: 1rpx solid rgba(31, 36, 51, 0.055);
}

.home-empty-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055);
}

.empty-title {
  color: #1D2433;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.empty-sub {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.customer-summary-bar {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 18rpx;
  padding: 26rpx 28rpx;
  min-height: 220rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 86% 0%, rgba(255, 255, 255, 0.22), transparent 35%),
    radial-gradient(circle at 16% 12%, rgba(255, 255, 255, 0.16), transparent 30%),
    linear-gradient(145deg, #6F7AB2 0%, #6672A8 56%, #4F598B 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.24) inset,
    0 18rpx 42rpx rgba(79, 89, 139, 0.24);
}

.summary-main {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.summary-kicker {
  color: rgba(255, 255, 255, 0.84);
  font-size: 20rpx;
  line-height: 1.35;
  letter-spacing: 1.2rpx;
  font-weight: 760;
}

.summary-thanks {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 540;
}

.summary-title {
  margin-top: 10rpx;
  color: #FFFFFF;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 750;
}

.summary-meta,
.summary-trip-text,
.summary-note {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.80);
  font-size: 23rpx;
  line-height: 1.45;
}

.summary-trip-text {
  color: rgba(255, 255, 255, 0.92);
  font-weight: 600;
}

.summary-note {
  color: rgba(255, 255, 255, 0.72);
}

.summary-status {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 650;
}

.home-pane-shell {
  margin-top: 28rpx;
}

.home-pane-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 10rpx 28rpx rgba(17, 24, 39, 0.055);
}

.home-pane-tab {
  min-width: 0;
  height: 68rpx;
  border-radius: 999rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 68rpx;
  text-align: center;
  font-weight: 650;
}

.home-pane-tab.active {
  background: #5B6596;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(91, 101, 150, 0.24);
}

.home-pane-swiper {
  height: calc(100vh - 430rpx);
  min-height: 900rpx;
  margin-top: 12rpx;
}

.home-pane-scroll {
  height: 100%;
  box-sizing: border-box;
}

.home-pane-content {
  padding-bottom: 36rpx;
}

.progress-shell {
  margin-top: 24rpx;
}

.trip-day-swipe-zone {
  width: 100%;
}

.trip-day-motion {
  width: 100%;
  transform: translateZ(0);
  will-change: transform, opacity;
}

.daily-progress-strip,
.progress-strip {
  height: 154rpx;
  margin-top: 12rpx;
  padding: 18rpx 14rpx 12rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055);
  box-sizing: border-box;
  white-space: nowrap;
}

.daily-progress-track,
.progress-track {
  display: inline-flex;
  align-items: flex-start;
  min-width: 100%;
  height: 100%;
  padding: 12rpx 2rpx 0;
  box-sizing: border-box;
}

.daily-progress-node,
.progress-node {
  position: relative;
  flex: 0 0 auto;
  width: 140rpx;
  min-height: 92rpx;
  padding: 0 8rpx 2rpx;
  border-radius: 18rpx;
  text-align: center;
  box-sizing: border-box;
  transition: background-color 160ms ease, box-shadow 160ms ease;
}

.daily-progress-node::before,
.progress-node::before {
  content: '';
  position: absolute;
  left: -70rpx;
  right: 70rpx;
  top: 12rpx;
  height: 2rpx;
  background: #E6EAF2;
}

.daily-progress-node:first-child::before,
.progress-node:first-child::before {
  display: none;
}

.daily-progress-dot,
.progress-dot {
  width: 26rpx;
  height: 26rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid #D0D5DD;
  box-sizing: border-box;
}

.daily-progress-node.completed .daily-progress-dot,
.progress-node.completed .progress-dot {
  background: #E6EAF2;
  border-color: #CBD5E1;
}

.daily-progress-node.current .daily-progress-dot,
.progress-node.current .progress-dot {
  background: #12806F;
  border-color: #0E665A;
  box-shadow: 0 0 0 10rpx rgba(18, 128, 111, 0.12);
}

.daily-progress-node.today:not(.selected),
.progress-node.today:not(.selected) {
  background: rgba(18, 128, 111, 0.045);
  box-shadow: inset 0 0 0 1rpx rgba(18, 128, 111, 0.10);
}

.daily-progress-node.past:not(.selected) .daily-progress-dot,
.progress-node.past:not(.selected) .progress-dot {
  background: #F1F3F7;
  border-color: #D7DCE6;
}

.daily-progress-node.selected,
.progress-node.selected,
.daily-progress-node-hover {
  background: rgba(91, 101, 150, 0.07);
  box-shadow: inset 0 0 0 1rpx rgba(91, 101, 150, 0.14);
}

.daily-progress-node.selected .daily-progress-dot,
.progress-node.selected .progress-dot {
  background: #5B6596;
  border-color: #46507C;
  box-shadow: 0 0 0 10rpx rgba(91, 101, 150, 0.12);
}

.daily-progress-label,
.progress-label {
  margin-top: 10rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 600;
}

.daily-progress-node.current .daily-progress-label,
.progress-node.current .progress-label {
  color: #0E665A;
}

.daily-progress-node.past:not(.selected) .daily-progress-label,
.progress-node.past:not(.selected) .progress-label {
  color: #98A2B3;
}

.daily-progress-node.selected .daily-progress-label,
.progress-node.selected .progress-label {
  color: #46507C;
}

.daily-progress-date,
.daily-progress-sub {
  margin-top: 4rpx;
  color: #98A2B3;
  font-size: 21rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.daily-progress-sub {
  color: #667085;
}

.daily-progress-node.current .daily-progress-sub {
  color: #235E54;
  font-weight: 600;
}

.daily-progress-node.past:not(.selected) .daily-progress-date,
.daily-progress-node.past:not(.selected) .daily-progress-sub {
  color: #A7AFBD;
}

.daily-progress-node.selected .daily-progress-date,
.daily-progress-node.selected .daily-progress-sub {
  color: #3F4658;
  font-weight: 600;
}

.current-progress-summary {
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow: 0 8rpx 22rpx rgba(17, 24, 39, 0.045);
}

.current-progress-kicker {
  color: #6672A8;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 740;
}

.current-progress-meta {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 700;
}

.current-progress-route,
.current-progress-departure {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 540;
}

.current-progress-departure {
  color: #46507C;
  font-weight: 650;
}

.today-driver-card {
  margin-top: 0;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(248, 247, 255, 0.98) 0%, rgba(244, 246, 252, 0.96) 100%);
  border: 1rpx solid rgba(91, 101, 150, 0.12);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.88) inset,
    0 10rpx 24rpx rgba(17, 24, 39, 0.045);
}

.driver-shell {
  margin-top: 20rpx;
}

.driver-card-head,
.driver-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.driver-summary-main {
  flex: 1;
  min-width: 0;
}

.driver-summary-title {
  color: #5B6596;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 760;
}

.driver-summary-line {
  margin-top: 10rpx;
  color: #1D2433;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 720;
}

.driver-summary-line:first-child {
  margin-top: 0;
}

.driver-summary-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 540;
}

.driver-card-label {
  color: #5B6596;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 650;
}

.driver-card-time {
  margin-top: 8rpx;
  color: #5B6596;
  font-size: 46rpx;
  line-height: 1.08;
  font-weight: 780;
}

.driver-card-person {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(91, 101, 150, 0.08);
  border: 1rpx solid rgba(91, 101, 150, 0.08);
}

.driver-name {
  color: #1D2433;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
}

.driver-phone {
  margin-top: 6rpx;
  color: #4F598B;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
}

.driver-card-meta {
  margin-top: 18rpx;
  color: #1D2433;
