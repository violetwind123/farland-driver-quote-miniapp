<view wx:if="{{legacyHomeRedirecting}}" class="trip-page">
  <view class="customer-loading-screen">
    <view class="customer-entry-splash">
      <image class="customer-splash-logo" src="/assets/images/logo-farland-splash.png" mode="aspectFit" />
      <view class="customer-loading-line">
        <view class="customer-loading-bar"></view>
      </view>
      <view class="trip-invite-state-copy muted">正在打开手机行程单</view>
    </view>
  </view>
</view>

<view wx:else class="trip-page">
  <view wx:if="{{loading}}" class="customer-loading-screen">
    <view class="customer-entry-splash">
      <image class="customer-splash-logo" src="/assets/images/logo-farland-splash.png" mode="aspectFit" />
      <view class="customer-loading-line">
        <view class="customer-loading-bar"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{needsInviteClaim}}" class="claim-panel card-surface">
    <view class="claim-kicker">欢迎使用 Farland</view>
    <view class="claim-title">正在确认行程访问</view>

    <view class="claim-note">
      Farland 顾问已为您同步行程。系统将通过微信安全识别您的本次行程访问权限。
    </view>

    <button class="claim-submit" loading="{{claimingTemporaryAccess}}" bindtap="claimTemporaryAccess">查看本次行程</button>
  </view>

  <view wx:elif="{{tripInviteMode}}" class="trip-invite-view {{operatorInvitePreview ? 'operator-preview-active' : ''}}">
    <!-- 运营预览工具条独立占位，不遮挡客户卡片；内联行程单先使用其自身返回按钮。 -->
    <view wx:if="{{operatorInvitePreview && !sheetInlineOpen}}" class="op-preview-exit" bindtap="exitOperatorInvitePreview">
      <text class="op-preview-exit__label">运营预览</text>
      <text class="op-preview-exit__action">退出预览</text>
    </view>
    <!-- 手机版行程单内联查看:只一张图,不下载/不转发/不可长按保存;返回收起。底部 bottombar 由所在 tab 提供。 -->
    <view wx:if="{{sheetInlineOpen}}" class="sheet-inline">
      <view class="sheet-inline-bar">
        <view class="sheet-inline-back" bindtap="closeItinerarySheetInline">‹ 返回</view>
        <view class="sheet-inline-heading">手机版行程单</view>
        <view class="sheet-inline-spacer"></view>
      </view>
      <scroll-view scroll-y="{{true}}" class="sheet-inline-scroll">
        <image class="sheet-inline-img" src="{{tripInviteSheet.png_url}}" mode="widthFix" show-menu-by-longpress="{{false}}" />
      </scroll-view>
    </view>
    <view wx:if="{{operatorCustomerPreviewMode}}" class="operator-preview-banner card-surface">
      <view class="operator-preview-title">{{operatorCustomerPreviewMeta.operator_draft_preview ? '运营草稿预览' : '运营预览'}}</view>
      <view class="operator-preview-copy">
        {{operatorCustomerPreviewMeta.operator_draft_preview ? '该页面仅供运营核对，不会推送给客户。' : '当前页面模拟客户打开分享卡后的真实显示效果。'}}
      </view>
    </view>

    <view wx:if="{{tripInviteError}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-title">行程链接不可用</view>
      <view class="trip-invite-state-copy">{{tripInviteError}}</view>
      <view class="trip-invite-state-copy muted">请回到 Farland 客户群确认最新链接。</view>
    </view>

    <view wx:elif="{{tripInviteWaiting}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-kicker">Farland 行程</view>
      <view class="trip-invite-state-title">顾问正在核对行程安排</view>
      <view class="trip-invite-state-copy">{{tripInviteMessage}}</view>
      <view class="trip-invite-state-copy muted">如需调整，请在 Farland 客户群内沟通。</view>
      <button
        wx:if="{{operatorCustomerPreviewMode && operatorDraftPreviewPayload}}"
        class="trip-invite-preview-btn"
        bindtap="previewOperatorDraftFromWaiting"
      >预览行程草稿</button>
    </view>

    <!-- Layer 1:未正式发布但已有手机版行程单 → 只显查看草稿入口 -->
    <view wx:elif="{{tripInviteSheetDraft}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-kicker">FARLAND 手机版行程单</view>
      <view class="trip-invite-state-title">您的手机版行程单已生成</view>
      <view class="trip-invite-state-copy">点击查看行程单草稿；确认后 Farland 会为您发布正式行程。</view>
      <button class="cta-primary sheet-draft-btn" bindtap="openMobileItinerarySheet">查看手机行程单草稿</button>
    </view>

    <block wx:else>
      <view class="trip-hero three-a-hero">
        <image class="trip-hero__mark" src="/assets/images/farland-mark-white.png" mode="widthFix" />
        <view class="trip-hero__greet">感谢您使用 Farland 的服务</view>
        <view class="trip-hero__code">{{tripInviteTrip.displayTripNo || customerSummaryBar.trip_no || 'Farland 行程'}}</view>
        <view class="trip-hero__dates">{{tripInviteTrip.displayDateRange || customerSummaryBar.date_range_text}}{{(tripInviteTrip.displayDateRange || customerSummaryBar.date_range_text) && tripInviteTrip.progressTotalDays ? ' · ' : ''}}{{tripInviteTrip.progressTotalDays ? ('共 ' + tripInviteTrip.progressTotalDays + ' 天') : ''}}</view>
        <view wx:if="{{tripInviteTrip.displayCity || customerSummaryBar.city_route_text}}" class="trip-hero__route">{{tripInviteTrip.displayCity || customerSummaryBar.city_route_text}}</view>
        <view wx:if="{{operatorCustomerPreviewMode}}" class="trip-hero__status">运营预览</view>
      </view>

      <view class="data-source-row">
        <text class="k">车程</text>
        <image src="/assets/images/google-g.png" mode="aspectFit" />
        <text class="v">Google</text>
        <view class="div"></view>
        <text class="k">天气</text>
        <image src="/assets/images/noaa-logo.png" mode="aspectFit" class="round" />
        <text class="v">美国国家海洋和大气管理局</text>
      </view>

      <view wx:if="{{tripInviteCanSave && !operatorCustomerPreviewMode}}" class="profile-upgrade card-surface">
        <view>
          <view class="profile-upgrade-title">保存到我的 Farland 行程</view>
          <view class="profile-upgrade-copy">方便之后继续查看行程、酒店安排、司机信息和后续服务。</view>
        </view>
        <button wx:if="{{!tripInviteShowSaveForm}}" class="profile-upgrade-open" bindtap="openTripInviteSaveForm">保存行程</button>
        <view wx:else class="profile-upgrade-form">
          <input
            class="profile-upgrade-input"
            placeholder="称呼，例如：刘女士"
            value="{{tripInviteSaveName}}"
            bindinput="onTripInviteSaveNameInput"
          />
          <button class="profile-upgrade-btn" loading="{{tripInviteSaving}}" bindtap="saveTripInviteToProfile">保存</button>
        </view>
      </view>

      <view class="trip-day-swipe-zone" data-source="invite" bindtouchstart="onDaySurfaceTouchStart" bindtouchmove="onDaySurfaceTouchMove" bindtouchend="onDaySurfaceTouchEnd" bindtouchcancel="onDaySurfaceTouchEnd">
      <view wx:if="{{tripInviteTrip.progressNodes && tripInviteTrip.progressNodes.length > 1}}" class="section-shell">
        <view class="trip-progress-head">
          <text class="tp-kicker">TRIP</text>
          <text class="tp-title">行程进度</text>
          <text wx:if="{{tripInviteTrip.progressTotalDays > 6}}" class="tp-hint">滑动查看全程 {{tripInviteTrip.progressTotalDays}} 天 →</text>
        </view>
        <view class="trip-progress">
          <view class="cols">
            <view class="track" style="left: {{tripInviteTrip.progressTrackInset}}; right: {{tripInviteTrip.progressTrackInset}}"></view>
            <view class="track-done" style="left: {{tripInviteTrip.progressTrackInset}}; width: {{tripInviteTrip.progressDonePct}}"></view>
            <view wx:for="{{tripInviteTrip.progressNodes}}" wx:key="node_id" class="col {{item.hasDateGapBefore ? 'has-date-gap' : ''}}" data-source="invite" data-day-no="{{item.day_no}}" bindtap="selectTripProgressDay" hover-class="daily-progress-node-hover">
              <view class="dot {{item.state === 'today' ? 'today' : (item.state === 'past' ? '' : 'future')}}"></view>
              <view wx:if="{{item.state === 'today'}}" class="today-card">
                <text class="day">{{item.label}}</text>
                <text class="city">{{item.location_summary}}</text>
              </view>
              <block wx:else>
                <text class="day {{item.state === 'past' ? 'past' : ''}}">{{item.label}}</text>
                <text class="city {{item.state === 'past' ? 'past' : ''}}">{{item.location_summary}}</text>
              </block>
            </view>
          </view>
        </view>
      </view>

      <view class="trip-day-motion" style="{{inviteDaySwipeStyle}}">
      <view wx:if="{{tripInviteTrip.todayOverviewCard}}" id="customer-today-itinerary-section" class="section-shell today-card-shell">
        <view class="p4-today-card three-a-card card-surface">
          <view class="day-head-row">
            <view class="day-head-left">
              <view class="day-head-title">
                <text class="date">{{tripInviteTrip.todayOverviewCard.dateTitleText || tripInviteTrip.todayOverviewCard.overviewSubtitle || tripInviteTrip.todayOverviewCard.dateRouteText}}</text>
                <view wx:if="{{tripInviteTrip.todayOverviewCard.weatherText}}" class="weather-inline">
                  <view class="wx-ico wx-{{tripInviteTrip.todayOverviewCard.weatherKind}}"></view>
                  <text>{{tripInviteTrip.todayOverviewCard.weatherText}}</text>
                </view>
              </view>
              <view wx:if="{{tripInviteTrip.todayOverviewCard.dayStats && tripInviteTrip.todayOverviewCard.dayStats.visible}}" class="day-stats">
                <text class="label">全天行程</text>
                <text wx:if="{{tripInviteTrip.todayOverviewCard.dayStats.driveText}}" class="num">{{tripInviteTrip.todayOverviewCard.dayStats.driveText}}</text>
                <view wx:if="{{tripInviteTrip.todayOverviewCard.dayStats.driveText && tripInviteTrip.todayOverviewCard.dayStats.distanceText}}" class="div"></view>
                <text wx:if="{{tripInviteTrip.todayOverviewCard.dayStats.distanceText}}" class="num">{{tripInviteTrip.todayOverviewCard.dayStats.distanceText}}</text>
              </view>
            </view>
            <view wx:if="{{tripInviteTrip.todayOverviewCard.departureTime || tripInviteTrip.todayOverviewCard.startTime}}" class="day-head-right">
              <view class="depart-time">{{tripInviteTrip.todayOverviewCard.departureTime || tripInviteTrip.todayOverviewCard.startTime}}</view>
              <view class="depart-cap">{{tripInviteTrip.todayOverviewCard.departureCaption || '预计出发'}}</view>
            </view>
          </view>

          <view class="timeline three-a-timeline">
            <block wx:for="{{tripInviteTrip.todayOverviewCard.displayRouteStops || tripInviteTrip.todayOverviewCard.routeStops}}" wx:key="id">
              <view class="timeline-step {{item.connectorTravelMeta && item.connectorTravelMeta.hasContent ? 'has-segment' : 'no-segment'}} {{item.hasTail ? 'has-tail' : 'is-last'}} {{item.timelineTitleLong ? 'long-title' : ''}} {{item.detailText ? 'has-detail' : ''}}">
              <view class="stop-row">
                <view class="time-col">
                  <view class="t {{item.nodeClass === 'depart' ? 'depart' : ''}}">{{item.time}}</view>
                  <view class="cap">{{item.cap || (index === 0 ? '出发' : '到达')}}</view>
                </view>
                <view class="node-col">
                  <view class="node {{item.nodeClass}}"></view>
                  <view wx:if="{{item.hasTail}}" class="link"></view>
                </view>
                <view class="stop-body">
                  <view class="title">{{item.title}}<text wx:if="{{item.hasChange}}" class="chg-badge">时间有变</text></view>
                  <view wx:if="{{item.subtitle}}" class="sub">{{item.subtitle}}</view>
                  <view wx:if="{{item.detailText}}" class="pickup-detail">{{item.detailText}}</view>
                </view>
              </view>
              <view wx:if="{{item.connectorTravelMeta && item.connectorTravelMeta.hasContent}}" class="seg-row">
                <view class="time-col"></view>
                <view class="node-col"><view class="link"></view></view>
                <view class="tag-slot">
                  <view class="drive-tag">
                    <text wx:if="{{item.connectorTravelMeta.icon_label}}" class="segment-mode-label">{{item.connectorTravelMeta.icon_label}}</text>
                    <text wx:if="{{item.connectorTravelMeta.driveTagText}}" class="dist">{{item.connectorTravelMeta.driveTagText}}</text>
                    <text wx:if="{{item.connectorTravelMeta.traffic_text}}" class="traffic {{item.connectorTravelMeta.traffic_class}}">{{item.connectorTravelMeta.traffic_text}}</text>
                  </view>
                </view>
              </view>
              </view>
            </block>
          </view>
          <view wx:if="{{tripInviteTrip.todayOverviewCard.overviewCanExpand}}" class="today-fold-line" data-source="invite" bindtap="toggleTodayOverviewExpanded">{{inviteTodayOverviewExpanded ? tripInviteTrip.todayOverviewCard.overviewCollapseLabel : tripInviteTrip.todayOverviewCard.overviewExpandLabel}}</view>
          <view wx:elif="{{tripInviteTrip.todayOverviewCard.nodeCount > 3}}" class="p4-summary-count">当日共 {{tripInviteTrip.todayOverviewCard.nodeCount}} 个行程节点</view>
          <view class="day-card-actions">
            <button class="dca-btn dca-btn--outline" bindtap="openMobileItinerarySheet">查看整体行程</button>
            <button class="dca-btn dca-btn--filled" data-source="invite" data-day-no="{{tripInviteTrip.todayOverviewCard.day_no || tripInviteTrip.todayOverviewCard.dayNo}}" bindtap="openTripDayDetail">查看当日行程</button>
          </view>
        </view>
      </view>

      <view wx:if="{{tripInviteTrip.todayDriverCard || tripInviteTrip.todayHotelCard}}" class="section-shell combo-shell">
        <view class="combo-card card-surface">
          <view wx:if="{{tripInviteTrip.todayDriverCard}}" class="combo-row">
            <view class="combo-label">今日用车</view>
            <view class="combo-value-wrap">
              <view class="combo-value">{{tripInviteTrip.todayDriverCard.comboValue || tripInviteTrip.todayDriverCard.vehicleLine || '车辆待确认'}}</view>
              <view wx:if="{{tripInviteTrip.todayDriverCard.comboHelper || tripInviteTrip.todayDriverCard.helperText}}" class="combo-helper">{{tripInviteTrip.todayDriverCard.comboHelper || tripInviteTrip.todayDriverCard.helperText}}</view>
            </view>
            <view wx:if="{{tripInviteTrip.todayDriverCard.statusText}}" class="combo-chip {{tripInviteTrip.todayDriverCard.statusClass}}"><view class="dot"></view>{{tripInviteTrip.todayDriverCard.statusText}}</view>
            <view wx:if="{{tripInviteTrip.todayDriverCard.showPhone}}" class="combo-row__phone" data-phone="{{tripInviteTrip.todayDriverCard.phone}}" bindtap="callPublishedTripDriver">拨</view>
          </view>
          <view wx:if="{{tripInviteTrip.todayHotelCard}}" class="combo-row combo-row--divider" bindtap="openTripInviteHotelDetail">
            <view class="combo-label">今晚住宿</view>
            <view class="combo-value-wrap">
              <view class="combo-value">{{tripInviteTrip.todayHotelCard.comboValue || tripInviteTrip.todayHotelCard.name}}</view>
              <view wx:if="{{tripInviteTrip.todayHotelCard.metaText}}" class="combo-helper">{{tripInviteTrip.todayHotelCard.metaText}}</view>
            </view>
            <view class="combo-chevron">›</view>
          </view>
        </view>
      </view>
      </view>
      </view>

      <view wx:if="{{tripInviteTrip.visitCards && tripInviteTrip.visitCards.length}}" class="section-shell visit-shell">
        <view class="section-kicker gold">CAMPUS VISIT</view>
        <view class="section-title">您的访校安排</view>
        <view wx:for="{{tripInviteTrip.visitCards}}" wx:key="id" class="visit-card card-surface">
          <view class="visit-hero">
            <view class="visit-hero-watermark">{{item.school_name_en}}</view>
            <view class="visit-hero-badges">
              <view wx:if="{{item.day_badge_text}}" class="visit-day-badge">{{item.day_badge_text}}</view>
              <view class="status-chip confirmed-solid">已确认</view>
            </view>
            <view class="visit-hero-title">{{item.school_name}}{{item.visit_type_text ? (' · ' + item.visit_type_text) : ''}}</view>
          </view>
          <view class="visit-body">
            <view class="visit-time-row">
              <view class="visit-time-big">{{item.startTimeText}}</view>
              <view wx:if="{{item.timeRangeText}}" class="visit-time-range">{{item.timeRangeText}}</view>
              <view wx:if="{{item.weatherText}}" class="weather-inline visit-weather"><view class="wx-ico wx-{{item.weatherKind}}"></view>{{item.weatherText}}</view>
            </view>
            <view wx:if="{{item.meeting_point_name}}" class="visit-info-row">
              <view class="visit-info-label">集合</view>
              <view class="visit-info-value">{{item.meeting_point_name}}{{item.meeting_point_addr_en ? (' · ' + item.meeting_point_addr_en) : ''}}</view>
            </view>
            <view wx:if="{{item.arriveText}}" class="visit-info-row">
              <view class="visit-info-label">到达</view>
              <view class="visit-info-value">{{item.arriveText}}</view>
            </view>
          </view>
        </view>
        <view class="visit-tail-note">其余学校确认后会出现在这里，顾问会第一时间通知您</view>
        <view class="weather-source"><text>天气数据来源 NOAA / NWS 与 Open-Meteo</text></view>
      </view>
    </block>
  </view>

  <block wx:else>
    <view wx:if="{{operatorCustomerPreviewMode}}" class="operator-preview-banner card-surface">
      <view class="operator-preview-title">{{operatorCustomerPreviewMeta.operator_draft_preview ? '运营草稿预览' : '运营预览'}}</view>
      <view class="operator-preview-copy">
        {{operatorCustomerPreviewMeta.operator_draft_preview ? '该页面仅供运营核对，不会推送给客户。' : '当前为已发布客户版本预览。'}}
      </view>
    </view>

    <view wx:if="{{showProfileUpgrade}}" class="profile-upgrade card-surface">
      <view>
        <view class="profile-upgrade-title">保存到我的 Farland 行程</view>
        <view class="profile-upgrade-copy">保存后，本微信可继续查看后续服务安排与历史行程。</view>
      </view>
      <button wx:if="{{!showProfileUpgradeForm}}" class="profile-upgrade-open" bindtap="openProfileUpgradeForm">注册并保存</button>
      <view wx:else class="profile-upgrade-form">
        <input
          class="profile-upgrade-input"
          placeholder="称呼，例如：刘女士"
          value="{{profileUpgradeName}}"
          bindinput="onProfileUpgradeNameInput"
        />
        <button class="profile-upgrade-btn" loading="{{claimSubmitting}}" bindtap="submitInviteClaim">保存</button>
      </view>
    </view>

    <view wx:if="{{!inviteMode && customerSummaryBar && customerSummaryBar.visible && !showHomeEmpty}}" class="trip-hero three-a-hero">
      <image class="trip-hero__mark" src="/assets/images/farland-mark-white.png" mode="widthFix" />
      <view class="trip-hero__greet">感谢您使用 Farland 的服务</view>
      <view class="trip-hero__code">{{customerSummaryBar.trip_no || customerSummaryBar.display_title || 'Farland 行程'}}</view>
      <view class="trip-hero__dates">{{customerSummaryBar.date_range_text}}{{customerSummaryBar.date_range_text && tripProgress.progressTotalDays ? ' · ' : ''}}{{tripProgress.progressTotalDays ? ('共 ' + tripProgress.progressTotalDays + ' 天') : ''}}</view>
      <view wx:if="{{customerSummaryBar.city_route_text}}" class="trip-hero__route">{{customerSummaryBar.city_route_text}}</view>
      <view wx:if="{{operatorCustomerPreviewMode}}" class="trip-hero__status">运营预览</view>
    </view>

    <view wx:if="{{!inviteMode && customerSummaryBar && customerSummaryBar.visible && !showHomeEmpty}}" class="data-source-row">
      <text class="k">车程</text>
      <image src="/assets/images/google-g.png" mode="aspectFit" />
      <text class="v">Google</text>
      <view class="div"></view>
      <text class="k">天气</text>
      <image src="/assets/images/noaa-logo.png" mode="aspectFit" class="round" />
      <text class="v">美国国家海洋和大气管理局</text>
    </view>

    <view wx:if="{{showHomeEmpty}}" class="home-empty-card card-surface">
      <view class="empty-title">暂无行程安排</view>
      <view class="empty-sub">如需调整，请在 Farland 客户群内沟通。</view>
    </view>

    <view wx:if="{{useHomePaneSwiper && !showHomeEmpty}}" class="home-pane-shell">
      <view class="home-pane-tabs card-surface">
        <view class="home-pane-tab {{homePaneIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="switchHomePane">包车行程</view>
        <view class="home-pane-tab {{homePaneIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="switchHomePane">临时用车</view>
      </view>

      <swiper class="home-pane-swiper" current="{{homePaneIndex}}" duration="260" disable-touch="{{true}}" bindchange="onHomePaneChange">
        <swiper-item>
          <scroll-view class="home-pane-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="home-pane-content">
              <view class="trip-day-swipe-zone" data-source="home" bindtouchstart="onDaySurfaceTouchStart" bindtouchmove="onDaySurfaceTouchMove" bindtouchend="onDaySurfaceTouchEnd" bindtouchcancel="onDaySurfaceTouchEnd">
              <view wx:if="{{tripProgress && tripProgress.visible}}" class="section-shell progress-shell">
                <view class="trip-progress-head">
                  <text class="tp-kicker">TRIP</text>
                  <text class="tp-title">行程进度</text>
                  <text wx:if="{{tripProgress.progressTotalDays > 6}}" class="tp-hint">滑动查看全程 {{tripProgress.progressTotalDays}} 天 →</text>
                </view>
                <view class="trip-progress">
                  <view class="cols">
                    <view class="track" style="left: {{tripProgress.progressTrackInset}}; right: {{tripProgress.progressTrackInset}}"></view>
                    <view class="track-done" style="left: {{tripProgress.progressTrackInset}}; width: {{tripProgress.progressDonePct}}"></view>
                    <view wx:for="{{tripProgress.nodes}}" wx:key="node_id" class="col {{item.hasDateGapBefore ? 'has-date-gap' : ''}}" data-source="home" data-day-no="{{item.day_no}}" bindtap="selectTripProgressDay" hover-class="daily-progress-node-hover">
                      <view class="dot {{item.state === 'today' ? 'today' : (item.state === 'past' ? '' : 'future')}}"></view>
                      <view wx:if="{{item.state === 'today'}}" class="today-card">
                        <text class="day">{{item.label}}</text>
                        <text class="city">{{item.location_summary || item.short_location || item.shortLocation}}</text>
                      </view>
                      <block wx:else>
                        <text class="day {{item.state === 'past' ? 'past' : ''}}">{{item.label}}</text>
                        <text class="city {{item.state === 'past' ? 'past' : ''}}">{{item.location_summary || item.short_location || item.shortLocation}}</text>
                      </block>
                    </view>
                  </view>
                </view>
              </view>

              <view class="trip-day-motion" style="{{homeDaySwipeStyle}}">
              <view wx:if="{{todayCard}}" id="customer-today-itinerary-section" class="section-shell today-card-shell">
                <view class="p4-today-card three-a-card card-surface">
                  <view class="day-head-row">
                    <view class="day-head-left">
                      <view class="day-head-title">
                        <text class="date">{{todayCard.dateTitleText || todayCard.overviewSubtitle || todayCard.dateRouteText}}</text>
                        <view wx:if="{{todayCard.weatherText}}" class="weather-inline">
                          <view class="wx-ico wx-{{todayCard.weatherKind}}"></view>
                          <text>{{todayCard.weatherText}}</text>
                        </view>
                      </view>
                      <view wx:if="{{todayCard.dayStats && todayCard.dayStats.visible}}" class="day-stats">
