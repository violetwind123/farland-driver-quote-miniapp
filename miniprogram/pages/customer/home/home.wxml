<view class="trip-page">
  <button wx:if="{{operatorPreview}}" class="operator-back-btn" bindtap="backToOperatorCenter">运营中心</button>

  <view wx:if="{{loading}}" class="empty-state">{{tripInviteMode ? '正在加载 Farland 行程...' : '正在加载您的行程...'}}</view>

  <view wx:elif="{{needsInviteClaim}}" class="claim-panel card-surface">
    <view class="claim-kicker">欢迎使用 Farland</view>
    <view class="claim-title">正在确认行程访问</view>

    <view class="claim-note">
      Farland 顾问已为您同步行程。系统将通过微信安全识别您的本次行程访问权限。
    </view>

    <button class="claim-submit" loading="{{claimingTemporaryAccess}}" bindtap="claimTemporaryAccess">查看本次行程</button>
  </view>

  <view wx:elif="{{tripInviteMode}}" class="trip-invite-view">
    <view wx:if="{{tripInviteError}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-title">行程链接不可用</view>
      <view class="trip-invite-state-copy">{{tripInviteError}}</view>
      <button class="arrangement-btn secondary" bindtap="contactAdvisor">联系顾问</button>
    </view>

    <view wx:elif="{{tripInviteWaiting}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-kicker">Farland 行程</view>
      <view class="trip-invite-state-title">顾问正在核对行程安排</view>
      <view class="trip-invite-state-copy">{{tripInviteMessage}}</view>
      <button class="arrangement-btn secondary" bindtap="contactAdvisor">联系顾问</button>
    </view>

    <block wx:else>
      <view wx:if="{{operatorCustomerPreviewMode}}" class="operator-preview-banner card-surface">
        <view class="operator-preview-title">运营预览</view>
        <view class="operator-preview-copy">
          {{operatorCustomerPreviewMeta.customer_would_see === 'published' ? '当前预览已发布客户版本。' : '当前预览为未发布草稿，客户真实打开时仍会看到等待页。'}}
        </view>
      </view>

      <view class="trip-invite-hero card-surface">
        <view class="section-kicker hero-kicker">Farland 行程</view>
        <view class="trip-invite-title">{{tripInviteTrip.displayTitle}}</view>
        <view wx:if="{{tripInviteTrip.displayTripNo || tripInviteTrip.displayDateRange}}" class="trip-invite-meta">
          {{tripInviteTrip.displayTripNo}}{{tripInviteTrip.displayTripNo && tripInviteTrip.displayDateRange ? ' · ' : ''}}{{tripInviteTrip.displayDateRange}}
        </view>
        <view wx:if="{{tripInviteTrip.displayCity}}" class="trip-invite-route">{{tripInviteTrip.displayCity}}</view>
        <view wx:if="{{tripInviteTrip.displaySummary}}" class="trip-invite-copy">{{tripInviteTrip.displaySummary}}</view>
        <view wx:if="{{operatorCustomerPreviewMode}}" class="trip-invite-sync muted">运营预览，不写入客户档案</view>
        <view wx:elif="{{tripInviteAutoSaved || tripInviteAlreadySaved}}" class="trip-invite-sync">已同步到我的 Farland 行程</view>
        <view wx:else class="trip-invite-sync muted">临时查看本次行程</view>
      </view>

      <view wx:if="{{tripInviteCanSave}}" class="profile-upgrade card-surface">
        <view>
          <view class="profile-upgrade-title">保存到我的 Farland 行程</view>
          <view class="profile-upgrade-copy">方便之后继续查看行程、酒店安排、司机信息和后续服务。</view>
        </view>
        <button wx:if="{{!tripInviteShowSaveForm}}" class="profile-upgrade-open" bindtap="openTripInviteSaveForm">保存行程</button>
        <view wx:else class="profile-upgrade-form">
          <input
            class="profile-upgrade-input"
            placeholder="称呼，例如：王女士"
            value="{{tripInviteSaveName}}"
            bindinput="onTripInviteSaveNameInput"
          />
          <button class="profile-upgrade-btn" loading="{{tripInviteSaving}}" bindtap="saveTripInviteToProfile">保存</button>
        </view>
      </view>

      <view class="section-shell">
        <view class="section-kicker">ITINERARY</view>
        <view class="section-title">每日行程</view>
        <view wx:if="{{!tripInviteTrip.hasDays}}" class="today-card-empty">Farland 顾问正在补充每日行程细节。</view>
        <view wx:else class="trip-invite-day-list">
          <view wx:for="{{tripInviteTrip.days}}" wx:key="id" class="trip-invite-day card-surface">
            <view class="trip-invite-day-head">
              <view>
                <view class="trip-invite-day-kicker">Day {{item.dayNo}}</view>
                <view class="trip-invite-day-title">{{item.title}}</view>
              </view>
              <view class="trip-invite-day-date">{{item.weekday}}{{item.weekday && item.date ? ' · ' : ''}}{{item.date}}</view>
            </view>
            <view wx:if="{{item.city || item.summary}}" class="trip-invite-day-copy">{{item.city}}{{item.city && item.summary ? ' · ' : ''}}{{item.summary}}</view>
            <view wx:if="{{item.startTime}}" class="trip-invite-day-start">预计出发：{{item.startTime}}</view>
            <view wx:if="{{item.hotelBadge || item.transportBadge}}" class="trip-invite-badges">
              <view wx:if="{{item.hotelBadge}}" class="trip-invite-badge">酒店：{{item.hotelBadge}}</view>
              <view wx:if="{{item.transportBadge}}" class="trip-invite-badge">用车：{{item.transportBadge}}</view>
            </view>

            <view wx:if="{{item.timelineItems.length}}" class="trip-invite-timeline">
              <view wx:for="{{item.timelineItems}}" wx:for-item="node" wx:key="id" class="trip-invite-node">
                <view class="trip-invite-node-time">{{node.time || '待定'}}</view>
                <view class="trip-invite-node-dot"></view>
                <view class="trip-invite-node-copy">
                  <view class="trip-invite-node-title">{{node.title}}</view>
                  <view wx:if="{{node.location}}" class="trip-invite-node-sub">{{node.location}}</view>
                  <view wx:if="{{node.driveText || node.trafficText}}" class="trip-invite-node-sub">{{node.driveText}}{{node.driveText && node.trafficText ? ' · ' : ''}}{{node.trafficText}}</view>
                  <view wx:if="{{node.note}}" class="trip-invite-node-note">{{node.note}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{tripInviteTrip.hasHotels}}" class="section-shell">
        <view class="section-kicker">HOTEL</view>
        <view class="section-title">酒店安排</view>
        <view class="stack-list">
          <view wx:for="{{tripInviteTrip.hotels}}" wx:key="id" class="trip-invite-info-card card-surface">
            <view class="trip-invite-info-title">{{item.name}}</view>
            <view wx:if="{{item.dateText}}" class="trip-invite-info-meta">{{item.dateText}}</view>
            <view wx:if="{{item.city || item.address}}" class="trip-invite-info-copy">{{item.city}}{{item.city && item.address ? ' · ' : ''}}{{item.address}}</view>
            <view wx:if="{{item.note}}" class="trip-invite-info-note">{{item.note}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{tripInviteTrip.hasFlights}}" class="section-shell">
        <view class="section-kicker">FLIGHT</view>
        <view class="section-title">航班安排</view>
        <view class="stack-list">
          <view wx:for="{{tripInviteTrip.flights}}" wx:key="id" class="trip-invite-info-card card-surface">
            <view class="trip-invite-info-title">{{item.flightNo}}</view>
            <view wx:if="{{item.route}}" class="trip-invite-info-meta">{{item.route}}</view>
            <view wx:if="{{item.timeText}}" class="trip-invite-info-copy">{{item.timeText}}</view>
            <view wx:if="{{item.note}}" class="trip-invite-info-note">{{item.note}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{tripInviteTrip.hasTransports}}" class="section-shell">
        <view class="section-kicker">TRANSPORT</view>
        <view class="section-title">用车安排</view>
        <view class="stack-list">
          <view wx:for="{{tripInviteTrip.transports}}" wx:key="id" class="trip-invite-info-card card-surface">
            <view class="trip-invite-info-title">{{item.title}}</view>
            <view wx:if="{{item.meta}}" class="trip-invite-info-meta">{{item.meta}}</view>
            <view wx:if="{{item.note}}" class="trip-invite-info-copy">{{item.note}}</view>
          </view>
        </view>
      </view>

      <view class="advisor-panel trip-invite-advisor">
        <view>{{tripInviteTrip.advisorName || 'Farland 顾问'}}已为您整理本次行程。如需调整或确认细节，请联系顾问。</view>
        <button class="arrangement-btn secondary" bindtap="contactAdvisor">联系顾问</button>
      </view>
    </block>
  </view>

  <block wx:else>
    <view wx:if="{{operatorCustomerPreviewMode}}" class="operator-preview-banner card-surface">
      <view class="operator-preview-title">运营预览</view>
      <view class="operator-preview-copy">
        {{operatorCustomerPreviewMeta.customer_would_see === 'published' ? '当前为已发布客户版本预览。' : '当前为未发布草稿预览，客户真实打开时仍会看到等待页。'}}
      </view>
    </view>

    <view wx:if="{{showProfileUpgrade}}" class="profile-upgrade card-surface">
      <view>
        <view class="profile-upgrade-title">保存到我的 Farland 行程</view>
        <view class="profile-upgrade-copy">保存后，本微信可继续查看后续服务安排与历史行程。</view>
      </view>
      <button wx:if="{{!showProfileUpgradeForm}}" class="profile-upgrade-open" bindtap="openProfileUpgradeForm">注册并保存</button>
      <view wx:else class="profile-upgrade-form">
        <input
          class="profile-upgrade-input"
          placeholder="称呼，例如：王女士"
          value="{{profileUpgradeName}}"
          bindinput="onProfileUpgradeNameInput"
        />
        <button class="profile-upgrade-btn" loading="{{claimSubmitting}}" bindtap="submitInviteClaim">保存</button>
      </view>
    </view>

    <view class="trip-hero card-surface">
      <view class="section-kicker hero-kicker">我的行程</view>
      <view class="trip-hero-title">{{profile.name || '我的行程'}}</view>
      <view class="trip-hero-meta">{{profile.member_level}}{{profile.points_balance ? ' · ' + profile.points_balance + ' 积分' : ''}}</view>
      <view wx:if="{{profile.subtitle}}" class="trip-hero-subtitle">{{profile.subtitle}}</view>
      <button wx:if="{{!operatorCustomerPreviewMode}}" class="trip-register-btn" bindtap="registerCustomerProfile">
        {{currentBindMode === 'farland_profile' ? '已绑定当前微信' : (inviteMode ? '注册并保存' : '注册 Farland 行程')}}
      </button>
    </view>

    <view wx:if="{{showHomeEmpty}}" class="home-empty-card card-surface">
      <view class="empty-title">暂无行程安排</view>
      <button class="arrangement-btn secondary" bindtap="contactAdvisor">联系顾问</button>
    </view>

    <view wx:if="{{!inviteMode && progressStrip && !showHomeEmpty}}" class="section-shell progress-shell">
      <view class="section-kicker">TRIP</view>
      <view class="section-title">行程进度</view>
      <scroll-view class="progress-strip card-surface" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="progress-track">
          <view wx:for="{{progressStrip.nodes}}" wx:key="node_id" class="progress-node {{item.status}}">
            <view class="progress-dot"></view>
            <view class="progress-label">{{item.label}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{!inviteMode && todayDriverCard && !showHomeEmpty}}" class="section-shell driver-shell">
      <view class="section-kicker">SERVICE</view>
      <view class="section-title">{{todayDriverCard.title}}</view>
      <view class="today-driver-card card-surface">
        <view class="driver-card-head">
          <view>
            <view class="driver-card-label">出发时间</view>
            <view class="driver-card-time">{{todayDriverCard.departureTime}}</view>
          </view>
          <view class="status-chip {{todayDriverCard.statusClass}}">{{todayDriverCard.statusText}}</view>
        </view>

        <view wx:if="{{todayDriverCard.driver}}" class="driver-card-person">
          <view class="driver-name">{{todayDriverCard.driver.name || '司机待同步'}}</view>
          <view class="driver-phone">{{todayDriverCard.driver.phone || '电话待同步'}}</view>
        </view>

        <view class="driver-card-meta">{{todayDriverCard.vehicleSummary}}</view>
        <view wx:if="{{todayDriverCard.partySummary}}" class="driver-card-sub">{{todayDriverCard.partySummary}}</view>
        <view wx:if="{{todayDriverCard.helperText}}" class="driver-card-helper">{{todayDriverCard.helperText}}</view>

        <button wx:if="{{todayDriverCard.actionType === 'advisor'}}" class="arrangement-btn" bindtap="contactAdvisor">{{todayDriverCard.actionLabel}}</button>
        <button
          wx:elif="{{todayDriverCard.actionType === 'transfer'}}"
          class="arrangement-btn"
          data-request-id="{{todayDriverCard.requestId}}"
          bindtap="viewTransferDetail"
        >{{todayDriverCard.actionLabel}}</button>
        <button wx:else class="arrangement-btn" bindtap="openTodayDetail">{{todayDriverCard.actionLabel}}</button>
      </view>
    </view>

    <view wx:if="{{!inviteMode && todayCard && !showHomeEmpty}}" class="section-shell today-card-shell">
      <view class="section-kicker">TODAY</view>
      <view class="section-title">今日行程</view>
      <view class="p4-today-card compact card-surface">
        <view class="p4-today-head">
          <view class="p4-today-labels">
            <view class="p4-trip-label">{{todayCard.dayLabel}}</view>
            <view class="p4-today-title">{{todayCard.weekday}} {{todayCard.date}}</view>
            <view class="p4-today-route">{{todayCard.dateRouteText}}</view>
          </view>
          <view class="status-pill confirmed">{{todayCard.status_text}}</view>
        </view>

        <view class="p4-summary-route">{{todayCard.city_summary}}</view>

        <view class="p4-summary-times">
          <view wx:for="{{todayCard.routeStops}}" wx:key="id" class="p4-summary-time">
            <view class="p4-summary-clock">{{item.time}}</view>
            <view class="p4-summary-stop">{{item.title}}</view>
          </view>
        </view>

        <view class="p4-action-row">
          <button class="p4-action-primary single" bindtap="openTodayDetail">查看今日行程</button>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode && !todayCard && todayItinerary && !showHomeEmpty}}" class="section-shell">
      <view class="section-kicker">今日</view>
      <view class="section-title">今日行程</view>
      <view class="today-card card-surface">
        <view class="today-header">
          <view>
            <view class="today-topline">{{todayItinerary.date}} · {{todayItinerary.city}}</view>
            <view class="today-title">{{todayItinerary.title}}</view>
          </view>
          <view class="status-pill confirmed">已确认</view>
        </view>
        <view class="body-text">{{todayItinerary.summary}}</view>

        <view class="timeline">
          <view wx:for="{{todayItinerary.items}}" wx:key="time" class="timeline-item">
            <view class="timeline-time">{{item.time}}</view>
            <view class="timeline-dot"></view>
            <view class="timeline-copy">
              <view class="timeline-title-row">
                <view class="timeline-title">{{item.title}}</view>
                <view wx:if="{{item.client_status}}" class="mini-status">{{item.client_status === 'quoted' ? '已收到方案' : item.client_status}}</view>
              </view>
              <view class="body-text">{{item.description}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{todayItinerary.driver && todayItinerary.driver_visibility === 'assigned'}}" class="transport-card">
          <view class="transport-kicker">用车安排</view>
          <view class="transport-main">{{todayItinerary.driver.name}} · {{todayItinerary.driver.vehicle}}</view>
          <view class="transport-sub">{{todayItinerary.driver.phone}}</view>
        </view>

        <view wx:if="{{todayItinerary.farland_contact}}" class="advisor-card">
          <view class="transport-kicker">Farland 顾问</view>
          <view class="transport-main">{{todayItinerary.farland_contact.name}}</view>
          <view class="transport-sub">{{todayItinerary.farland_contact.phone}}</view>
        </view>

        <view class="cta-row">
          <button class="cta-primary" bindtap="contactAdvisor">联系顾问</button>
        </view>
      </view>
    </view>

    <view wx:if="{{operatorCustomerPreviewMode && operatorPreviewDays.length}}" class="section-shell">
      <view class="section-kicker">ITINERARY</view>
      <view class="section-title">完整每日行程</view>
      <view class="trip-invite-day-list">
        <view wx:for="{{operatorPreviewDays}}" wx:key="id" class="trip-invite-day card-surface">
          <view class="trip-invite-day-head">
            <view>
              <view class="trip-invite-day-kicker">Day {{item.dayNo}}</view>
              <view class="trip-invite-day-title">{{item.title}}</view>
            </view>
            <view class="trip-invite-day-date">{{item.weekday}}{{item.weekday && item.date ? ' · ' : ''}}{{item.date}}</view>
          </view>
          <view wx:if="{{item.city || item.summary}}" class="trip-invite-day-copy">{{item.city}}{{item.city && item.summary ? ' · ' : ''}}{{item.summary}}</view>
          <view wx:if="{{item.startTime}}" class="trip-invite-day-start">预计出发：{{item.startTime}}</view>
          <view wx:if="{{item.hotelBadge || item.transportBadge}}" class="trip-invite-badges">
            <view wx:if="{{item.hotelBadge}}" class="trip-invite-badge">酒店：{{item.hotelBadge}}</view>
            <view wx:if="{{item.transportBadge}}" class="trip-invite-badge">用车：{{item.transportBadge}}</view>
          </view>

          <view wx:if="{{item.timelineItems.length}}" class="trip-invite-timeline">
            <view wx:for="{{item.timelineItems}}" wx:for-item="node" wx:key="id" class="trip-invite-node">
              <view class="trip-invite-node-time">{{node.time || '待定'}}</view>
              <view class="trip-invite-node-dot"></view>
              <view class="trip-invite-node-copy">
                <view class="trip-invite-node-title">{{node.title}}</view>
                <view wx:if="{{node.location}}" class="trip-invite-node-sub">{{node.location}}</view>
                <view wx:if="{{node.driveText || node.trafficText}}" class="trip-invite-node-sub">{{node.driveText}}{{node.driveText && node.trafficText ? ' · ' : ''}}{{node.trafficText}}</view>
                <view wx:if="{{node.note}}" class="trip-invite-node-note">{{node.note}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode && !showHomeEmpty && todayHotelCard}}" class="section-shell">
      <view class="section-kicker">酒店</view>
      <view class="section-title">今晚住宿</view>
      <view wx:if="{{todayHotelCard}}" class="home-arrangement-card card-surface">
        <view class="arrangement-title">{{todayHotelCard.name}}</view>
        <view class="arrangement-main">{{todayHotelCard.arrivalText}}</view>
        <view class="arrangement-sub">{{todayHotelCard.address || '完整酒店信息将由 Farland 顾问同步。'}}</view>
        <button class="arrangement-btn secondary" bindtap="viewFullTripPlaceholder">查看酒店信息</button>
      </view>
    </view>

    <view wx:if="{{!inviteMode && !showHomeEmpty && tripOverview.length}}" class="section-shell">
      <view class="section-kicker">后续</view>
      <view class="section-title">整体行程</view>
      <view class="stack-list">
        <view wx:for="{{tripOverview}}" wx:key="day" class="day-card card-surface">
          <view class="day-row">
            <view class="day-pill">Day {{item.day}}</view>
            <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="day-title">{{item.title}}</view>
          <view class="day-meta">{{item.date}} · {{item.city}}</view>
          <view class="body-text">{{item.summary}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{operatorCustomerPreviewMode && operatorPreviewFlights.length}}" class="section-shell">
      <view class="section-kicker">FLIGHT</view>
      <view class="section-title">航班安排</view>
      <view class="stack-list">
        <view wx:for="{{operatorPreviewFlights}}" wx:key="id" class="trip-invite-info-card card-surface">
          <view class="trip-invite-info-title">{{item.title}}</view>
          <view wx:if="{{item.route}}" class="trip-invite-info-meta">{{item.route}}</view>
          <view wx:if="{{item.timeText}}" class="trip-invite-info-copy">{{item.timeText}}</view>
          <view wx:if="{{item.note}}" class="trip-invite-info-note">{{item.note}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showLegacyTransport}}" class="section-shell">
      <view class="section-kicker">用车</view>
      <view class="section-title">我的用车</view>
      <view wx:if="{{!transferRequests.length && !transportOrders.length && !charterServices.length}}" class="empty-state">暂无用车安排。</view>
      <view wx:else class="stack-list">
        <view wx:for="{{transferRequests}}" wx:key="request_id" class="transfer-card compact card-surface">
          <view class="transfer-head">
            <view>
              <view class="transfer-title">{{item.title}}</view>
              <view class="transfer-meta">{{item.pickup_time_text}} · {{item.created_by_text}}</view>
            </view>
            <view class="status-chip {{item.statusClass}}">{{item.status_text}}</view>
          </view>
          <view class="route-line compact">
            <view class="route-dot"></view>
            <view class="route-text">{{item.pickup}}</view>
            <view class="route-arrow">→</view>
            <view class="route-text">{{item.dropoff}}</view>
          </view>
          <view wx:if="{{item.status === 'cancelled'}}" class="ops-sub">{{item.cancel_reason_driver || '该用车需求已取消，如需重新安排请联系 Farland 顾问。'}}</view>
          <view wx:elif="{{item.status === 'assigned' && item.assigned_transport}}" class="ops-sub">
            司机：{{item.assigned_transport.driver_name || '待确认'}} · {{item.assigned_transport.vehicle_model || item.assigned_transport.vehicle_type || '车辆待确认'}}
          </view>
          <view wx:else class="ops-sub">已收到 {{item.quoteCount}} 个优选用车方案。</view>
          <button class="detail-btn" data-request-id="{{item.request_id}}" bindtap="viewTransferDetail">查看用车方案</button>
        </view>

        <view wx:for="{{charterServices}}" wx:key="charter_id" class="charter-card compact card-surface">
          <view class="transfer-head">
            <view>
              <view class="transfer-title">{{item.title}}</view>
              <view class="transfer-meta">{{item.date_range_text}} · {{item.vehicle_class}}</view>
            </view>
            <view class="status-chip confirmed">{{item.status_text}}</view>
          </view>
          <view class="body-text">{{item.service_area}}</view>
          <view class="charter-note">{{item.continuity_text}}</view>
        </view>

        <view wx:for="{{transportOrders}}" wx:key="order_id" class="service-card card-surface">
          <view class="stay-head">
            <view class="service-title">{{item.title}}</view>
            <view class="status-chip {{item.statusClass}}">{{item.status_text}}</view>
          </view>
          <view class="body-text">{{item.pickup}} → {{item.dropoff}}</view>
          <view class="service-sub">{{item.pickup_time_text}} · {{item.vehicle_class}}</view>
          <view wx:if="{{item.driver}}" class="service-sub">{{item.driver.display_name}} · {{item.driver.vehicle_model}} · {{item.driver.plate_number}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode && !todayCard && !showHomeEmpty}}" class="section-shell">
      <view class="section-kicker">酒店</view>
      <view class="section-title">我的酒店</view>
      <view wx:if="{{!hotelCards.length}}" class="empty-state">暂无酒店需求。</view>
      <view wx:else class="stack-list">
        <view wx:for="{{hotelCards}}" wx:key="id" class="stay-card card-surface">
          <view class="stay-head">
            <view class="stay-title">{{item.displayName}}</view>
            <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="stay-meta">{{item.check_in_date}} - {{item.check_out_date}}</view>
          <view class="body-text">{{item.subline}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode && !showHomeEmpty}}" class="benefit-panel card-surface">
      <view class="section-kicker">权益</view>
      <view class="section-title">积分福利</view>
      <view class="benefit-meta">{{profile.points_balance}} 积分 · {{profile.member_level}}</view>
      <view wx:for="{{topBenefits}}" wx:key="title" class="benefit-row">
        <view class="benefit-name">{{item.title}}</view>
        <view class="body-text">{{item.description}}</view>
      </view>
      <button class="benefit-btn" bindtap="goBenefits">查看全部福利</button>
    </view>

    <view wx:if="{{!inviteMode && !showHomeEmpty}}" class="advisor-panel">
      如需酒店预订、美国用车或访校服务，请联系 Farland 顾问为您安排。
    </view>
  </block>

  <view wx:if="{{showAdvisorQr}}" class="advisor-qr-mask" catchtap="closeAdvisorQr">
    <view class="advisor-qr-modal" catchtap="noop">
      <view class="advisor-qr-title">添加 Farland 顾问微信</view>
      <view class="advisor-qr-copy">长按识别二维码，或点击二维码放大查看。</view>
      <image
        class="advisor-qr-image"
        src="{{advisorQrPath}}"
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
        bindtap="previewAdvisorQr"
      />
      <button class="advisor-qr-close" bindtap="closeAdvisorQr">关闭</button>
    </view>
  </view>
</view>
