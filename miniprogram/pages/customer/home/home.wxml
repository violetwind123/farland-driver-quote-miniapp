<view class="trip-page">
  <button wx:if="{{operatorPreview}}" class="operator-back-btn" bindtap="backToOperatorCenter">运营中心</button>

  <view wx:if="{{loading}}" class="empty-state">正在加载您的行程...</view>

  <view wx:elif="{{needsInviteClaim}}" class="claim-panel card-surface">
    <view class="claim-kicker">欢迎使用 Farland</view>
    <view class="claim-title">正在确认行程访问</view>

    <view class="claim-note">
      Farland 顾问已为您同步行程。系统将通过微信安全识别您的本次行程访问权限。
    </view>

    <button class="claim-submit" loading="{{claimingTemporaryAccess}}" bindtap="claimTemporaryAccess">查看本次行程</button>
  </view>

  <block wx:else>
    <view wx:if="{{showProfileUpgrade}}" class="profile-upgrade card-surface">
      <view>
        <view class="profile-upgrade-title">保存到我的 Farland 行程</view>
        <view class="profile-upgrade-copy">保存后，本微信可继续查看后续服务安排与历史行程。</view>
      </view>
      <button wx:if="{{!showProfileUpgradeForm}}" class="profile-upgrade-open" bindtap="openProfileUpgradeForm">注册并保存</button>
      <view wx:else class="profile-upgrade-form">
        <input
          class="profile-upgrade-input"
          placeholder="称呼，例如：王女士"
          value="{{profileUpgradeName}}"
          bindinput="onProfileUpgradeNameInput"
        />
        <button class="profile-upgrade-btn" loading="{{claimSubmitting}}" bindtap="submitInviteClaim">保存</button>
      </view>
    </view>

    <view class="trip-hero card-surface">
      <view class="section-kicker hero-kicker">我的行程</view>
      <view class="trip-hero-title">{{profile.name || '我的行程'}}</view>
      <view class="trip-hero-meta">{{profile.member_level}}{{profile.points_balance ? ' · ' + profile.points_balance + ' 积分' : ''}}</view>
      <view wx:if="{{profile.subtitle}}" class="trip-hero-subtitle">{{profile.subtitle}}</view>
      <view class="trip-next-card">
        <view class="trip-next-label">下一项确认行程</view>
        <view class="trip-next-title">{{nextConfirmed.title}}</view>
        <view class="trip-next-meta">{{nextConfirmed.date}} {{nextConfirmed.time}} · {{nextConfirmed.city}}</view>
      </view>
    </view>

    <view wx:if="{{!inviteMode}}" class="section-shell today-card-shell">
      <view class="section-kicker">TODAY</view>
      <view class="section-title">今日行程卡片</view>
      <view wx:if="{{!todayCard}}" class="today-card-empty card-surface">Today’s details are being finalized by Farland.</view>
      <view wx:else class="p4-today-card card-surface">
        <view class="p4-today-head">
          <view class="p4-today-labels">
            <view class="p4-trip-label">{{todayCard.dayLabel}}</view>
            <view class="p4-today-title">{{todayCard.title}}</view>
            <view class="p4-today-route">{{todayCard.dateRouteText}}</view>
          </view>
          <view class="status-pill confirmed">{{todayCard.status_text}}</view>
        </view>

        <view class="p4-service-grid">
          <view class="p4-service-item">
            <view class="p4-service-label">Departure</view>
            <view class="p4-service-value">{{todayCard.depart_time}}</view>
          </view>
          <view class="p4-service-item">
            <view class="p4-service-label">Vehicle</view>
            <view class="p4-service-value">{{todayCard.vehicle_summary}}</view>
          </view>
          <view class="p4-service-item">
            <view class="p4-service-label">Party</view>
            <view class="p4-service-value">{{todayCard.party_summary}}</view>
          </view>
        </view>

        <view class="p4-timeline">
          <view wx:for="{{todayCard.timeline_items}}" wx:key="id" class="p4-timeline-row">
            <view class="p4-timeline-time">{{item.time}}</view>
            <view class="p4-timeline-mark"></view>
            <view class="p4-timeline-main">
              <view class="p4-timeline-title">{{item.title}}</view>
              <view wx:if="{{item.meta}}" class="p4-timeline-meta">{{item.meta}}</view>
              <view wx:if="{{item.noteText}}" class="p4-timeline-note">{{item.noteText}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{todayCard.hotel}}" class="p4-endpoint">
          <view class="p4-endpoint-label">End point</view>
          <view class="p4-endpoint-main">{{todayCard.hotel.name}}</view>
          <view class="p4-endpoint-sub">Arrive around {{todayCard.hotel.arrival_time}}</view>
        </view>

        <view class="p4-driver-note">
          <view wx:if="{{todayCard.driver}}">
            Driver assigned: {{todayCard.driver.name}} · {{todayCard.driver.vehicle_model}}
          </view>
          <view wx:else>{{todayCard.driverPendingText}}</view>
        </view>

        <view wx:if="{{todayCard.next_day_teaser}}" class="p4-next-day">{{todayCard.next_day_teaser}}</view>

        <view wx:if="{{todayCard.advisor.name}}" class="p4-advisor-line">Advisor: {{todayCard.advisor.name}}</view>

        <view class="p4-action-row">
          <button class="p4-action-secondary" bindtap="contactAdvisor">{{todayCard.advisor.contact_label || 'Contact advisor'}}</button>
          <button class="p4-action-primary" bindtap="viewFullTripPlaceholder">View full trip</button>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode}}" class="section-shell">
      <view class="section-kicker">今日</view>
      <view class="section-title">今日行程</view>
      <view wx:if="{{!todayItinerary}}" class="empty-state">暂无今日行程</view>
      <view wx:else class="today-card card-surface">
        <view class="today-header">
          <view>
            <view class="today-topline">{{todayItinerary.date}} · {{todayItinerary.city}}</view>
            <view class="today-title">{{todayItinerary.title}}</view>
          </view>
          <view class="status-pill confirmed">已确认</view>
        </view>
        <view class="body-text">{{todayItinerary.summary}}</view>

        <view class="timeline">
          <view wx:for="{{todayItinerary.items}}" wx:key="time" class="timeline-item">
            <view class="timeline-time">{{item.time}}</view>
            <view class="timeline-dot"></view>
            <view class="timeline-copy">
              <view class="timeline-title-row">
                <view class="timeline-title">{{item.title}}</view>
                <view wx:if="{{item.client_status}}" class="mini-status">{{item.client_status === 'quoted' ? '已收到方案' : item.client_status}}</view>
              </view>
              <view class="body-text">{{item.description}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{todayItinerary.driver}}" class="transport-card">
          <view class="transport-kicker">用车安排</view>
          <view class="transport-main">{{todayItinerary.driver.name}} · {{todayItinerary.driver.vehicle}}</view>
          <view class="transport-sub">{{todayItinerary.driver.phone}}</view>
        </view>

        <view wx:if="{{todayItinerary.farland_contact}}" class="advisor-card">
          <view class="transport-kicker">Farland 顾问</view>
          <view class="transport-main">{{todayItinerary.farland_contact.name}}</view>
          <view class="transport-sub">{{todayItinerary.farland_contact.phone}}</view>
        </view>

        <view class="cta-row">
          <button class="cta-secondary" bindtap="callDriver">联系司机</button>
          <button class="cta-primary" bindtap="contactAdvisor">联系顾问</button>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode}}" class="section-shell">
      <view class="section-kicker">后续</view>
      <view class="section-title">整体行程</view>
      <view wx:if="{{!tripOverview.length}}" class="empty-state">暂无完整行程安排，请联系 Farland 顾问。</view>
      <view wx:else class="stack-list">
        <view wx:for="{{tripOverview}}" wx:key="day" class="day-card card-surface">
          <view class="day-row">
            <view class="day-pill">Day {{item.day}}</view>
            <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="day-title">{{item.title}}</view>
          <view class="day-meta">{{item.date}} · {{item.city}}</view>
          <view class="body-text">{{item.summary}}</view>
        </view>
      </view>
    </view>

    <view class="section-shell">
      <view class="section-kicker">用车</view>
      <view class="section-title">我的用车</view>
      <view wx:if="{{!transferRequests.length && !transportOrders.length && !charterServices.length}}" class="empty-state">暂无用车安排。</view>
      <view wx:else class="stack-list">
        <view wx:for="{{transferRequests}}" wx:key="request_id" class="transfer-card compact card-surface">
          <view class="transfer-head">
            <view>
              <view class="transfer-title">{{item.title}}</view>
              <view class="transfer-meta">{{item.pickup_time_text}} · {{item.created_by_text}}</view>
            </view>
            <view class="status-chip {{item.statusClass}}">{{item.status_text}}</view>
          </view>
          <view class="route-line compact">
            <view class="route-dot"></view>
            <view class="route-text">{{item.pickup}}</view>
            <view class="route-arrow">→</view>
            <view class="route-text">{{item.dropoff}}</view>
          </view>
          <view wx:if="{{item.status === 'cancelled'}}" class="ops-sub">{{item.cancel_reason_driver || '该用车需求已取消，如需重新安排请联系 Farland 顾问。'}}</view>
          <view wx:elif="{{item.status === 'assigned' && item.assigned_transport}}" class="ops-sub">
            司机：{{item.assigned_transport.driver_name || '待确认'}} · {{item.assigned_transport.vehicle_model || item.assigned_transport.vehicle_type || '车辆待确认'}}
          </view>
          <view wx:else class="ops-sub">已收到 {{item.quoteCount}} 个优选用车方案。</view>
          <button class="detail-btn" data-request-id="{{item.request_id}}" bindtap="viewTransferDetail">查看用车方案</button>
        </view>

        <view wx:for="{{charterServices}}" wx:key="charter_id" class="charter-card compact card-surface">
          <view class="transfer-head">
            <view>
              <view class="transfer-title">{{item.title}}</view>
              <view class="transfer-meta">{{item.date_range_text}} · {{item.vehicle_class}}</view>
            </view>
            <view class="status-chip confirmed">{{item.status_text}}</view>
          </view>
          <view class="body-text">{{item.service_area}}</view>
          <view class="charter-note">{{item.continuity_text}}</view>
        </view>

        <view wx:for="{{transportOrders}}" wx:key="order_id" class="service-card card-surface">
          <view class="stay-head">
            <view class="service-title">{{item.title}}</view>
            <view class="status-chip {{item.statusClass}}">{{item.status_text}}</view>
          </view>
          <view class="body-text">{{item.pickup}} → {{item.dropoff}}</view>
          <view class="service-sub">{{item.pickup_time_text}} · {{item.vehicle_class}}</view>
          <view wx:if="{{item.driver}}" class="service-sub">{{item.driver.display_name}} · {{item.driver.vehicle_model}} · {{item.driver.plate_number}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode}}" class="section-shell">
      <view class="section-kicker">酒店</view>
      <view class="section-title">我的酒店</view>
      <view wx:if="{{!hotelCards.length}}" class="empty-state">暂无酒店需求。</view>
      <view wx:else class="stack-list">
        <view wx:for="{{hotelCards}}" wx:key="id" class="stay-card card-surface">
          <view class="stay-head">
            <view class="stay-title">{{item.displayName}}</view>
            <view class="status-chip {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="stay-meta">{{item.check_in_date}} - {{item.check_out_date}}</view>
          <view class="body-text">{{item.subline}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!inviteMode}}" class="benefit-panel card-surface">
      <view class="section-kicker">权益</view>
      <view class="section-title">积分福利</view>
      <view class="benefit-meta">{{profile.points_balance}} 积分 · {{profile.member_level}}</view>
      <view wx:for="{{topBenefits}}" wx:key="title" class="benefit-row">
        <view class="benefit-name">{{item.title}}</view>
        <view class="body-text">{{item.description}}</view>
      </view>
      <button class="benefit-btn" bindtap="goBenefits">查看全部福利</button>
    </view>

    <view wx:if="{{!inviteMode}}" class="advisor-panel">
      如需酒店预订、美国用车或访校服务，请联系 Farland 顾问为您安排。
    </view>
  </block>
</view>
