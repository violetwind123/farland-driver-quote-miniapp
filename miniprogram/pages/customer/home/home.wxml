<view wx:if="{{legacyHomeRedirecting}}" class="trip-page">
  <view class="customer-loading-screen">
    <view class="customer-entry-splash">
      <image class="customer-splash-logo" src="/assets/images/logo-farland-splash.png" mode="aspectFit" />
      <view class="customer-loading-line">
        <view class="customer-loading-bar"></view>
      </view>
      <view class="trip-invite-state-copy muted">正在打开手机行程单</view>
    </view>
  </view>
</view>

<view wx:else class="trip-page">
  <view wx:if="{{loading}}" class="customer-loading-screen">
    <view class="customer-entry-splash">
      <image class="customer-splash-logo" src="/assets/images/logo-farland-splash.png" mode="aspectFit" />
      <view class="customer-loading-line">
        <view class="customer-loading-bar"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{needsInviteClaim}}" class="claim-panel card-surface">
    <view class="claim-kicker">欢迎使用 Farland</view>
    <view class="claim-title">正在确认行程访问</view>

    <view class="claim-note">
      Farland 顾问已为您同步行程。系统将通过微信安全识别您的本次行程访问权限。
    </view>

    <button class="claim-submit" loading="{{claimingTemporaryAccess}}" bindtap="claimTemporaryAccess">查看本次行程</button>
  </view>

  <view wx:elif="{{tripInviteMode}}" class="trip-invite-view">
    <!-- 运营"预览客户界面"退出条:忠实落 tab(带 bottombar),点此返回运营页 -->
    <view wx:if="{{operatorInvitePreview}}" class="op-preview-exit" bindtap="exitOperatorInvitePreview">退出运营预览</view>
    <!-- 手机版行程单内联查看:只一张图,不下载/不转发/不可长按保存;返回收起。底部 bottombar 由所在 tab 提供。 -->
    <view wx:if="{{sheetInlineOpen}}" class="sheet-inline">
      <view class="sheet-inline-bar">
        <view class="sheet-inline-back" bindtap="closeItinerarySheetInline">‹ 返回</view>
        <view class="sheet-inline-heading">手机版行程单</view>
        <view class="sheet-inline-spacer"></view>
      </view>
      <scroll-view scroll-y="{{true}}" class="sheet-inline-scroll">
        <image class="sheet-inline-img" src="{{tripInviteSheet.png_url}}" mode="widthFix" show-menu-by-longpress="{{false}}" />
      </scroll-view>
    </view>
    <view wx:if="{{operatorCustomerPreviewMode}}" class="operator-preview-banner card-surface">
      <view class="operator-preview-title">{{operatorCustomerPreviewMeta.operator_draft_preview ? '运营草稿预览' : '运营预览'}}</view>
      <view class="operator-preview-copy">
        {{operatorCustomerPreviewMeta.operator_draft_preview ? '该页面仅供运营核对，不会推送给客户。' : '当前页面模拟客户打开分享卡后的真实显示效果。'}}
      </view>
    </view>

    <view wx:if="{{tripInviteError}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-title">行程链接不可用</view>
      <view class="trip-invite-state-copy">{{tripInviteError}}</view>
      <view class="trip-invite-state-copy muted">请回到 Farland 客户群确认最新链接。</view>
    </view>

    <view wx:elif="{{tripInviteWaiting}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-kicker">Farland 行程</view>
      <view class="trip-invite-state-title">顾问正在核对行程安排</view>
      <view class="trip-invite-state-copy">{{tripInviteMessage}}</view>
      <view class="trip-invite-state-copy muted">如需调整，请在 Farland 客户群内沟通。</view>
      <button
        wx:if="{{operatorCustomerPreviewMode && operatorDraftPreviewPayload}}"
        class="trip-invite-preview-btn"
        bindtap="previewOperatorDraftFromWaiting"
      >预览行程草稿</button>
    </view>

    <!-- Layer 1:未正式发布但已有手机版行程单 → 只显查看草稿入口 -->
    <view wx:elif="{{tripInviteSheetDraft}}" class="trip-invite-state card-surface">
      <view class="trip-invite-state-kicker">FARLAND 手机版行程单</view>
      <view class="trip-invite-state-title">您的手机版行程单已生成</view>
      <view class="trip-invite-state-copy">点击查看行程单草稿；确认后 Farland 会为您发布正式行程。</view>
      <button class="cta-primary sheet-draft-btn" bindtap="openMobileItinerarySheet">查看手机行程单草稿</button>
    </view>

    <block wx:else>
      <view wx:if="{{customerSummaryBar && customerSummaryBar.visible}}" class="customer-summary-bar trip-invite-summary card-surface">
        <view class="summary-main">
          <view class="summary-kicker">FARLAND 行程</view>
          <view class="summary-thanks">{{customerSummaryBar.thank_you_text}}</view>
          <view class="summary-title">{{customerSummaryBar.display_title || customerSummaryBar.customer_display_name}}</view>
          <view wx:if="{{customerSummaryBar.display_meta || customerSummaryBar.trip_no || customerSummaryBar.date_range_text}}" class="summary-meta">
            {{customerSummaryBar.display_meta || (customerSummaryBar.trip_no + (customerSummaryBar.trip_no && customerSummaryBar.date_range_text ? ' · ' : '') + customerSummaryBar.date_range_text)}}
          </view>
          <view wx:if="{{customerSummaryBar.city_route_text}}" class="summary-trip-text">{{customerSummaryBar.city_route_text}}</view>
        </view>
        <view class="summary-status">{{operatorCustomerPreviewMode ? '运营预览' : customerSummaryBar.sync_status_text}}</view>
      </view>

      <view wx:else class="trip-invite-hero compact card-surface">
        <view class="trip-identity-head">
          <view class="section-kicker hero-kicker">FARLAND 行程</view>
          <view wx:if="{{operatorCustomerPreviewMode}}" class="trip-invite-sync muted">运营预览</view>
          <view wx:elif="{{tripInviteAutoSaved || tripInviteAlreadySaved}}" class="trip-invite-sync">已同步</view>
          <view wx:else class="trip-invite-sync muted">临时查看</view>
        </view>
        <view class="trip-invite-copy">感谢您使用 Farland 的服务</view>
        <view class="trip-invite-title">{{tripInviteTrip.displayCompactTitle || tripInviteTrip.displayTitle}}</view>
        <view wx:if="{{tripInviteTrip.displayCompactMeta || tripInviteTrip.displayTripNo || tripInviteTrip.displayDateRange}}" class="trip-invite-meta">
          {{tripInviteTrip.displayCompactMeta || (tripInviteTrip.displayTripNo + (tripInviteTrip.displayTripNo && tripInviteTrip.displayDateRange ? ' · ' : '') + tripInviteTrip.displayDateRange)}}
        </view>
        <view wx:if="{{tripInviteTrip.displayCity}}" class="trip-invite-route">{{tripInviteTrip.displayCity}}</view>
      </view>

      <view wx:if="{{tripInviteCanSave && !operatorCustomerPreviewMode}}" class="profile-upgrade card-surface">
        <view>
          <view class="profile-upgrade-title">保存到我的 Farland 行程</view>
          <view class="profile-upgrade-copy">方便之后继续查看行程、酒店安排、司机信息和后续服务。</view>
        </view>
        <button wx:if="{{!tripInviteShowSaveForm}}" class="profile-upgrade-open" bindtap="openTripInviteSaveForm">保存行程</button>
        <view wx:else class="profile-upgrade-form">
          <input
            class="profile-upgrade-input"
            placeholder="称呼，例如：刘女士"
            value="{{tripInviteSaveName}}"
            bindinput="onTripInviteSaveNameInput"
          />
          <button class="profile-upgrade-btn" loading="{{tripInviteSaving}}" bindtap="saveTripInviteToProfile">保存</button>
        </view>
      </view>

      <!-- Layer 2 次要入口:发布后仍可查看手机版行程单图 -->
      <view wx:if="{{tripInviteSheet.png_url}}" class="section-shell">
        <view class="itinerary-sheet-entry card-surface" bindtap="openMobileItinerarySheet" hover-class="itinerary-sheet-entry-hover">
          <view class="itinerary-sheet-entry-main">
            <view class="itinerary-sheet-entry-title">查看完整行程单</view>
            <view class="itinerary-sheet-entry-sub">Farland 手机版行程单 · 只读查看</view>
          </view>
          <view class="itinerary-sheet-entry-chevron">›</view>
        </view>
      </view>

      <view class="trip-day-swipe-zone" data-source="invite" bindtouchstart="onDaySurfaceTouchStart" bindtouchmove="onDaySurfaceTouchMove" bindtouchend="onDaySurfaceTouchEnd" bindtouchcancel="onDaySurfaceTouchEnd">
      <view wx:if="{{tripInviteTrip.progressNodes && tripInviteTrip.progressNodes.length > 1}}" class="section-shell progress-shell">
        <view class="section-kicker">TRIP</view>
        <view class="section-title">行程进度</view>
        <scroll-view id="progress-strip-invite" class="daily-progress-strip card-surface" scroll-x="{{true}}" scroll-left="{{inviteProgressAxisScrollLeft}}" scroll-with-animation="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" data-source="invite" bindscroll="onProgressAxisScroll" bindtouchstart="onProgressAxisTouchStart" bindtouchend="onProgressAxisTouchEnd">
          <view class="daily-progress-track">
            <view wx:for="{{tripInviteTrip.progressNodes}}" wx:key="node_id" id="progress-day-invite-{{item.day_no}}" class="daily-progress-node {{item.status}} {{(item.selected || item.isSelected) ? 'selected' : ''}} {{item.isPast ? 'past' : ''}} {{item.isToday ? 'today' : ''}}" data-source="invite" data-day-no="{{item.day_no}}" bindtap="selectTripProgressDay" hover-class="daily-progress-node-hover">
              <view class="daily-progress-dot"></view>
              <view class="daily-progress-label">{{item.label}}</view>
              <view wx:if="{{item.weekday || item.date}}" class="daily-progress-date">{{item.weekday}}{{item.weekday && item.date ? ' · ' : ''}}{{item.date}}</view>
              <view class="daily-progress-sub">{{item.short_location || item.shortLocation || '行程'}}</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="trip-day-motion" style="{{inviteDaySwipeStyle}}">
      <view wx:if="{{tripInviteTrip.todayDriverCard}}" class="section-shell driver-shell">
        <view class="today-driver-card card-surface">
          <view class="driver-summary-head">
            <view class="driver-summary-main">
              <view wx:if="{{tripInviteTrip.todayDriverCard.driverLine}}" class="driver-summary-sub">{{tripInviteTrip.todayDriverCard.driverLine}}</view>
              <view wx:if="{{tripInviteTrip.todayDriverCard.vehicleLine}}" class="driver-summary-sub">{{tripInviteTrip.todayDriverCard.vehicleLine}}</view>
              <view wx:if="{{tripInviteTrip.todayDriverCard.plateLine}}" class="driver-summary-sub">{{tripInviteTrip.todayDriverCard.plateLine}}</view>
              <view wx:if="{{tripInviteTrip.todayDriverCard.helperText}}" class="driver-summary-sub">{{tripInviteTrip.todayDriverCard.helperText}}</view>
            </view>
            <view wx:if="{{tripInviteTrip.todayDriverCard.statusText}}" class="status-chip {{tripInviteTrip.todayDriverCard.statusClass}}">{{tripInviteTrip.todayDriverCard.statusText}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{tripInviteTrip.todayOverviewCard}}" id="customer-today-itinerary-section" class="section-shell today-card-shell">
        <view class="p4-today-card compact card-surface">
          <view class="overview-head">
            <view class="overview-head-main">
              <view class="section-kicker">{{tripInviteTrip.todayOverviewCard.sectionKicker || 'TODAY'}}</view>
              <view class="overview-title">{{tripInviteTrip.todayOverviewCard.sectionTitle || '今日行程概览'}}</view>
              <view class="overview-subtitle">{{tripInviteTrip.todayOverviewCard.overviewSubtitle || tripInviteTrip.todayOverviewCard.dateRouteText}}</view>
            </view>
            <view wx:if="{{tripInviteTrip.todayOverviewCard.departureTime || tripInviteTrip.todayOverviewCard.startTime}}" class="departure-block">
              <view class="departure-time">{{tripInviteTrip.todayOverviewCard.departureTime || tripInviteTrip.todayOverviewCard.startTime}}</view>
              <view class="departure-label">出发</view>
            </view>
          </view>
          <view wx:if="{{tripInviteTrip.todayOverviewCard.trustStatusText || tripInviteTrip.todayOverviewCard.updatedAtText || tripInviteTrip.todayOverviewCard.changeSummaryText}}" class="today-trust-line">
            <view wx:if="{{tripInviteTrip.todayOverviewCard.trustStatusText}}" class="today-trust-confirm"><view class="today-trust-dot"></view><text>{{tripInviteTrip.todayOverviewCard.trustStatusText}}</text></view>
            <text wx:if="{{tripInviteTrip.todayOverviewCard.updatedAtText}}" class="today-trust-updated">{{tripInviteTrip.todayOverviewCard.updatedAtText}}</text>
            <text wx:if="{{tripInviteTrip.todayOverviewCard.changeSummaryText}}" class="today-trust-change">{{tripInviteTrip.todayOverviewCard.changeSummaryText}}</text>
          </view>
          <view wx:if="{{tripInviteTrip.todayOverviewCard.serviceWindowLine}}" class="today-service-window">{{tripInviteTrip.todayOverviewCard.serviceWindowLine}}</view>
          <view class="overview-timeline">
            <view wx:for="{{tripInviteTrip.todayOverviewCard.displayRouteStops || tripInviteTrip.todayOverviewCard.routeStops}}" wx:key="id" class="overview-row">
              <view class="overview-row-time">{{item.time}}</view>
              <view class="overview-row-main">
                <view class="overview-row-title">{{item.title}}</view>
                <view wx:if="{{item.subtitle}}" class="overview-row-subtitle">{{item.subtitle}}</view>
                <view wx:if="{{item.connectorTravelMeta && item.connectorTravelMeta.hasContent}}" class="segment-connector">
                  <view class="segment-dash"></view>
                  <view class="segment-meta">
                    <view wx:if="{{item.connectorTravelMeta.icon_type}}" class="segment-mode-icon segment-mode-{{item.connectorTravelMeta.icon_type}}" aria-label="{{item.connectorTravelMeta.icon_label}}"><view class="segment-icon-part segment-icon-a"></view><view class="segment-icon-part segment-icon-b"></view><view class="segment-icon-part segment-icon-c"></view><view class="segment-icon-part segment-icon-d"></view><view class="segment-icon-part segment-icon-e"></view></view>
                    <text wx:if="{{item.connectorTravelMeta.drive_time_text}}">{{item.connectorTravelMeta.drive_time_text}}</text>
                    <text wx:if="{{item.connectorTravelMeta.distance_text}}">{{item.connectorTravelMeta.drive_time_text ? ' · ' : ''}}{{item.connectorTravelMeta.distance_text}}</text>
                    <text wx:if="{{item.connectorTravelMeta.traffic_text}}" class="traffic-pill traffic-{{item.connectorTravelMeta.traffic_level}}">{{item.connectorTravelMeta.traffic_text}}</text>
                  </view>
                  <view class="segment-dash"></view>
                </view>
              </view>
            </view>
          </view>
          <view wx:if="{{tripInviteTrip.todayOverviewCard.overviewCanExpand}}" class="today-fold-line" data-source="invite" bindtap="toggleTodayOverviewExpanded">{{inviteTodayOverviewExpanded ? tripInviteTrip.todayOverviewCard.overviewCollapseLabel : tripInviteTrip.todayOverviewCard.overviewExpandLabel}}</view>
          <view wx:elif="{{tripInviteTrip.todayOverviewCard.nodeCount > 3}}" class="p4-summary-count">当日共 {{tripInviteTrip.todayOverviewCard.nodeCount}} 个行程节点</view>
          <view wx:if="{{tripInviteTrip.todayOverviewCard.nextDayTeaserText}}" class="today-next-teaser">{{tripInviteTrip.todayOverviewCard.nextDayTeaserText}}</view>
          <view class="p4-action-row">
            <button class="p4-action-primary single" data-source="invite" data-day-no="{{tripInviteTrip.todayOverviewCard.day_no || tripInviteTrip.todayOverviewCard.dayNo}}" bindtap="openTripDayDetail">查看行程卡片</button>
          </view>
        </view>
      </view>
      </view>
      </view>

      <view wx:if="{{tripInviteTrip.todayHotelCard}}" class="section-shell">
        <view class="section-kicker">酒店</view>
        <view class="section-title">{{tripInviteTrip.todayHotelCard.sectionTitle || '今晚住宿'}}</view>
        <view class="hotel-summary-card card-surface" bindtap="openTripInviteHotelDetail">
          <view class="arrangement-title">{{tripInviteTrip.todayHotelCard.name}}</view>
          <view wx:if="{{tripInviteTrip.todayHotelCard.metaText}}" class="hotel-meta">{{tripInviteTrip.todayHotelCard.metaText}}</view>
          <view wx:if="{{tripInviteTrip.todayHotelCard.arrivalText}}" class="arrangement-main">{{tripInviteTrip.todayHotelCard.arrivalText}}</view>
          <view class="arrangement-sub">{{tripInviteTrip.todayHotelCard.address || tripInviteTrip.todayHotelCard.city || '完整酒店信息将由 Farland 顾问同步。'}}</view>
          <view wx:if="{{tripInviteTrip.todayHotelCard.hotelDetailItems && tripInviteTrip.todayHotelCard.hotelDetailItems.length}}" class="hotel-summary-detail-list">
            <view wx:for="{{tripInviteTrip.todayHotelCard.hotelDetailItems}}" wx:key="label" class="hotel-summary-detail-row {{item.muted ? 'muted' : ''}}">
              <view class="hotel-summary-detail-label">{{item.label}}</view>
              <view class="hotel-summary-detail-value">{{item.value}}</view>
            </view>
          </view>
          <view class="trip-card-action">查看酒店信息</view>
        </view>
      </view>

      <view wx:if="{{tripInviteTrip.visitCards && tripInviteTrip.visitCards.length}}" class="section-shell visit-shell">
        <view class="section-kicker gold">CAMPUS VISIT</view>
        <view class="section-title">您的访校安排</view>
        <view wx:for="{{tripInviteTrip.visitCards}}" wx:key="id" class="visit-card card-surface">
          <view class="visit-hero">
            <view class="visit-hero-watermark">{{item.school_name_en}}</view>
            <view class="visit-hero-badges">
              <view wx:if="{{item.day_badge_text}}" class="visit-day-badge">{{item.day_badge_text}}</view>
              <view class="status-chip confirmed-solid">已确认</view>
            </view>
            <view class="visit-hero-title">{{item.school_name}}{{item.visit_type_text ? (' · ' + item.visit_type_text) : ''}}</view>
          </view>
          <view class="visit-body">
            <view class="visit-time-row">
              <view class="visit-time-big">{{item.startTimeText}}</view>
              <view wx:if="{{item.timeRangeText}}" class="visit-time-range">{{item.timeRangeText}}</view>
              <view wx:if="{{item.weatherText}}" class="weather-inline visit-weather"><view class="wx-ico wx-{{item.weatherKind}}"></view>{{item.weatherText}}</view>
            </view>
            <view wx:if="{{item.meeting_point_name}}" class="visit-info-row">
              <view class="visit-info-label">集合</view>
              <view class="visit-info-value">{{item.meeting_point_name}}{{item.meeting_point_addr_en ? (' · ' + item.meeting_point_addr_en) : ''}}</view>
            </view>
            <view wx:if="{{item.arriveText}}" class="visit-info-row">
              <view class="visit-info-label">到达</view>
              <view class="visit-info-value">{{item.arriveText}}</view>
            </view>
          </view>
        </view>
        <view class="visit-tail-note">其余学校确认后会出现在这里，顾问会第一时间通知您</view>
        <view class="weather-source"><text>天气数据来源 美国国家海洋和大气管理局 NOAA · NWS</text></view>
      </view>
    </block>
  </view>

  <block wx:else>
    <view wx:if="{{operatorCustomerPreviewMode}}" class="operator-preview-banner card-surface">
      <view class="operator-preview-title">{{operatorCustomerPreviewMeta.operator_draft_preview ? '运营草稿预览' : '运营预览'}}</view>
      <view class="operator-preview-copy">
        {{operatorCustomerPreviewMeta.operator_draft_preview ? '该页面仅供运营核对，不会推送给客户。' : '当前为已发布客户版本预览。'}}
      </view>
    </view>

    <view wx:if="{{showProfileUpgrade}}" class="profile-upgrade card-surface">
      <view>
        <view class="profile-upgrade-title">保存到我的 Farland 行程</view>
        <view class="profile-upgrade-copy">保存后，本微信可继续查看后续服务安排与历史行程。</view>
      </view>
      <button wx:if="{{!showProfileUpgradeForm}}" class="profile-upgrade-open" bindtap="openProfileUpgradeForm">注册并保存</button>
      <view wx:else class="profile-upgrade-form">
        <input
          class="profile-upgrade-input"
          placeholder="称呼，例如：刘女士"
          value="{{profileUpgradeName}}"
          bindinput="onProfileUpgradeNameInput"
        />
        <button class="profile-upgrade-btn" loading="{{claimSubmitting}}" bindtap="submitInviteClaim">保存</button>
      </view>
    </view>

    <view wx:if="{{!inviteMode && customerSummaryBar && customerSummaryBar.visible && !showHomeEmpty}}" class="customer-summary-bar card-surface">
      <view class="summary-main">
        <view class="summary-kicker">FARLAND 行程</view>
        <view class="summary-thanks">{{customerSummaryBar.thank_you_text}}</view>
        <view class="summary-title">{{customerSummaryBar.display_title || customerSummaryBar.customer_display_name}}</view>
        <view wx:if="{{customerSummaryBar.display_meta || customerSummaryBar.trip_no || customerSummaryBar.date_range_text}}" class="summary-meta">
          {{customerSummaryBar.display_meta || (customerSummaryBar.trip_no + (customerSummaryBar.trip_no && customerSummaryBar.date_range_text ? ' · ' : '') + customerSummaryBar.date_range_text)}}
        </view>
        <view wx:if="{{customerSummaryBar.city_route_text}}" class="summary-trip-text">{{customerSummaryBar.city_route_text}}</view>
      </view>
      <view class="summary-status">{{customerSummaryBar.sync_status_text}}</view>
    </view>

    <view wx:if="{{showHomeEmpty}}" class="home-empty-card card-surface">
      <view class="empty-title">暂无行程安排</view>
      <view class="empty-sub">如需调整，请在 Farland 客户群内沟通。</view>
    </view>

    <view wx:if="{{useHomePaneSwiper && !showHomeEmpty}}" class="home-pane-shell">
      <view class="home-pane-tabs card-surface">
        <view class="home-pane-tab {{homePaneIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="switchHomePane">包车行程</view>
        <view class="home-pane-tab {{homePaneIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="switchHomePane">临时用车</view>
      </view>

      <swiper class="home-pane-swiper" current="{{homePaneIndex}}" duration="260" disable-touch="{{true}}" bindchange="onHomePaneChange">
        <swiper-item>
          <scroll-view class="home-pane-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="home-pane-content">
              <view class="trip-day-swipe-zone" data-source="home" bindtouchstart="onDaySurfaceTouchStart" bindtouchmove="onDaySurfaceTouchMove" bindtouchend="onDaySurfaceTouchEnd" bindtouchcancel="onDaySurfaceTouchEnd">
              <view wx:if="{{tripProgress && tripProgress.visible}}" class="section-shell progress-shell">
                <view class="section-kicker">TRIP</view>
                <view class="section-title">行程进度</view>
                <scroll-view id="progress-strip-home" class="daily-progress-strip card-surface" scroll-x="{{true}}" scroll-left="{{progressAxisScrollLeft}}" scroll-with-animation="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" data-source="home" bindscroll="onProgressAxisScroll" bindtouchstart="onProgressAxisTouchStart" bindtouchend="onProgressAxisTouchEnd">
                  <view class="daily-progress-track">
                    <view wx:for="{{tripProgress.nodes}}" wx:key="node_id" id="progress-day-home-{{item.day_no}}" class="daily-progress-node {{item.status}} {{(item.selected || item.isSelected) ? 'selected' : ''}} {{item.isPast ? 'past' : ''}} {{item.isToday ? 'today' : ''}}" data-source="home" data-day-no="{{item.day_no}}" bindtap="selectTripProgressDay" hover-class="daily-progress-node-hover">
                      <view class="daily-progress-dot"></view>
                      <view class="daily-progress-label">{{item.label}}</view>
                      <view wx:if="{{item.weekday || item.date}}" class="daily-progress-date">{{item.weekday}}{{item.weekday && item.date ? ' · ' : ''}}{{item.date}}</view>
              <view class="daily-progress-sub">{{item.short_location || item.shortLocation || '行程'}}</view>
                    </view>
                  </view>
                </scroll-view>
              </view>

              <view class="trip-day-motion" style="{{homeDaySwipeStyle}}">
              <view wx:if="{{todayDriverCard}}" class="section-shell driver-shell">
