@import "/styles/theme.wxss";

.day-page {
  min-height: 100vh;
  padding: 28rpx 0 40rpx;
  box-sizing: border-box;
  background: #F7F8FC;
}

.empty-state {
  margin: 80rpx 24rpx 0;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.destination-swiper {
  height: calc(100vh - 68rpx);
}

.destination-card {
  height: calc(100vh - 92rpx);
  margin: 0 10rpx;
  padding: 38rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 18rpx 44rpx rgba(17, 24, 39, 0.09);
  overflow-y: auto;
}

.card-index,
.card-type,
.detail-label {
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.card-type {
  margin-top: 10rpx;
  color: #5B6596;
}

.card-time {
  margin-top: 24rpx;
  color: #5B6596;
  font-size: 54rpx;
  line-height: 1.05;
  font-weight: 780;
}

.card-title {
  margin-top: 14rpx;
  color: #1D2433;
  font-size: 40rpx;
  line-height: 1.18;
  font-weight: 760;
  word-break: break-word;
}

.detail-block {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.06);
}

.detail-value {
  margin-top: 8rpx;
  color: #2F394C;
  font-size: 28rpx;
  line-height: 1.42;
  font-weight: 650;
  word-break: break-word;
}

.detail-note,
.detail-next {
  margin-top: 18rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.detail-next {
  color: #4F598B;
  font-weight: 650;
}

.info-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.info-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.info-card-head .card-index {
  min-width: 0;
}

.info-card-head .card-type {
  margin-top: 0;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(79, 89, 139, 0.08);
  color: #4F598B;
}

.info-title {
  color: #111827;
  font-size: 46rpx;
  line-height: 1.12;
  font-weight: 800;
  word-break: break-word;
}

.info-subtitle {
  margin-top: -12rpx;
  color: #4B5563;
  font-size: 29rpx;
  line-height: 1.28;
  font-weight: 650;
  word-break: break-word;
}

.info-meta {
  margin-top: -6rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.42;
  font-weight: 600;
  word-break: break-word;
}

.info-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.info-detail-item {
  min-width: 0;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
  border: 1rpx solid rgba(31, 36, 51, 0.05);
}

.detail-value.compact {
  font-size: 25rpx;
  line-height: 1.34;
  font-weight: 700;
}

.info-section {
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.06);
}

.info-copy {
  margin-top: 10rpx;
  color: #2F394C;
  font-size: 27rpx;
  line-height: 1.48;
  word-break: break-word;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.info-tag {
  max-width: 100%;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #EEF2F7;
  color: #475467;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 650;
  word-break: break-word;
}

.time-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: auto;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.08);
}

.time-cell {
  min-width: 120rpx;
  flex: 1 1 0;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
}

.time-label {
  color: #8A91A1;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 650;
}

.time-value {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.15;
  font-weight: 780;
  word-break: break-word;
}

.time-warning {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(245, 158, 11, 0.12);
  color: #B45309;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 700;
}
