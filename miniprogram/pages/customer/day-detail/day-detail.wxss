@import "/styles/theme.wxss";

.day-page {
  min-height: 100vh;
  padding: 28rpx 0 40rpx;
  box-sizing: border-box;
  background: #F7F8FC;
}

.empty-state {
  margin: 80rpx 24rpx 0;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.destination-swiper {
  height: calc(100vh - 68rpx);
}

.destination-card {
  height: calc(100vh - 92rpx);
  margin: 0 10rpx;
  padding: 38rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 18rpx 44rpx rgba(17, 24, 39, 0.09);
  overflow: hidden;
}

.card-index,
.card-type,
.detail-label {
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.card-type {
  margin-top: 10rpx;
  color: #5B6596;
}

.card-time {
  margin-top: 24rpx;
  color: #5B6596;
  font-size: 54rpx;
  line-height: 1.05;
  font-weight: 780;
}

.card-title {
  margin-top: 14rpx;
  color: #1D2433;
  font-size: 40rpx;
  line-height: 1.18;
  font-weight: 760;
}

.detail-block {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.06);
}

.detail-value {
  margin-top: 8rpx;
  color: #2F394C;
  font-size: 28rpx;
  line-height: 1.42;
  font-weight: 650;
  word-break: break-word;
}

.detail-note,
.detail-next {
  margin-top: 18rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.detail-next {
  color: #4F598B;
  font-weight: 650;
}
