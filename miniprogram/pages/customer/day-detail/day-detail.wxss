@import "/styles/theme.wxss";

.day-page {
  min-height: 100vh;
  padding: 24rpx 0 150rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(91, 101, 150, 0.10), transparent 32%),
    linear-gradient(180deg, #F7F8FC 0%, #FFFFFF 100%);
}

.empty-state {
  margin: 80rpx 24rpx 0;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.day-header,
.service-strip {
  margin: 0 24rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055);
}

.day-header {
  padding: 30rpx;
}

.day-kicker {
  color: #5B6596;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 700;
}

.day-title {
  margin-top: 10rpx;
  color: #1D2433;
  font-size: 40rpx;
  line-height: 1.18;
  font-weight: 750;
}

.day-route {
  margin-top: 10rpx;
  color: #4B5565;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 600;
}

.day-status {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(91, 101, 150, 0.10);
  color: #5B6596;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 650;
}

.service-strip {
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
}

.service-title {
  color: #1D2433;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 700;
}

.service-main {
  margin-top: 10rpx;
  color: #2F394C;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 600;
}

.service-sub {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.service-driver {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(91, 101, 150, 0.08);
  color: #2F394C;
  font-size: 24rpx;
  line-height: 1.55;
}

.day-detail-empty {
  margin: 28rpx 24rpx 0;
  padding: 32rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055);
}

.empty-title {
  color: #1D2433;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.empty-copy {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.destination-swiper {
  height: 690rpx;
  margin-top: 28rpx;
}

.destination-card {
  height: 650rpx;
  margin: 0 10rpx;
  padding: 34rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 18rpx 44rpx rgba(17, 24, 39, 0.09);
}

.card-index,
.card-type,
.detail-label {
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.card-type {
  margin-top: 10rpx;
  color: #5B6596;
}

.card-time {
  margin-top: 22rpx;
  color: #5B6596;
  font-size: 48rpx;
  line-height: 1.05;
  font-weight: 780;
}

.card-title {
  margin-top: 12rpx;
  color: #1D2433;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 760;
}

.detail-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(31, 36, 51, 0.06);
}

.detail-value {
  margin-top: 8rpx;
  color: #2F394C;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 650;
}

.detail-note,
.detail-next {
  margin-top: 16rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-next {
  color: #4F598B;
}

.card-action {
  margin: 28rpx 0 0;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: #5B6596;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 650;
}

.card-action::after {
  border: none;
}

.time-chip-row {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
}

.time-chip {
  flex: 0 0 auto;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.2;
  border: 1rpx solid rgba(31, 36, 51, 0.07);
}

.time-chip.active {
  background: rgba(91, 101, 150, 0.12);
  color: #5B6596;
  border-color: rgba(91, 101, 150, 0.18);
  font-weight: 700;
}

.endpoint-summary {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055);
}

.endpoint-label {
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.endpoint-title {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 720;
}

.endpoint-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.bottom-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 26rpx 24rpx 0;
}

.bottom-btn {
  margin: 0;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 650;
}

.bottom-btn.primary {
  grid-column: 1 / -1;
  background: #5B6596;
  color: #FFFFFF;
}

.bottom-btn.secondary {
  background: #FFFFFF;
  color: #5B6596;
  border: 1rpx solid #DDE4F3;
}

.bottom-btn::after {
  border: none;
}

.advisor-qr-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
  background: rgba(18, 24, 38, 0.46);
}

.advisor-qr-modal {
  width: 100%;
  padding: 34rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 70rpx rgba(17, 24, 39, 0.18);
}

.advisor-qr-title {
  color: #1D2433;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 750;
  text-align: center;
}

.advisor-qr-copy {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.advisor-qr-image {
  display: block;
  width: 430rpx;
  height: 430rpx;
  margin: 30rpx auto 0;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.advisor-qr-close {
  margin: 28rpx 0 0;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: #5B6596;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 650;
}

.advisor-qr-close::after {
  border: none;
}
