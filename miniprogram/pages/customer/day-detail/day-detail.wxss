@import "/styles/theme.wxss";

.day-page {
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
  background: var(--bg-page);
}

.empty-state {
  margin: 80rpx 24rpx 0;
  padding: 34rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  color: var(--ink-400);
  font-size: 26rpx;
  line-height: 1.55;
}

/* Overlay chip so full-bleed hero (day-page padding:0) is not pushed down. */
.swipe-hint {
  position: fixed;
  left: 50%;
  top: calc(24rpx + env(safe-area-inset-top));
  transform: translateX(-50%);
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(20, 26, 50, 0.42);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.3;
}

.swipe-hint-icon {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

/* ============================================================
   Immersive per-station layout (design 3b)
   Height driven by JS-computed px on .destination-swiper / .station
   (inline style); the 100vh values below are fallback only, because
   WeChat swiper collapses under a pure height:100vh child.
   ============================================================ */
.destination-swiper {
  height: 100vh;
}

.station-item {
  position: relative;
  height: 100vh;
}

.station {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

/* HERO */
.station-hero {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 504rpx;
  overflow: hidden;
  background: linear-gradient(158deg, #232B4A 0%, #4B568C 54%, #6C77AB 100%);
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-wash {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 82% 6%, rgba(255, 255, 255, 0.18), transparent 52%);
}

.station-hero.has-image .hero-wash {
  background: linear-gradient(135deg, rgba(35, 43, 74, 0.12), rgba(35, 43, 74, 0.36));
}

.hero-watermark {
  position: absolute;
  right: -12rpx;
  top: 88rpx;
  font-family: var(--font-serif);
  font-size: 144rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.06);
  line-height: 0.9;
  white-space: nowrap;
}

.hero-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 344rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(20, 26, 50, 0.30) 44%, rgba(20, 26, 50, 0.74) 100%);
}

.hero-foot {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.hero-badges {
  display: flex;
  gap: 12rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 600;
}

.hero-status {
  height: 44rpx;
}

.hero-time-row {
  display: flex;
  align-items: baseline;
  gap: 22rpx;
}

.hero-time {
  font-family: var(--font-serif);
  font-size: 84rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 0.95;
  text-shadow: 0 4rpx 28rpx rgba(15, 20, 40, 0.4);
}

.hero-time-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-title {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-shadow: 0 4rpx 24rpx rgba(15, 20, 40, 0.35);
}

.hero-subtitle {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hero-swipe-glow {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 212rpx;
  width: 18rpx;
  background: linear-gradient(90deg, rgba(15, 20, 40, 0) 0%, rgba(15, 20, 40, 0.12) 100%);
  z-index: 6;
}

/* CONTENT SHEET */
.station-sheet {
  position: absolute;
  left: 0;
  right: 0;
  top: 464rpx;
  bottom: 212rpx;
  background: var(--bg-page);
  border-radius: 52rpx 52rpx 0 0;
  box-shadow: 0 -24rpx 60rpx rgba(15, 20, 40, 0.20);
  padding: 22rpx 40rpx 32rpx;
  box-sizing: border-box;
  z-index: 5;
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(27, 35, 64, 0.13);
  margin: 0 auto 26rpx;
}

.sheet-kicker {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: var(--gold-500);
  font-weight: 700;
  margin: 32rpx 0 8rpx;
}

.sheet-kicker:first-of-type {
  margin-top: 0;
}

.sheet-copy {
  font-size: 24rpx;
  color: var(--ink-600);
  line-height: 1.65;
}

.fact-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.fact-cell {
  flex: 1;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.fact-label {
  font-size: 18rpx;
  color: var(--ink-400);
}

.fact-value {
  font-size: 25rpx;
  color: var(--ink-900);
  font-weight: 700;
  text-align: center;
  word-break: break-word;
}

.fact-value.success {
  color: var(--success);
}

.fact-value.muted {
  color: var(--ink-300);
}

.highlight-row {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
}

.highlight-idx {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-600);
  width: 36rpx;
  flex-shrink: 0;
}

.highlight-title {
  font-size: 24rpx;
  color: var(--ink-900);
  font-weight: 600;
}

.highlight-desc {
  font-size: 20rpx;
  color: var(--ink-400);
  margin-top: 2rpx;
}

.practical-card {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 4rpx 32rpx;
}

.practical-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.practical-row:last-child {
  border-bottom: 0;
}

.practical-label {
  width: 104rpx;
  font-size: 21rpx;
  color: var(--ink-400);
  flex-shrink: 0;
}

.practical-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-900);
  font-weight: 500;
  word-break: break-word;
}

/* BOTTOM NODE STRIP */
.node-strip {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  height: 212rpx;
  padding: 24rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg-card);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -12rpx 40rpx rgba(15, 20, 40, 0.05);
}

.node-strip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.node-strip-title {
  font-size: 20rpx;
  color: var(--ink-900);
  font-weight: 600;
}

.node-strip-next {
  max-width: 55%;
  color: var(--brand-600);
  font-size: 20rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.node-track {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 4rpx;
}

.node-track-line {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 10rpx;
  height: 4rpx;
  background: rgba(27, 35, 64, 0.10);
}

.node {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.node-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 999rpx;
  border: 4rpx solid #C4C8D4;
  background: #FFFFFF;
  box-sizing: border-box;
}

.node-dot.past {
  border: 0;
  background: #C4C8D4;
}

.node-dot.current {
  border: 0;
  background: var(--brand-500);
  box-shadow: 0 0 0 8rpx rgba(102, 114, 168, 0.16);
}

.node-dot.next {
  border-color: #E0B77E;
}

.node-time {
  font-size: 19rpx;
  color: var(--ink-400);
  font-weight: 500;
}

.node.current .node-time {
  color: var(--brand-600);
  font-weight: 700;
}

.node.next .node-time {
  color: var(--warn);
  font-weight: 600;
}

.node-name {
  font-size: 16rpx;
  color: var(--ink-300);
  width: 100%;
  overflow: hidden;
  text-align: center;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.node.current .node-name {
  color: var(--brand-600);
}

.node.next .node-name {
  color: var(--warn);
}
