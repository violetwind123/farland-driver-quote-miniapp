.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: #f4f6fb; }
.title { font-size: 38rpx; font-weight: 700; color: #17315f; margin-bottom: 24rpx; }
.benefit-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 18rpx; }
.benefit-title { font-size: 30rpx; font-weight: 700; color: #1f3266; }
.benefit-desc { margin-top: 10rpx; color: #627392; font-size: 25rpx; line-height: 1.6; }
