@import "/styles/theme.wxss";

.transfer-detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
  background: var(--bg-page);
}

.detail-card {
  position: relative;
  border-radius: 30rpx;
  box-sizing: border-box;
}

.transfer-head {
  padding: 8rpx 8rpx 4rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.head-kicker {
  color: var(--gold-500);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.head-title {
  font-family: var(--font-serif);
  color: var(--ink-900);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.head-route {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ink-900);
  font-size: 24rpx;
  font-weight: 500;
}

.route-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  border: 3rpx solid var(--brand-500);
  box-sizing: border-box;
}

.route-arrow {
  color: var(--ink-400);
}

.transfer-head .status-chip {
  align-self: flex-start;
  margin-top: 4rpx;
}

.profile-save-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--brand-line);
  box-shadow: var(--shadow-card);
}

.profile-save-title {
  color: var(--ink-900);
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 700;
}

.profile-save-copy {
  margin-top: 6rpx;
  color: var(--ink-600);
  font-size: 23rpx;
  line-height: 1.45;
}

.profile-save-form {
  display: grid;
  grid-template-columns: 1fr 148rpx;
  gap: 12rpx;
  margin-top: 18rpx;
  align-items: center;
}

.profile-save-open,
.profile-save-btn {
  margin: 18rpx 0 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: var(--brand-500);
  color: #FFFFFF;
  font-size: 26rpx;
}

.profile-save-btn {
  margin: 0;
}

.profile-save-open::after,
.profile-save-btn::after {
  border: none;
}

.profile-save-input {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: var(--bg-page);
  color: var(--ink-900);
  font-size: 26rpx;
  box-sizing: border-box;
}

.section-kicker {
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 3rpx;
  font-weight: 600;
  color: var(--ink-400);
}

.detail-card {
  margin-top: 22rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
}

.section-title {
  margin-top: 6rpx;
  font-family: var(--font-serif);
  color: var(--ink-900);
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 600;
}

.body-text,
.status-helper,
.quote-sub,
.quote-profile,
.quote-meta,
.quote-detail,
.quote-expiry {
  color: var(--ink-600);
  font-size: 24rpx;
  line-height: 1.55;
}

.body-text {
  margin-top: 14rpx;
}

.task-brief {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--bg-page);
  color: var(--ink-600);
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.task-brief.muted {
  background: rgba(102, 114, 168, 0.075);
  color: var(--ink-600);
}

.snapshot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.snapshot-item {
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--bg-page);
}

.field-label {
  color: var(--ink-400);
  font-size: 21rpx;
  line-height: 1.3;
}

.field-value {
  margin-top: 6rpx;
  color: var(--ink-900);
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
}

.snapshot-note,
.status-helper {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(102, 114, 168, 0.075);
}

.quote-list {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.quote-card {
  position: relative;
  overflow: visible;
  padding: 24rpx;
  border-radius: 26rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
}

.quote-card.selected {
  border-color: rgba(102, 114, 168, 0.28);
  background:
    radial-gradient(circle at 88% 0%, rgba(102, 114, 168, 0.075), transparent 34%),
    var(--bg-card);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 8rpx 24rpx rgba(102, 114, 168, 0.09);
}

.quote-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.quote-title {
  color: var(--ink-900);
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.quote-sub {
  margin-top: 6rpx;
}

.quote-profile {
  margin-top: 16rpx;
  color: var(--ink-600);
  font-weight: 500;
}

.quote-meta {
  margin-top: 6rpx;
}

.quote-price {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.price-cap {
  color: var(--ink-400);
  font-size: 19rpx;
}

.quote-price .price-serif {
  font-size: 40rpx;
}

.price-break {
  color: var(--ink-400);
  font-size: 18rpx;
}

.quote-detail {
  margin-top: 14rpx;
}

.quote-detail.muted {
  margin-top: 4rpx;
  color: var(--ink-400);
}

.quote-action-helper {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(102, 114, 168, 0.08);
  color: var(--ink-600);
  font-size: 22rpx;
  line-height: 1.45;
}

.quote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.quote-readonly {
  flex: 0 0 auto;
  min-width: 142rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  text-align: center;
  background: var(--brand-50);
  color: var(--brand-600);
  font-size: 23rpx;
  font-weight: 600;
}

.quote-readonly.selected {
  background: var(--success-bg);
  color: var(--success);
}

.quote-select-btn {
  flex: 0 0 auto;
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.quote-select-btn[disabled] {
  background: var(--brand-50);
  color: var(--brand-600);
  box-shadow: none;
}

.quote-select-btn::after {
  border: none;
}

.pending-confirm-card {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(102, 114, 168, 0.08);
  color: var(--brand-600);
  font-size: 24rpx;
  line-height: 1.5;
}

.pending-refresh-btn {
  margin-top: 14rpx;
  width: 160rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  color: var(--brand-600);
  font-size: 22rpx;
  font-weight: 600;
  padding: 0;
}

.pending-refresh-btn::after {
  border: none;
}

.driver-unavailable-card {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--danger-bg);
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.55;
  font-weight: 500;
}

.activity-list {
  margin-top: 22rpx;
}

.activity-row {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
  padding: 10rpx 0;
}

.activity-row .timeline-time {
  width: 74rpx;
  text-align: left;
  color: var(--ink-400);
  font-size: 20rpx;
  flex-shrink: 0;
}

.timeline-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.activity-message {
  color: var(--ink-600);
  font-size: 24rpx;
  line-height: 1.45;
}

.activity-message.current {
  color: var(--ink-900);
  font-weight: 500;
}
