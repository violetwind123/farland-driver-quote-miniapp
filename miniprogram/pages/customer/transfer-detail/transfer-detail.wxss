@import "/styles/theme.wxss";

.transfer-detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 0%, rgba(102, 114, 168, 0.10), transparent 32%),
    linear-gradient(180deg, #F7F8FC 0%, #FFFFFF 100%);
}

.detail-hero,
.detail-card {
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  box-sizing: border-box;
}

.detail-hero {
  padding: 30rpx;
  color: #FFFFFF;
  background:
    radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.24), transparent 34%),
    linear-gradient(145deg, #6974AB 0%, #6672A8 56%, #4F598B 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    0 2rpx 4rpx rgba(255, 255, 255, 0.18) inset,
    0 14rpx 36rpx rgba(40, 48, 88, 0.14);
}

.hero-kicker,
.section-kicker {
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1.2rpx;
  font-weight: 600;
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.62);
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
}

.hero-route {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.84);
}

.hero-status {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 22rpx;
}

.detail-card {
  margin-top: 22rpx;
  padding: 28rpx;
  background:
    linear-gradient(180deg, #FFFFFF 0%, #FBFCFF 100%);
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 10rpx 30rpx rgba(17, 24, 39, 0.055),
    0 2rpx 8rpx rgba(17, 24, 39, 0.025);
}

.section-kicker {
  color: #9AA1B2;
}

.section-title {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.body-text,
.status-helper,
.quote-sub,
.quote-profile,
.quote-meta,
.quote-detail,
.quote-expiry {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.body-text {
  margin-top: 14rpx;
}

.snapshot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.snapshot-item {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
}

.field-label,
.price-label {
  color: #8A91A1;
  font-size: 21rpx;
  line-height: 1.3;
}

.field-value {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
}

.snapshot-note,
.status-helper {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(102, 114, 168, 0.075);
}

.quote-list {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.quote-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 6rpx 18rpx rgba(17, 24, 39, 0.035);
}

.quote-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.quote-title {
  color: #1D2433;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.quote-sub {
  margin-top: 6rpx;
}

.quote-profile {
  margin-top: 16rpx;
  color: #4F5A6E;
  font-weight: 500;
}

.quote-meta {
  margin-top: 6rpx;
}

.recommend-badge {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.10);
  color: #6672A8;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 600;
}

.price-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
}

.price-value {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 600;
}

.price-total {
  margin-top: 6rpx;
  color: #6672A8;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 700;
}

.quote-detail {
  margin-top: 14rpx;
}

.quote-detail.muted {
  margin-top: 4rpx;
  color: #8A91A1;
}

.quote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.quote-btn {
  flex: 0 0 auto;
  min-width: 174rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: #6672A8;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 24rpx;
}

.quote-btn::after {
  border: none;
}

.activity-list {
  margin-top: 22rpx;
}

.activity-row {
  display: grid;
  grid-template-columns: 72rpx 14rpx 1fr;
  gap: 14rpx;
  align-items: center;
  padding: 10rpx 0;
}

.activity-time {
  color: #8A91A1;
  font-size: 22rpx;
}

.activity-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #A2AABD;
}

.activity-message {
  color: #5F687A;
  font-size: 24rpx;
  line-height: 1.45;
}
