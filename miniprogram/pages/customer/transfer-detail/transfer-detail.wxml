<view class="transfer-detail-page">
  <view wx:if="{{loading}}" class="empty-state">正在加载用车方案...</view>

  <block wx:else>
    <view wx:if="{{!request}}" class="empty-state">暂无接送需求。</view>

    <block wx:else>
      <view wx:if="{{showProfileSave}}" class="profile-save-card">
        <view>
          <view class="profile-save-title">保存到我的 Farland 行程</view>
          <view class="profile-save-copy">方便之后继续查看行程、报价、司机信息和酒店安排。</view>
        </view>
        <button wx:if="{{!showProfileSaveForm}}" class="profile-save-open" bindtap="openProfileSaveForm">保存行程</button>
        <view wx:else class="profile-save-form">
          <input
            class="profile-save-input"
            placeholder="称呼，例如：刘女士"
            value="{{profileSaveName}}"
            bindinput="onProfileSaveNameInput"
          />
          <button class="profile-save-btn" loading="{{profileSaving}}" bindtap="saveToFarlandProfile">保存行程</button>
        </view>
      </view>

      <view class="detail-hero">
        <view class="hero-kicker">TRANSFER REQUEST</view>
        <view class="hero-title">{{request.task_title || '接送需求'}}</view>
        <view class="hero-route">{{request.pickup}} → {{request.dropoff}}</view>
        <view class="hero-status">{{request.status_text}}</view>
      </view>

      <view class="detail-card">
        <view class="section-kicker">REQUEST SNAPSHOT</view>
        <view class="section-title">需求快照</view>
        <view class="snapshot-grid">
          <view class="snapshot-item">
            <view class="field-label">上车点</view>
            <view class="field-value">{{request.pickup}}</view>
          </view>
          <view class="snapshot-item">
            <view class="field-label">下车点</view>
            <view class="field-value">{{request.dropoff}}</view>
          </view>
          <view class="snapshot-item">
            <view class="field-label">时间</view>
            <view class="field-value">{{request.pickup_time_text}}</view>
          </view>
          <view wx:if="{{request.time_summary}}" class="snapshot-item">
            <view class="field-label">时间安排</view>
            <view class="field-value">{{request.time_summary}}</view>
          </view>
          <view wx:if="{{request.flight_summary || request.flight_no}}" class="snapshot-item">
            <view class="field-label">航班</view>
            <view class="field-value">{{request.flight_summary || request.flight_no}}</view>
          </view>
          <view class="snapshot-item">
            <view class="field-label">人数 / 行李</view>
            <view class="field-value">{{request.passengers}} 人 / {{request.luggage}} 件</view>
          </view>
          <view wx:if="{{request.estimated_drive_time || request.estimated_distance}}" class="snapshot-item">
            <view class="field-label">预计车程</view>
            <view class="field-value">{{request.estimated_drive_time}} {{request.estimated_distance}}</view>
          </view>
        </view>
        <view class="snapshot-note">{{request.created_by_text}}</view>
      </view>

      <view wx:if="{{request.task_description || request.execution_note}}" class="detail-card">
        <view class="section-kicker">TASK BRIEF</view>
        <view class="section-title">任务说明</view>
        <view wx:if="{{request.execution_note}}" class="task-brief">{{request.execution_note}}</view>
        <view wx:if="{{request.task_description}}" class="task-brief muted">{{request.task_description}}</view>
      </view>

      <view class="detail-card status-card">
        <view class="section-kicker">FARLAND STATUS</view>
        <view class="section-title">运营状态</view>
        <view class="body-text">{{request.ops_status_text}}</view>
        <view wx:if="{{request.status !== 'cancelled' && !request.is_assigned_status}}" class="status-helper">报价阶段仅展示 Farland 发布的用车方案。</view>
      </view>

      <view wx:if="{{request.is_assigned_status}}" class="detail-card">
        <view class="section-kicker">ASSIGNED DRIVER</view>
        <view class="section-title">已确认司机</view>
        <view class="body-text">司机：{{request.assigned_transport.driver_name || '待确认'}}</view>
        <view class="body-text">车辆：{{request.assigned_transport.vehicle_model || request.assigned_transport.vehicle_type || '待确认'}}</view>
        <view class="body-text">电话：{{request.assigned_transport.driver_phone || '待确认'}}</view>
        <view wx:if="{{request.assigned_transport.plate_number}}" class="body-text">车牌：{{request.assigned_transport.plate_number}}</view>
      </view>

      <view wx:if="{{request.status !== 'cancelled' && !request.is_assigned_status}}" class="detail-card">
        <view class="section-kicker">QUOTE OPTIONS</view>
        <view class="section-title">优选用车方案</view>
        <view wx:if="{{hasPublishedQuotes}}" class="body-text">Farland 已为您筛选以下优选用车方案。价格包含司机报价、Farland 服务费 10% 与预计总价。</view>
        <view wx:else class="body-text">Farland 正在为您确认用车方案。方案发布后会在这里显示。</view>
        <view wx:if="{{selectedQuoteId}}" class="pending-confirm-card">
          <view>已选择方案，等待 Farland 最终确认。</view>
          <button class="pending-refresh-btn" loading="{{refreshingDetail}}" bindtap="refreshStatus">刷新状态</button>
        </view>
        <view wx:if="{{customerNotice}}" class="driver-unavailable-card">
          {{customerNotice}}
        </view>

        <view wx:if="{{hasPublishedQuotes}}" class="quote-list">
          <view wx:for="{{quotes}}" wx:key="quote_id" class="quote-card {{selectedQuoteId === item.quote_id ? 'selected' : ''}}">
            <view class="quote-head">
              <view>
                <view class="quote-title">{{item.public_title}}</view>
                <view class="quote-sub">{{item.suitable_for}}</view>
              </view>
              <view wx:if="{{item.is_recommended}}" class="recommend-badge">推荐</view>
            </view>

            <view class="quote-profile">{{item.driver_profile_teaser}}</view>
            <view class="quote-meta">{{item.vehicle_class}} · {{item.capacity_text}}</view>

            <view class="price-grid">
              <view>
                <view class="price-label">司机报价</view>
                <view class="price-value">{{item.currency}} {{item.driver_quote_amount}}</view>
              </view>
              <view>
                <view class="price-label">Farland 服务费 {{item.feeRateText}}</view>
                <view class="price-value">{{item.currency}} {{item.farland_service_fee_amount}}</view>
              </view>
              <view>
                <view class="price-label">预计总价</view>
                <view class="price-total">{{item.currency}} {{item.client_visible_total}}</view>
              </view>
            </view>

            <view class="quote-detail">包含：{{item.includesText}}</view>
            <view class="quote-detail muted">不含：{{item.excludesText}}</view>
            <view wx:if="{{accessSource === 'temporary_invite' && !selectedQuoteId}}" class="quote-action-helper">
              选择后，Farland 顾问将为您确认后续用车安排。如需之后继续查看，可保存到我的 Farland 行程。
            </view>

            <view class="quote-footer">
              <view class="quote-expiry">{{item.valid_until_text}}</view>
              <view wx:if="{{selectedQuoteId === item.quote_id}}" class="quote-readonly selected">已选择</view>
              <button
                wx:else
                class="quote-select-btn"
                loading="{{choosingQuoteId === item.quote_id}}"
                disabled="{{!!selectedQuoteId || choosingQuoteId === item.quote_id}}"
                data-quote-id="{{item.quote_id}}"
                bindtap="chooseQuote"
              >{{selectedQuoteId ? '已选其他方案' : '选择方案'}}</button>
            </view>
          </view>
        </view>
      </view>

      <view class="detail-card">
        <view class="section-kicker">ACTIVITY</view>
        <view class="section-title">处理进度</view>
        <view class="activity-list">
          <view wx:for="{{activityEvents}}" wx:key="time" class="activity-row">
            <view class="activity-time">{{item.time}}</view>
            <view class="activity-dot"></view>
            <view class="activity-message">{{item.message}}</view>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>
