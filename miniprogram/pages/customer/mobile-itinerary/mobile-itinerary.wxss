@import "/styles/theme.wxss";

.mi-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-page);
}

.mi-preview-banner {
  padding: 16rpx 24rpx;
  background: var(--bg-internal);
  color: var(--ink-600);
  font-size: 22rpx;
  text-align: center;
}

.mi-scroll {
  flex: 1;
  min-height: 0;
}

.mi-sheet {
  display: block;
  width: 100%;
}

.mi-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}

.mi-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.mi-btn.primary {
  background: linear-gradient(180deg, #727EB5 0%, #5F6BA6 100%);
  color: #FFFFFF;
}

.mi-btn.ghost {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(102, 114, 168, 0.4);
  color: var(--brand-600);
}

.mi-btn::after { border: 0; }

.mi-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 48rpx;
  text-align: center;
}

.mi-state-title {
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.mi-state-text {
  font-size: 25rpx;
  color: var(--ink-600);
  line-height: 1.6;
}

.mi-state .mi-btn {
  flex: none;
  margin-top: 16rpx;
  min-width: 240rpx;
  padding: 0 40rpx;
}
