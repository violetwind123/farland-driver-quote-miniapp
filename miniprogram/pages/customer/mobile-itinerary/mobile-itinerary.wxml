<view class="mobile-itinerary-page">
  <view wx:if="{{loading}}" class="state-card">
    <image class="state-logo" src="/assets/images/logo-farland-splash.png" mode="aspectFit" />
    <view class="state-title">正在加载手机行程单</view>
    <view class="state-copy">Farland 正在为您打开最新版本。</view>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <view class="state-icon error">!</view>
    <view class="state-title">行程单暂不可用</view>
    <view class="state-copy">{{error}}</view>
    <button class="state-btn" bindtap="refreshItinerary">重新加载</button>
    <button class="state-btn secondary" bindtap="contactAdvisor">联系顾问</button>
  </view>

  <view wx:elif="{{waiting}}" class="state-card">
    <view class="state-icon pending">···</view>
    <view class="state-title">行程单生成中</view>
    <view class="state-copy">{{waitingMessage}}</view>
    <button class="state-btn" bindtap="refreshItinerary">刷新</button>
    <button class="state-btn secondary" bindtap="contactAdvisor">联系顾问</button>
  </view>

  <block wx:else>
    <view class="sheet-hero">
      <view class="hero-kicker">FARLAND 手机行程单</view>
      <view class="hero-title">{{title}}</view>
      <view wx:if="{{meta}}" class="hero-meta">{{meta}}</view>
      <view wx:if="{{cityText}}" class="hero-city">{{cityText}}</view>
    </view>

    <view wx:if="{{sheetUrl}}" class="sheet-card">
      <image
        class="sheet-image"
        src="{{sheetUrl}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
        bindtap="previewSheet"
      />
      <view class="sheet-hint">点击放大查看，长按可保存或转发。</view>
    </view>

    <view wx:else class="sheet-missing-card">
      <view class="state-icon pending">···</view>
      <view class="state-title">手机行程单生成中</view>
      <view class="state-copy">Farland 顾问确认后，这里会显示可保存、可转发的长图版行程单。</view>
      <button class="state-btn" bindtap="refreshItinerary">刷新</button>
    </view>

    <view class="action-grid">
      <button class="action-btn primary" bindtap="previewSheet">放大/保存行程单</button>
      <button class="action-btn" bindtap="contactAdvisor">行程调整联系顾问</button>
      <button class="action-btn hotel" bindtap="goHotelRequest">酒店预订</button>
    </view>

    <view class="advisor-note" bindtap="contactAdvisor">
      <view class="advisor-note-title">行程内容需要修改？</view>
      <view class="advisor-note-copy">请联系 Farland 顾问确认，酒店预订功能仍按原流程使用。</view>
    </view>
  </block>

  <view wx:if="{{showAdvisorQr}}" class="advisor-qr-mask" catchtap="closeAdvisorQr">
    <view class="advisor-qr-modal" catchtap="noop">
      <view class="advisor-qr-title">添加 Farland 顾问微信</view>
      <view class="advisor-qr-copy">长按识别二维码，或点击二维码放大查看。</view>
      <image
        class="advisor-qr-image"
        src="{{advisorQrPath}}"
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
        bindtap="previewAdvisorQr"
      />
      <button class="advisor-qr-close" bindtap="closeAdvisorQr">关闭</button>
    </view>
  </view>
</view>
