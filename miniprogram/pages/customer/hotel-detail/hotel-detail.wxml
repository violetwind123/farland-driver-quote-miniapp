<view class="hotel-detail-page">
  <view wx:if="{{loading}}" class="empty-card">
    <view class="empty-title">正在加载酒店信息</view>
    <view class="empty-copy">请稍候，Farland 正在读取酒店确认信息。</view>
  </view>

  <view wx:elif="{{error}}" class="empty-card error-card">
    <view class="empty-title">酒店分享卡无法打开</view>
    <view class="empty-copy">{{error}}</view>
  </view>

  <view wx:elif="{{!hotel}}" class="empty-card">
    <view class="empty-title">暂无酒店信息</view>
    <view class="empty-copy">Farland 顾问同步后会在这里显示完整酒店安排。</view>
  </view>

  <block wx:else>
    <view class="hotel-hero">
      <image class="hero-img" src="/assets/images/hotel-lobby-01.jpg" mode="aspectFill" />
      <view class="hero-scrim"></view>
      <view wx:if="{{hotel.statusText}}" class="status-chip confirmed hero-chip">{{hotel.statusText}}</view>
      <view class="hero-copy">
        <view class="hero-kicker">TONIGHT · 今晚住宿</view>
        <view class="hero-name display-serif">{{hotel.name}}</view>
        <view wx:if="{{hotel.metaText}}" class="hero-meta">{{hotel.metaText}}</view>
      </view>
    </view>

    <view class="stay-table card-surface">
      <view wx:for="{{hotel.stayRows}}" wx:key="label" wx:for-item="row" class="stay-row {{row.muted ? 'muted' : ''}}">
        <view class="stay-label">{{row.label}}</view>
        <view class="stay-value {{row.gold ? 'confirmation-no' : ''}}">{{row.value}}</view>
        <view wx:if="{{row.copyable}}" class="stay-copy {{row.gold ? 'gold' : ''}}" catchtap="copyRowValue" data-value="{{row.value}}">复制</view>
      </view>
    </view>

    <view class="note-card card-surface">{{hotel.note}}</view>
  </block>

  <view class="action-bar">
    <view class="cta-ghost" bindtap="backHome">返回我的行程</view>
    <view class="cta-primary" bindtap="contactAdvisor">联系顾问</view>
  </view>

  <view wx:if="{{showAdvisorQr}}" class="advisor-qr-mask" catchtap="closeAdvisorQr">
    <view class="advisor-qr-modal" catchtap="noop">
      <view class="advisor-qr-title">添加 Farland 顾问微信</view>
      <view class="advisor-qr-copy">长按识别二维码，或点击二维码放大查看。</view>
      <image
        class="advisor-qr-image"
        src="{{advisorQrPath}}"
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
        bindtap="previewAdvisorQr"
      />
      <button class="advisor-qr-close" bindtap="closeAdvisorQr">关闭</button>
    </view>
  </view>
</view>
