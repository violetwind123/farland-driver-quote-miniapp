<view class="hotel-detail-page">
  <view wx:if="{{loading}}" class="empty-card">
    <view class="empty-title">正在加载酒店信息</view>
    <view class="empty-copy">请稍候，Farland 正在读取酒店确认信息。</view>
  </view>

  <view wx:elif="{{error}}" class="empty-card error-card">
    <view class="empty-title">酒店分享卡无法打开</view>
    <view class="empty-copy">{{error}}</view>
  </view>

  <view wx:elif="{{!hotel}}" class="empty-card">
    <view class="empty-title">暂无酒店信息</view>
    <view class="empty-copy">Farland 顾问同步后会在这里显示完整酒店安排。</view>
  </view>

  <block wx:else>
    <view class="hotel-hero card-surface">
      <view class="hotel-kicker">酒店信息</view>
      <view class="hotel-title">{{hotel.name}}</view>
      <view wx:if="{{hotel.metaText}}" class="hotel-meta">{{hotel.metaText}}</view>
      <view class="hotel-status">{{hotel.statusText}}</view>
    </view>

    <view class="detail-card card-surface">
      <view class="info-detail-grid">
        <view wx:for="{{hotel.detailItems}}" wx:key="label" wx:for-item="detail" class="info-detail-item {{detail.fullRow ? 'full-row' : ''}} {{detail.muted ? 'muted' : ''}}">
          <view class="detail-label">{{detail.label}}</view>
          <view class="detail-value compact">{{detail.value}}</view>
        </view>
      </view>

      <button wx:if="{{hotel.hasConfirmationNo}}" class="copy-confirm-btn" bindtap="copyConfirmationNo">复制确认号</button>

      <view wx:if="{{hotel.plainDetailItems && hotel.plainDetailItems.length}}" class="plain-detail-list">
        <view wx:for="{{hotel.plainDetailItems}}" wx:key="label" wx:for-item="detail" class="plain-detail-row">
          <view class="plain-detail-label">{{detail.label}}</view>
          <view class="plain-detail-value">{{detail.value}}</view>
        </view>
      </view>
    </view>

    <view class="note-card card-surface">{{hotel.note}}</view>
  </block>

  <view class="bottom-actions">
    <button class="bottom-btn" bindtap="backHome">返回我的行程</button>
  </view>
</view>
