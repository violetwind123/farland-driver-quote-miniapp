<view class="hotel-detail-page">
  <view wx:if="{{!hotel}}" class="empty-card">
    <view class="empty-title">暂无酒店信息</view>
    <view class="empty-copy">Farland 顾问同步后会在这里显示完整酒店安排。</view>
  </view>

  <block wx:else>
    <view class="hotel-hero card-surface">
      <view class="hotel-kicker">酒店信息</view>
      <view class="hotel-title">{{hotel.name}}</view>
      <view wx:if="{{hotel.metaText}}" class="hotel-meta">{{hotel.metaText}}</view>
      <view class="hotel-status">{{hotel.statusText}}</view>
    </view>

    <view class="detail-card card-surface">
      <view class="detail-row">
        <view class="detail-label">入住日期</view>
        <view class="detail-value">{{hotel.checkInDate}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">退房日期</view>
        <view class="detail-value">{{hotel.checkOutDate}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">预计抵达</view>
        <view class="detail-value">{{hotel.arrivalTime}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">城市</view>
        <view class="detail-value">{{hotel.city}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">地址</view>
        <view class="detail-value">{{hotel.address}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">房型</view>
        <view class="detail-value">{{hotel.roomSummary}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">确认号</view>
        <view class="detail-value">{{hotel.confirmationNo}}</view>
      </view>
    </view>

    <view class="note-card card-surface">{{hotel.note}}</view>
  </block>

  <view class="bottom-actions">
    <button class="bottom-btn" bindtap="backHome">返回我的行程</button>
  </view>
</view>
