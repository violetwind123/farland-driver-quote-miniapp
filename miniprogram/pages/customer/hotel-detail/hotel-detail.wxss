@import "/styles/theme.wxss";

.hotel-detail-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 170rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F7F8FC 0%, #FFFFFF 100%);
}

.hotel-hero,
.detail-card,
.note-card,
.empty-card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.055);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 12rpx 34rpx rgba(17, 24, 39, 0.06);
}

.hotel-kicker {
  color: #5B6596;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 700;
}

.hotel-title {
  margin-top: 10rpx;
  color: #1D2433;
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 760;
}

.hotel-meta {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.hotel-status {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(91, 101, 150, 0.10);
  color: #5B6596;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 650;
}

.detail-card,
.note-card {
  margin-top: 20rpx;
}

.detail-row {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(31, 36, 51, 0.055);
}

.detail-row:first-child {
  border-top: none;
  padding-top: 0;
}

.detail-row:last-child {
  padding-bottom: 0;
}

.detail-label {
  color: #8A91A1;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-value {
  color: #1D2433;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 600;
}

.note-card,
.empty-copy {
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
}

.empty-title {
  color: #1D2433;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 740;
}

.empty-copy {
  margin-top: 10rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(31, 36, 51, 0.06);
  box-sizing: border-box;
}

.bottom-btn {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #5B6596;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 650;
}

.bottom-btn::after {
  border: none;
}
