@import "/styles/theme.wxss";

.hotel-detail-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 170rpx;
  box-sizing: border-box;
  background: var(--bg-page);
}

.empty-card {
  padding: 30rpx;
  border-radius: 32rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

/* ---------- 图片 hero(1e 入住确认单) ---------- */
.hotel-hero {
  position: relative;
  height: 432rpx;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
  margin: -28rpx -24rpx 0;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(27, 35, 64, 0) 42%, rgba(27, 35, 64, 0.55) 100%);
}

.hero-chip {
  position: absolute;
  right: 44rpx;
  top: 36rpx;
}

.hero-copy {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 36rpx;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 600;
}

.hero-name {
  color: #FFFFFF;
  font-size: 44rpx;
  margin-top: 8rpx;
}

.hero-meta {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

/* ---------- 单列信息表 ---------- */
.stay-table {
  margin-top: 28rpx;
  padding: 0 36rpx;
}

.stay-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.stay-row:last-child {
  border-bottom: 0;
}

.stay-label {
  width: 120rpx;
  flex-shrink: 0;
  color: var(--ink-400);
  font-size: 21rpx;
  font-weight: 600;
}

.stay-value {
  flex: 1;
  color: var(--ink-900);
  font-size: 26rpx;
  font-weight: 600;
  word-break: break-word;
}

.stay-row.muted .stay-value,
.stay-row.muted .stay-label {
  color: var(--ink-300);
}

.stay-copy {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  font-size: 19rpx;
  color: var(--ink-600);
  flex-shrink: 0;
}

.stay-copy.gold {
  background: var(--gold-50);
  border-color: transparent;
  color: var(--gold-700);
  font-weight: 600;
}

/* ---------- 象牙提示卡 ---------- */
.note-card {
  margin-top: 20rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: var(--bg-ivory);
  border: 1rpx solid var(--brand-line);
  color: var(--gold-700);
  font-size: 22rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

/* ---------- 空 / 错误态 ---------- */
.empty-title {
  color: var(--ink-900);
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
}

.empty-copy {
  margin-top: 10rpx;
  color: var(--ink-600);
  font-size: 25rpx;
  line-height: 1.55;
}

.error-card .empty-title,
.error-card .empty-copy {
  color: var(--danger);
}

/* ---------- 顾问二维码弹窗(复用全站约定) ---------- */
.advisor-qr-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
  background: rgba(18, 24, 38, 0.46);
}

.advisor-qr-modal {
  width: 100%;
  padding: 34rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: var(--bg-card);
  box-shadow: var(--shadow-float);
}

.advisor-qr-title {
  color: var(--ink-900);
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  text-align: center;
}

.advisor-qr-copy {
  margin-top: 10rpx;
  color: var(--ink-600);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.advisor-qr-image {
  display: block;
  width: 430rpx;
  height: 430rpx;
  margin: 30rpx auto 0;
  border-radius: 24rpx;
  background: var(--bg-card);
}

.advisor-qr-close {
  margin: 28rpx 0 0;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: var(--brand-600);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 650;
}

.advisor-qr-close::after {
  border: none;
}

/* 底部动作栏两键等分:theme .cta-* 无 flex,默认会缩成内容宽度胶囊 */
.action-bar .cta-ghost,
.action-bar .cta-primary {
  flex: 1;
}
