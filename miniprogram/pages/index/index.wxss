.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 56rpx;
  background:
    radial-gradient(circle at 50% 28%, rgba(102, 114, 168, 0.16), transparent 34%),
    linear-gradient(180deg, #F7F8FC 0%, #EEF1F8 100%);
}

.splash-card {
  width: 100%;
  text-align: center;
  transform: translateY(-88rpx);
}

.splash-logo {
  width: 460rpx;
  height: 170rpx;
  opacity: 0.92;
  filter: drop-shadow(0 16rpx 28rpx rgba(73, 82, 126, 0.20));
}

.loading-line {
  width: 180rpx;
  height: 6rpx;
  margin: 46rpx auto 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(102, 114, 168, 0.14);
}

.loading-bar {
  width: 72rpx;
  height: 100%;
  border-radius: 999rpx;
  background: #6672A8;
  animation: loadingSlide 1.4s ease-in-out infinite;
}

@keyframes loadingSlide {
  0% { transform: translateX(-76rpx); opacity: 0.35; }
  50% { opacity: 1; }
  100% { transform: translateX(184rpx); opacity: 0.35; }
}
