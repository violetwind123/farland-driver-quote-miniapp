.card-surface {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(102, 114, 168, 0.08);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 60rpx rgba(17, 24, 39, 0.08);
  box-sizing: border-box;
}

.section-kicker {
  color: #7E889A;
  font-size: 22rpx;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
}

.section-title {
  color: #182235;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 600;
}

.body-text {
  color: #5C6576;
  font-size: 24rpx;
  line-height: 1.6;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 20rpx;
  background: rgba(102, 114, 168, 0.08);
  border-radius: 999rpx;
  color: #6672A8;
  font-size: 22rpx;
  line-height: 1;
}

.cta-primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  background: #6672A8;
  color: #FFFFFF;
}

.empty-state {
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #7E889A;
  font-size: 24rpx;
  line-height: 1.6;
}
