.school-visit-card {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 92rpx);
  margin: 0 10rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 36, 51, 0.06);
  box-shadow:
    0 1rpx 2rpx rgba(255, 255, 255, 0.90) inset,
    0 18rpx 44rpx rgba(17, 24, 39, 0.09);
  overflow-y: auto;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.card-index {
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 700;
}

.card-type-pill {
  flex: 0 0 auto;
  min-width: 78rpx;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(91, 101, 150, 0.10);
  color: #4F598B;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.school-title-block {
  margin-top: 30rpx;
}

.school-name-en {
  color: #1D2433;
  font-size: 42rpx;
  line-height: 1.12;
  font-weight: 800;
  word-break: break-word;
}

.school-name-zh {
  margin-top: 10rpx;
  color: #667085;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.school-meta-row,
.ranking-row,
.fit-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.school-meta-row {
  margin-top: 22rpx;
}

.ranking-row {
  margin-top: 12rpx;
}

.meta-pill,
.ranking-pill,
.fit-tag {
  min-height: 42rpx;
  line-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(91, 101, 150, 0.08);
  color: #4F598B;
  font-size: 21rpx;
  font-weight: 650;
}

.ranking-pill {
  background: #F7F8FC;
  color: #2F394C;
}

.info-section {
  margin-top: 24rpx;
}

.info-label {
  color: #8A91A1;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 750;
}

.address-text {
  margin-top: 8rpx;
  color: #1D2433;
  font-size: 26rpx;
  line-height: 1.42;
  font-weight: 650;
}

.intro-list,
.strength-list {
  margin-top: 10rpx;
  display: grid;
  gap: 10rpx;
}

.intro-line {
  color: #4B5565;
  font-size: 24rpx;
  line-height: 1.48;
  font-weight: 500;
}

.strength-item {
  position: relative;
  padding-left: 20rpx;
}

.strength-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #5B6596;
}

.strength-title {
  color: #1D2433;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 720;
}

.strength-desc {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.38;
  font-weight: 500;
}

.fit-section {
  margin-top: 20rpx;
}

.fit-tags {
  margin-top: 10rpx;
}

.time-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: auto;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: #F7F8FC;
}

.time-item {
  flex: 1 1 0;
  min-width: 0;
  text-align: center;
}

.time-label {
  color: #8A91A1;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
}

.time-value {
  margin-top: 6rpx;
  color: #1D2433;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 780;
}

.time-warning {
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(245, 158, 11, 0.12);
  color: #B54708;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 700;
}
