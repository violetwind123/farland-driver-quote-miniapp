page {
  background: #F5F6FA;
  color: #1E2635;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

button::after {
  border: 0;
}

button.primary-btn,
button.submit-btn,
button.select-btn,
button.floating-add,
.primary-btn,
.submit-btn,
.select-btn,
.floating-add,
.service-type.active {
  background: #6672A8 !important;
  color: #ffffff !important;
}

.status,
.selected-label,
.error-text {
  color: #6672A8 !important;
}
