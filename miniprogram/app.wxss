@import "/styles/farland-ui.wxss";

page {
  background: #F4F5F9;
  color: #1C1B29;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

button::after {
  border: 0;
}

button.primary-btn,
button.submit-btn,
button.select-btn,
button.floating-add,
.primary-btn,
.submit-btn,
.select-btn,
.floating-add,
.service-type.active {
  background: linear-gradient(135deg, #6874B4 0%, #8993CC 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 8rpx 22rpx rgba(104, 116, 180, 0.30), inset 0 1rpx 0 rgba(255,255,255,0.25);
}

.status,
.selected-label,
.error-text {
  color: #4A56A5 !important;
}
