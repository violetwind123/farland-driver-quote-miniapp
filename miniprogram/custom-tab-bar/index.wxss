.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-top: 1rpx solid #EEEDF4;
  box-shadow:
    0 -1rpx 2rpx rgba(255, 255, 255, 0.92) inset,
    0 -10rpx 28rpx rgba(17, 24, 39, 0.035);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
}

.tabbar-content {
  height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tabbar-item {
  flex: 1;
  height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8B8A9C;
}

.tabbar-item-inner {
  min-width: 138rpx;
  height: 76rpx;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
}

.tabbar-item.active .tabbar-item-inner {
  background: transparent;
  border: none;
  box-shadow: none;
}

.tabbar-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.62;
}

.tabbar-label {
  margin-top: 5rpx;
  color: #8B8A9C;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 500;
}

.tabbar-item.active .tabbar-icon {
  opacity: 1;
}

.tabbar-item.active .tabbar-label {
  color: #6874B4;
  font-weight: 700;
}
