{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farland.example/schemas/customer-trip.schema.json",
  "title": "Farland Customer Trip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trip_id",
    "trip_type",
    "title",
    "city",
    "date_start",
    "date_end",
    "customer",
    "advisor",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "customer-trip-v1"
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_type": {
      "type": "string",
      "enum": ["transfer", "charter", "hotel", "mixed"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "date_start": {
      "type": "string",
      "format": "date"
    },
    "date_end": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "completed", "cancelled"]
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "preferred_language": {
          "type": "string",
          "enum": ["zh-CN", "en-US"]
        }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string"
        },
        "wechat": {
          "type": "string"
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name"],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["student", "parent", "family", "advisor_guest"]
          }
        }
      }
    },
    "hotel_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotel_request"
      }
    },
    "transport_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transport_request"
      }
    },
    "charter_services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/charter_service"
      }
    },
    "daily_itinerary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/day_itinerary"
      }
    },
    "benefits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/benefit"
      }
    }
  },
  "$defs": {
    "hotel_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "check_in_date", "check_out_date", "status"],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "hotel_name": {
          "type": "string"
        },
        "room_type": {
          "type": "string"
        },
        "check_in_date": {
          "type": "string",
          "format": "date"
        },
        "check_out_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": ["requested", "processing", "confirmed", "cancelled"]
        },
        "customer_visible_note": {
          "type": "string"
        }
      }
    },
    "transport_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "service_type", "pickup", "dropoff", "pickup_time_text", "status"],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "service_type": {
          "type": "string",
          "enum": ["transfer", "charter"]
        },
        "pickup": {
          "type": "string",
          "minLength": 1
        },
        "dropoff": {
          "type": "string",
          "minLength": 1
        },
        "pickup_time_text": {
          "type": "string",
          "minLength": 1
        },
        "passengers": {
          "type": "integer",
          "minimum": 1
        },
        "luggage": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "sourcing", "quoted", "selected", "confirmed", "assigned", "cancelled"]
        },
        "status_text": {
          "type": "string"
        },
        "customer_visible_note": {
          "type": "string"
        }
      }
    },
    "charter_service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["charter_id", "title", "date_range_text", "service_area", "status", "segments"],
      "properties": {
        "charter_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date_range_text": {
          "type": "string",
          "minLength": 1
        },
        "vehicle_class": {
          "type": "string"
        },
        "service_area": {
          "type": "string",
          "minLength": 1
        },
        "continuity_text": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["requested", "processing", "confirmed", "cancelled"]
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/charter_segment"
          }
        }
      }
    },
    "charter_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "title", "route"],
      "properties": {
        "time": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "customer_visible_note": {
          "type": "string"
        }
      }
    },
    "day_itinerary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "city", "title", "items"],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/itinerary_item"
          }
        }
      }
    },
    "itinerary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "type", "title"],
      "properties": {
        "time": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["hotel", "departure", "transfer", "campus", "meal", "activity", "arrival"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "linked_entity_type": {
          "type": "string",
          "enum": ["hotel_request", "transport_request", "charter_service", "none"]
        },
        "linked_entity_id": {
          "type": "string"
        },
        "client_status": {
          "type": "string"
        }
      }
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
