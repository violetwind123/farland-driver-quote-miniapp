{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farland.example/schema/customer-trip.schema.json",
  "title": "Farland Customer Trip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_trip_id",
    "trip_type",
    "title",
    "status",
    "city",
    "country",
    "timezone",
    "start_at",
    "end_at",
    "customer",
    "source",
    "advisor"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "external_trip_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_no": {
      "type": "string"
    },
    "trip_type": {
      "type": "string",
      "enum": ["transfer", "charter", "mixed", "hotel_only"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "completed", "cancelled", "archived"]
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "customer": {
      "$ref": "#/$defs/customer"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "transfer": {
      "$ref": "#/$defs/transfer"
    },
    "charter": {
      "$ref": "#/$defs/charter"
    },
    "hotels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotel"
      }
    },
    "flights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flight"
      }
    },
    "transfers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transfer"
      }
    },
    "charter_services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/charter"
      }
    },
    "itinerary_days": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itinerary_day"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "advisor": {
      "$ref": "#/$defs/advisor"
    },
    "warning_codes": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning_code" }
    },
    "critical_warning_codes": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning_code" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "trip_type": { "const": "transfer" } }
      },
      "then": {
        "required": ["transfer"]
      }
    },
    {
      "if": {
        "properties": { "trip_type": { "const": "charter" } }
      },
      "then": {
        "required": ["charter"]
      }
    }
  ],
  "$defs": {
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string" },
        "wechat_id": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["ride_request", "import_json", "manual", "manual_json", "pdf_import"]
        },
        "source_id": { "type": "string" },
        "request_id": { "type": "string" },
        "source_filename": { "type": "string" }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pickup", "dropoff", "pickup_time_text"],
      "properties": {
        "pickup": { "type": "string", "minLength": 1 },
        "dropoff": { "type": "string", "minLength": 1 },
        "pickup_time_text": { "type": "string", "minLength": 1 },
        "passenger_count": { "type": "integer", "minimum": 1 },
        "luggage_count": { "type": "integer", "minimum": 0 },
        "vehicle_preference": { "type": "string" },
        "customer_visible_note": { "type": "string" }
      }
    },
    "charter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "vehicle_class", "service_area", "segments"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "vehicle_class": { "type": "string", "minLength": 1 },
        "service_area": { "type": "string", "minLength": 1 },
        "backup_note": { "type": "string" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/charter_segment" }
        }
      }
    },
    "charter_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "title", "route"],
      "properties": {
        "time": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "customer_visible_note": { "type": "string" }
      }
    },
    "hotel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "check_in_date", "check_out_date", "status"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "hotel_name": { "type": "string" },
        "room_type": { "type": "string" },
        "check_in_date": { "type": "string", "format": "date" },
        "check_out_date": { "type": "string", "format": "date" },
        "status": {
          "type": "string",
          "enum": ["requested", "processing", "confirmed", "cancelled"]
        },
        "customer_visible_note": { "type": "string" }
      }
    },
    "day_hotel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hotel_name": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "planned_arrival_time": { "type": "string" },
        "arrival_time": { "type": "string" },
        "address": { "type": "string" },
        "customer_note": { "type": "string" }
      }
    },
    "flight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flight_no": { "type": "string" },
        "flight_number": { "type": "string" },
        "airline": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "departure_time": { "type": "string" },
        "arrival_time": { "type": "string" },
        "route": { "type": "string" },
        "customer_note": { "type": "string" }
      }
    },
    "transport_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_type": {
          "type": "string",
          "enum": ["transfer", "charter", "none"]
        },
        "departure_time": { "type": "string" },
        "vehicle_summary": { "type": "string" },
        "party_summary": { "type": "string" },
        "status_text": { "type": "string" },
        "driver_visibility": {
          "type": "string",
          "enum": ["pending", "assigned", "released"]
        }
      }
    },
    "itinerary_day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "title"],
      "anyOf": [
        { "required": ["items"] },
        { "required": ["timeline_items"] }
      ],
      "properties": {
        "day_no": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "weekday": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "city": { "type": "string" },
        "summary": { "type": "string" },
        "displayed_start_time_raw": { "type": "string" },
        "estimated_departure_time_raw": { "type": "string" },
        "displayed_start_time": { "type": "string" },
        "estimated_departure_time": { "type": "string" },
        "warning_codes": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning_code" }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/itinerary_item" }
        },
        "timeline_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/itinerary_item" }
        },
        "hotel": {
          "$ref": "#/$defs/day_hotel"
        },
        "transport_summary": {
          "$ref": "#/$defs/transport_summary"
        }
      }
    },
    "itinerary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "item_id": { "type": "string" },
        "time": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "hotel",
            "departure",
            "arrival",
            "transfer",
            "charter",
            "campus",
            "school_visit",
            "sightseeing",
            "flight",
            "meal",
            "meeting",
            "free_time",
            "activity",
            "other"
          ]
        },
        "item_type": {
          "type": "string",
          "enum": [
            "hotel",
            "departure",
            "arrival",
            "transfer",
            "charter",
            "campus",
            "school_visit",
            "sightseeing",
            "flight",
            "meal",
            "meeting",
            "free_time",
            "activity",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "planned_arrival_time": { "type": "string" },
        "planned_start_time": { "type": "string" },
        "planned_end_time": { "type": "string" },
        "drive_time_text": { "type": "string" },
        "distance_text": { "type": "string" },
        "traffic_text": { "type": "string" },
        "location_name": { "type": "string" },
        "address": { "type": "string" },
        "customer_note": { "type": "string" },
        "operator_note": { "type": "string" },
        "linked_entity_type": {
          "type": "string",
          "enum": ["hotel", "transfer", "charter", "document", "none"]
        },
        "linked_entity_id": { "type": "string" },
        "client_status": { "type": "string" }
      }
    },
    "warning_code": {
      "type": "string",
      "enum": [
        "departure_time_mismatch",
        "arrival_after_start_time",
        "missing_drive_time",
        "missing_distance",
        "missing_hotel",
        "missing_date",
        "flight_segment_detected",
        "manual_review_required"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "document_type", "visible_to_customer"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "document_type": {
          "type": "string",
          "enum": ["itinerary", "voucher", "hotel_confirmation", "other"]
        },
        "url": { "type": "string" },
        "visible_to_customer": { "type": "boolean" }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string" },
        "wechat_id": { "type": "string" }
      }
    }
  }
}
