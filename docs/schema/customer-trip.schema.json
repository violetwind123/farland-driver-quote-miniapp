{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farland.example/schema/customer-trip.schema.json",
  "title": "Farland Customer Trip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_trip_id",
    "trip_type",
    "title",
    "status",
    "city",
    "country",
    "timezone",
    "start_at",
    "end_at",
    "customer",
    "source",
    "advisor"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "external_trip_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_type": {
      "type": "string",
      "enum": ["transfer", "charter", "mixed", "hotel_only"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "completed", "cancelled", "archived"]
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "customer": {
      "$ref": "#/$defs/customer"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "transfer": {
      "$ref": "#/$defs/transfer"
    },
    "charter": {
      "$ref": "#/$defs/charter"
    },
    "hotels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotel"
      }
    },
    "itinerary_days": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itinerary_day"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "advisor": {
      "$ref": "#/$defs/advisor"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "trip_type": { "const": "transfer" } }
      },
      "then": {
        "required": ["transfer"]
      }
    },
    {
      "if": {
        "properties": { "trip_type": { "const": "charter" } }
      },
      "then": {
        "required": ["charter"]
      }
    }
  ],
  "$defs": {
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string" },
        "wechat_id": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["ride_request", "import_json", "manual"]
        },
        "source_id": { "type": "string" },
        "request_id": { "type": "string" }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pickup", "dropoff", "pickup_time_text"],
      "properties": {
        "pickup": { "type": "string", "minLength": 1 },
        "dropoff": { "type": "string", "minLength": 1 },
        "pickup_time_text": { "type": "string", "minLength": 1 },
        "passenger_count": { "type": "integer", "minimum": 1 },
        "luggage_count": { "type": "integer", "minimum": 0 },
        "vehicle_preference": { "type": "string" },
        "customer_visible_note": { "type": "string" }
      }
    },
    "charter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "vehicle_class", "service_area", "segments"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "vehicle_class": { "type": "string", "minLength": 1 },
        "service_area": { "type": "string", "minLength": 1 },
        "backup_note": { "type": "string" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/charter_segment" }
        }
      }
    },
    "charter_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "title", "route"],
      "properties": {
        "time": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "customer_visible_note": { "type": "string" }
      }
    },
    "hotel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "check_in_date", "check_out_date", "status"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "hotel_name": { "type": "string" },
        "room_type": { "type": "string" },
        "check_in_date": { "type": "string", "format": "date" },
        "check_out_date": { "type": "string", "format": "date" },
        "status": {
          "type": "string",
          "enum": ["requested", "processing", "confirmed", "cancelled"]
        },
        "customer_visible_note": { "type": "string" }
      }
    },
    "itinerary_day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "title", "items"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/itinerary_item" }
        }
      }
    },
    "itinerary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "type", "title"],
      "properties": {
        "time": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["hotel", "departure", "transfer", "charter", "campus", "meal", "activity", "arrival"]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "linked_entity_type": {
          "type": "string",
          "enum": ["hotel", "transfer", "charter", "document", "none"]
        },
        "linked_entity_id": { "type": "string" },
        "client_status": { "type": "string" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "document_type", "visible_to_customer"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "document_type": {
          "type": "string",
          "enum": ["itinerary", "voucher", "hotel_confirmation", "other"]
        },
        "url": { "type": "string" },
        "visible_to_customer": { "type": "boolean" }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string" },
        "wechat_id": { "type": "string" }
      }
    }
  }
}
