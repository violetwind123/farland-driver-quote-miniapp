.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0b72ff 0%, #f5f7fb 32%);
  padding: 80rpx 32rpx 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  color: white;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.card {
  background: white;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
}

.quote-card {
  border: 2rpx solid #4d97ff;
}

.card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
  color: #111827;
}

.price-row {
  height: 96rpx;
  border: 2rpx solid #0b72ff;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
}

.price-input {
  flex: 1;
  font-size: 34rpx;
}

.currency {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.note {
  width: 100%;
  height: 180rpx;
  background: #f5f7fb;
  border-radius: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef0f4;
  font-size: 28rpx;
  color: #374151;
}

.row text:last-child {
  text-align: right;
  color: #111827;
  max-width: 420rpx;
}

.submit-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 22rpx;
  background: #0b72ff;
  color: white;
  font-size: 34rpx;
  font-weight: 700;
}