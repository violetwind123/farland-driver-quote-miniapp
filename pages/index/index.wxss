.page {
  min-height: 100vh;
  background: #f3f5f9;
  padding: 36rpx 28rpx 140rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 26rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.order-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 22rpx rgba(17, 24, 39, 0.06);
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-id {
  font-size: 24rpx;
  color: #6b7280;
}

.order-type {
  font-size: 24rpx;
  color: #0b72ff;
  background: #eaf2ff;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.route {
  display: block;
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef0f4;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #4b5563;
}

.meta-row.last-row {
  border-bottom: none;
  padding-bottom: 0;
}

.status {
  color: #0b72ff;
  font-weight: 600;
}

.fab {
  position: fixed;
  right: 34rpx;
  bottom: 42rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #0b72ff;
  color: #ffffff;
  font-size: 58rpx;
  line-height: 108rpx;
  font-weight: 500;
  box-shadow: 0 14rpx 32rpx rgba(11, 114, 255, 0.45);
}
