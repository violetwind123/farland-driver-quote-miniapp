<view class="page">
  <view class="header">
    <text class="title">运营单子中心</text>
    <text class="subtitle">{{operatorName}}，查看当前单子与报价情况</text>
  </view>

  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="order-card">
        <view class="order-top">
          <text class="order-id">{{item.id}}</text>
          <text class="order-type">{{item.type}}</text>
        </view>

        <text class="route">{{item.route}}</text>

        <view class="meta-row">
          <text>用车时间</text>
          <text>{{item.serviceTime}}</text>
        </view>

        <view class="meta-row">
          <text>报价状态</text>
          <text class="status">{{item.statusText}}</text>
        </view>

        <view class="meta-row">
          <text>已收报价</text>
          <text>{{item.quoteCount}} 份</text>
        </view>

        <view class="meta-row last-row">
          <text>最新报价</text>
          <text>{{item.latestQuote}}</text>
        </view>
      </view>
    </block>
  </view>

  <button class="fab" bindtap="onCreateOrderTap">＋</button>
</view>
